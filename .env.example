# Microsoft Graph / Entra ID
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=replace-me
GRAPH_MAILBOX=cybersecurity@crhomeusa.com
GRAPH_FOLDER=inbox
GRAPH_LOOKBACK_HOURS=24

# Swappable vulnerability lookup provider.
# Current options: qualys, crowdstrike
LOOKUP_PROVIDER=qualys

# Qualys provider settings
QUALYS_BASE_URL=https://qualysapi.qg3.apps.qualys.com
QUALYS_USERNAME=replace-me
QUALYS_PASSWORD=replace-me
QUALYS_KB_CACHE=./qualys_kb_cache.json
# How long the CVE->QID cache stays trustworthy, in hours (default 168 = 7 days).
# Past this the agent refreshes it. This matters: an expired mapping silently
# turns every newer CVE into UNKNOWN, which reads like "not affected".
QUALYS_KB_MAX_AGE_HOURS=168

# ── Enrichment (fleet lanes) ────────────────────────────────────────────────
# NVD API key. FREE, takes about a minute:
#   https://nvd.nist.gov/developers/request-an-api-key
# Without one, NVD throttles you to 5 requests / 30 seconds, so enriching 20
# CVEs takes ~2 minutes and 50 CVEs takes ~5. With a key it is 50 / 30s.
# Strongly recommended before this runs on a schedule.
NVD_API_KEY=

# User-Agent sent to NVD, EPSS, CISA and the advisory feeds. Some feeds ask for
# a contact address; supply one only if you are comfortable publishing it.
FLEET_USER_AGENT=cti-fleet/1.0

# ── Fleet mail (only needed for the send stage) ─────────────────────────────
# Digest recipients, comma-separated. No default: the fleet will not guess who
# receives security findings.
DIGEST_TO=

# Recipient allowlist. Anything not on it needs an explicit --approve.
# Defaults to DIGEST_TO plus FLEET_OPERATOR_EMAIL, so leaving it blank fails
# closed rather than open.
FLEET_ALLOW_TO=

# Where the orchestrator emails you when it needs a decision. Escalations here
# are pre-approved - it must be able to ask without asking permission to ask.
FLEET_OPERATOR_EMAIL=

# Mailbox you reply INTO. The orchestrator matches replies by their
# [FLEET <id>] subject tag. Defaults to GRAPH_MAILBOX, which is usually right.
CTI_REPLY_MAILBOX=

# Where fleet state lives. dev-run overrides this to ./.fleet-local
FLEET_HOME=

# Output
REPORT_PATH=./cti-vuln-report.md

# Hostname disclosure in the report: full (default) | redact | count
# "full" writes real hostnames next to exploitable CVEs - never commit that
# file. It is the default anyway, because redact's pseudonyms cannot be looked
# up in the scanner, which makes a finding unactionable.
REPORT_HOSTNAMES=full
# Private, stable salt for hostname pseudonyms. Without it the mapping is
# confirmable by anyone holding a list of candidate hostnames.
REPORT_REDACTION_SALT=replace-me-with-a-private-stable-value
