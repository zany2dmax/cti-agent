# secrets / local config
.env
config.local.yaml

# build outputs
# The compiled binary shares its name with the repo, so it is easy to commit
# by accident with `git add -A`. Anchored so it cannot match the directory.
/cti-qualys-agent
# Anchored to the repo root - an unanchored "bin/" also matches nested
# directories like fleet-kit/fleet/bin/, which silently excluded the fleet's
# executables (run-digest, fleet-db, fleet-board) from being tracked.
/bin/
/dist/
*.out
*.log

# OS/editor
.DS_Store
.idea/
.vscode/

# run outputs
*.json

# Generated CTI reports - these map exploitable CVEs to real hostnames and
# must never be committed. internal/report redacts by default, but the safe
# state is for these files to be untrackable regardless of that setting.
cti-vuln-report.md
cti-qualys-report.md
*-vuln-report.md
*-cti-report.md
reports/
digest-*.html
enriched-*.json

# Real scrub patterns name internal hosts/domains - keep them local.
# Commit scripts/scrub-patterns.txt.example instead.
scripts/scrub-patterns.txt

# Local dev-run state: reports, digests, caches, sqlite. Generated, and
# contains real findings - never commit it.
.fleet-local/
