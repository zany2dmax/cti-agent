#!/usr/bin/env bash
# cti-agent-usage - answers "what can I run, and what does it take?" from the
# command manifest, for the cti-agent wrapper and the shell completions.
#
#   cti-agent-usage list                 every command, one line each
#   cti-agent-usage show COMMAND         one command's usage: flags, subcommands
#   cti-agent-usage words                command names, one per line (completion)
#   cti-agent-usage words COMMAND N      what can come next as word N (completion)
#   cti-agent-usage describe             "name:about" lines (zsh completion)
#   cti-agent-usage describe COMMAND N   "flag:what it does" lines (zsh completion)
#
# Read-only, takes no secrets, runs as whoever asks: the manifest is world
# readable and holds names and one-line descriptions only. It runs at every
# TAB, so it is awk over one small file and nothing else.
#
# Exit status: 0 answered, 2 unknown command or usage.
set -eu

MANIFEST="${CTI_AGENT_MANIFEST:-$(dirname "$0")/../commands.manifest}"
[ -r "$MANIFEST" ] || { echo "cti-agent-usage: no command manifest at $MANIFEST" >&2; exit 2; }

known() {
  awk -v c="$1" '$1=="command:" && $2==c {found=1} END{exit !found}' "$MANIFEST"
}

# One awk program for every question; MODE picks the output.
run_awk() {
  # $1 mode, $2 command (may be empty), $3 word index
  awk -v mode="$1" -v want="$2" -v n="${3:-0}" '
    function esc(s) { gsub(/:/, "\\:", s); return s }
    function val(line, key) { sub("^" key ": *", "", line); return line }
    /^command:/ { cmd = val($0, "command"); order[++nc] = cmd; next }
    /^about:/   { about[cmd] = val($0, "about"); next }
    /^runs:/    { runs[cmd] = val($0, "runs"); next }
    /^modes:/   { modes[cmd] = val($0, "modes"); next }
    /^exempt:/  { exempt[cmd] = val($0, "exempt"); next }
    /^flag:/    { v = val($0, "flag"); split(v, p, " \\| ");
                  split(p[1], w, " "); fl[cmd, ++nf[cmd]] = w[1];
                  fspec[cmd, nf[cmd]] = p[1]; fdesc[cmd, nf[cmd]] = p[2]; next }
    /^sub:/     { v = val($0, "sub"); split(v, p, " \\| ");
                  sb[cmd, ++ns[cmd]] = p[1]; sdesc[cmd, ns[cmd]] = p[2]; next }
    END {
      if (mode == "list") {
        wid = 0; for (i = 1; i <= nc; i++) if (length(order[i]) > wid) wid = length(order[i])
        for (i = 1; i <= nc; i++) {
          c = order[i]
          printf "  %-" wid "s  %-6s  %s\n", c, runs[c], about[c]
        }
      } else if (mode == "show") {
        c = want
        printf "%s: %s\n", c, about[c]
        printf "  runs: %s", runs[c]
        if (runs[c] == "effect") printf "  (sends mail, moves mail, files tickets or changes another system)"
        if (runs[c] == "local")  printf "  (writes only its own output and state files)"
        if (runs[c] == "read")   printf "  (changes nothing)"
        printf "\n\nusage: cti-agent %s", c
        if (ns[c]) printf " <command>"
        if (modes[c] != "") { m = modes[c]; gsub(/ /, "|", m); printf " %s", m }
        if (nf[c]) printf " [flags]"
        printf "\n"
        if (modes[c] != "") {
          m2 = modes[c]; gsub(/ /, ", ", m2)
          printf "\nSay how to run it: one of %s is required", m2
          if (index(modes[c], "--to-dev")) printf " (--to-dev may go with --dry-run)"
          if (exempt[c] != "") printf " (except %s, which only reads)", exempt[c]
          printf ".\nWith none it prints usage and exits 2.\n"
        }
        if (ns[c]) { printf "\ncommands:\n"; for (i = 1; i <= ns[c]; i++) printf "  %-14s %s\n", sb[c, i], sdesc[c, i] }
        if (nf[c]) { printf "\nflags:\n"; for (i = 1; i <= nf[c]; i++) printf "  %-26s %s\n", fspec[c, i], fdesc[c, i] }
      } else if (mode == "words") {
        if (want == "") { for (i = 1; i <= nc; i++) print order[i] }
        else {
          if (n <= 2) for (i = 1; i <= ns[want]; i++) print sb[want, i]
          for (i = 1; i <= nf[want]; i++) print fl[want, i]
        }
      } else if (mode == "describe") {
        if (want == "") { for (i = 1; i <= nc; i++) print esc(order[i]) ":" about[order[i]] }
        else {
          if (n <= 3) for (i = 1; i <= ns[want]; i++) print esc(sb[want, i]) ":" sdesc[want, i]
          for (i = 1; i <= nf[want]; i++) print esc(fl[want, i]) ":" fdesc[want, i]
        }
      }
    }' "$MANIFEST"
}

mode="${1:-list}"
case "$mode" in
  list)
    echo "cti-agent commands (runs: read changes nothing, local writes only its own files, effect sends/moves/changes something):"
    run_awk list "" ;;
  show)
    [ -n "${2:-}" ] && known "$2" || { echo "cti-agent: '${2:-}' is not a fleet command; run cti-agent with no arguments for the list" >&2; exit 2; }
    run_awk show "$2" ;;
  words|describe)
    if [ -n "${2:-}" ] && ! known "$2"; then exit 0; fi   # completion never errors
    run_awk "$mode" "${2:-}" "${3:-0}" ;;
  *) echo "usage: cti-agent-usage list | show COMMAND | words [COMMAND N] | describe [COMMAND N]" >&2; exit 2 ;;
esac
