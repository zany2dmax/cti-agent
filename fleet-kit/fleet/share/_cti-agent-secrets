#compdef cti-agent-secrets
# zsh completion for cti-agent-secrets. Installed by install-fedora.sh into
# site-functions, with @CODE_DIR@ and @CONF_DIR@ filled in. Works under sudo.
# A test (test_lanes.py, SbinTools) fails when these subcommands and flags
# differ from the tool's own.
_cti-agent-secrets() {
  local -a subs names
  subs=(
    'status:each secret and login - stored as a credential, still in fleet.env'
    'import:encrypt every secret fleet.env has and the store lacks'
    'set:encrypt one, typed (not echoed) or piped - also how a secret is rotated'
    'remove:delete a stored credential; programs fall back to fleet.env'
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'cti-agent-secrets command' subs
    return
  fi
  case "${words[2]}" in
    import) _arguments '--dry-run[say what would be stored; store nothing]' ;;
    set)
      names=(${(f)"$(awk '/^key: /{k=$2} /^(secret|credential): yes/{print k}' @CODE_DIR@/settings.manifest 2>/dev/null | sort -u)"})
      (( CURRENT == 3 )) && compadd -- $names ;;
    remove)
      names=(${(f)"$(grep -v '^#' @CONF_DIR@/credentials.stored 2>/dev/null)"})
      (( CURRENT == 3 )) && compadd -- $names ;;
  esac
}
_cti-agent-secrets "$@"
