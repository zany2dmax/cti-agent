#compdef cti-agent-update
# zsh completion for cti-agent-update. Installed by install-fedora.sh into
# site-functions beside _cti-agent. Works under sudo too.
#
# The updater is not a fleet command (the cti-agent wrapper does not run it), so
# it is not in the command manifest. Its two flags are listed here instead, and
# a test (test_update.py) fails when they differ from update-fedora.sh.
#
# Exactly one is required, coloured like cti-agent's own completion: green
# changes nothing, red changes the install. Once one is given, nothing more.
_cti-agent-update() {
  (( ${words[(I)(--dry-run|--for-real)]} )) && return 0
  local -a d
  d=("--dry-run   -- fetch and show what is incoming, change nothing")
  compadd -V required/safe -X "%B%F{green}REQUIRED, one of - SAFE: changes nothing%f%b" \
    -d d -- --dry-run
  d=("--for-real  -- pull the kit, then run the installer from it")
  compadd -V required/changes -X "%B%F{red}REQUIRED, one of - CHANGES THE INSTALL%f%b" \
    -d d -- --for-real
}
_cti-agent-update "$@"
