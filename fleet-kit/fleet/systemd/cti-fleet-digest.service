[Unit]
Description=CTI daily digest (deterministic backstop for the 06:00 send)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ctifleet
Group=ctifleet
WorkingDirectory=/home/ctifleet/fleet
EnvironmentFile=/home/ctifleet/fleet/fleet.env
ExecStart=/home/ctifleet/fleet/bin/run-digest daily
TimeoutStartSec=3600

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ctifleet/fleet

StandardOutput=append:/home/ctifleet/fleet/logs/digest.log
StandardError=append:/home/ctifleet/fleet/logs/digest.log
