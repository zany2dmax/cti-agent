[Unit]
Description=Alert the operator that %i failed
# NO OnFailure here, deliberately. If the alert fails it must not trigger
# another alert - that loops every 30 minutes.

[Service]
Type=oneshot
User=ctiagent
Group=ctiagent
Environment=HOME=/home/ctiagent/fleet
Environment=FLEET_HOME=/home/ctiagent/fleet
Environment=FLEET_CODE=/home/ctiagent/fleet
Environment=FLEET_ENV=/home/ctiagent/fleet/fleet.env
EnvironmentFile=/home/ctiagent/fleet/fleet.env
ExecStart=/home/ctiagent/fleet/bin/cti-alert --unit %i
TimeoutStartSec=120

# cti-alert quotes the last 40 journal lines, which is the most useful part
# of the email. Reading them needs membership of systemd-journal: without
# it journalctl exits 1 and every alert arrives saying 'journal
# unavailable', which looks like a second failure on top of the first.
SupplementaryGroups=systemd-journal

NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cti-agent-alert
