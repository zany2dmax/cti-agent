[Unit]
Description=CTI scout sweep - poll advisory feeds for new CVEs
After=network-online.target

[Service]
Type=oneshot
User=ctiagent
Group=ctiagent
WorkingDirectory=/home/ctiagent/fleet
EnvironmentFile=/home/ctiagent/fleet/fleet.env
ExecStart=/usr/bin/python3 /home/ctiagent/fleet/lanes/scout.py --out /home/ctiagent/fleet/state/scout-latest.json --days 3
TimeoutStartSec=900
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ctiagent/fleet
StandardOutput=append:/home/ctiagent/fleet/logs/scout.log
StandardError=append:/home/ctiagent/fleet/logs/scout.log
