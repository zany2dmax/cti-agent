[Unit]
Description=Fire the CTI orchestrator heartbeat every 2 hours

[Timer]
OnBootSec=3min
OnUnitActiveSec=2h
AccuracySec=1min
# Spread the beat off the hour so it does not collide with the digest or
# scout timers, which both fire on exact clock boundaries.
RandomizedDelaySec=300
# Deliberately NOT Persistent: after downtime systemd would fire every missed
# beat at once. cti-budget's window ceiling would refuse most of them, which
# works but emails a hold for each. One beat 5min after boot is enough to
# catch up, and OnBootSec= above already provides it.
Persistent=false
Unit=cti-agent-checkin.service

[Install]
WantedBy=timers.target
