[Unit]
Description=CTI fleet orchestrator heartbeat (one /checkin beat)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ctifleet
Group=ctifleet
WorkingDirectory=/home/ctifleet/fleet
EnvironmentFile=/home/ctifleet/fleet/fleet.env
# run-checkin resolves the claude binary at runtime - there is no single path
# where Claude Code installs, so hardcoding one here breaks silently every 30
# minutes. It also skips a beat if the previous one is still running.
#
# --permission-mode acceptEdits keeps the beat unattended. The autonomy gate
# lives in CLAUDE.md and in mailer.py's recipient allowlist, not here.
ExecStart=/home/ctifleet/fleet/bin/run-checkin
TimeoutStartSec=1800
Nice=10

# Least privilege - the fleet only ever needs to write under its own home.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ctifleet/fleet
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=append:/home/ctifleet/fleet/logs/checkin.log
StandardError=append:/home/ctifleet/fleet/logs/checkin.log
