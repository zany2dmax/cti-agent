[Unit]
Description=CTI fleet orchestrator heartbeat (one /checkin beat)
# If this fails, tell the operator. Without this a failed digest is
# silent, and no email looks exactly like a quiet day.
OnFailure=cti-agent-alert@%n.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ctiagent
Group=ctiagent

# 0077, so a lane that writes with a bare open() cannot land a world- or
# group-readable file. The Python lanes (brief.py, enrich.py) do exactly that:
# no chmod, no umask in the code, so under systemd's default 0022 the digest
# HTML and enriched-*.json - which carries host names - were 0644. The Go
# commands set 0600 explicitly and are unaffected; this closes the rest.
UMask=0077
WorkingDirectory=/home/ctiagent/fleet
EnvironmentFile=/home/ctiagent/fleet/fleet.env
# run-checkin resolves the claude binary at runtime - there is no single path
# where Claude Code installs, so hardcoding one here breaks silently every 30
# minutes. It also skips a beat if the previous one is still running.
#
# --permission-mode acceptEdits keeps the beat unattended. The autonomy gate
# lives in CLAUDE.md and in mailer.py's recipient allowlist, not here.
ExecStart=/home/ctiagent/fleet/bin/run-checkin
TimeoutStartSec=1800
Nice=10

# Least privilege - the fleet only ever needs to write under its own home.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ctiagent/fleet
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=append:/home/ctiagent/fleet/logs/checkin.log
StandardError=append:/home/ctiagent/fleet/logs/checkin.log
