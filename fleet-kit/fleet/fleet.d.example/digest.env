# digest.env - the digest settings, as a split box keeps them in /etc/cti-agent/fleet.d/digest.env.
# Generated by scripts/lanes from fleet.env.example and settings.manifest: edit those.
# Lines starting with # are optional; set the others. Secrets are not here:
# store each with `sudo cti-agent-secrets set NAME` (cti-agent-onboard does it for you).

# Advisory triage in the daily digest: 0 (off, the default) or 1 (on). On, ingest saves
# every threat-intel message, whoever sent it: one holding a CVE, an ATT&CK
# ID, a defanged indicator or link, a public IP or a file hash. Supplier
# requests, W9 and ACH threads and replies hold none and never reach a
# model; Qualys's own scan results never do either (unless a Qualys address
# is on TRIAGE_SENDERS by name). run-digest runs cti-triage --batch on them before the brief: the reader
# lists each message's items, items with a CVE are left to the CVE report,
# and the rest go through Falcon and the judge, under FLEET ADVISORIES. Two model calls per advisory; a dry run makes them too. Needs
# TRIAGE_MODEL and the FALCON_* settings. Any failure costs the section, never
# the digest. Try `run-digest daily --dry-run` with it on first.
#TRIAGE_ENABLED=0

# At most this many advisories are judged per digest (default 10, at most 50);
# the rest are listed as over the cap.
#TRIAGE_MAX_PER_RUN=10

# Senders whose mail is triaged even with none of those in it (a feed whose
# write-ups are prose), when Exchange authenticated them. "name@example.com"
# or "@example.com", comma-separated. Unset = MAILBOX_FEED_SENDERS; "none" =
# nobody, so only content decides.
#TRIAGE_SENDERS=@intel.example.com,advisories@vendor.example

#
# Advisory triage (cti-triage). The reader is a model
# started with NO tools that reads one advisory and names its products,
# versions and techniques; it never sees our data. An alias (haiku, sonnet,
# opus) or a full claude-... id; sonnet is the plan's default. Each call's
# tokens and cost are printed. Needs the same API key or OAuth token as the
# supplier lane, and CLAUDE_BIN if claude is not on the path.
#TRIAGE_MODEL=sonnet

# What Falcon cannot see, in your own words, repeated on every fact sheet so
# "not installed" never reads as "not affected". Free text, one line.
#TRIAGE_BLIND_SPOTS=sites without the Falcon sensor; servers outside Falcon

# Override the reader's instructions file (default: agents/triage-reader/CLAUDE.md).
#TRIAGE_READER_INSTRUCTIONS=

# The judge (cti-triage --judge): a second no-tools model that sees the fact
# sheet, never the advisory, and says per subject whether it is worth a look.
# Empty = TRIAGE_MODEL.
#TRIAGE_JUDGE_MODEL=

# Override the judge's instructions file (default: agents/triage-judge/CLAUDE.md).
#TRIAGE_JUDGE_INSTRUCTIONS=
