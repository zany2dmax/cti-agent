[Unit]
Description=Weekly application-security report, Friday 07:30 local

[Timer]
# Friday: the weekly WAS scans finish by Thursday, so the report covers the
# week's scans; and after Tuesday's domains run, whose website list feeds the
# NOT SCANNED check.
OnCalendar=Fri *-*-* 07:30:00
AccuracySec=1min
Persistent=true
Unit=cti-agent-appscan.service

[Install]
WantedBy=timers.target
