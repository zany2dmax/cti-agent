[Unit]
Description=CTI orchestrator heartbeat (one /checkin beat)
Documentation=file:///opt/cti-agent/README.md
# If this fails, tell the operator. Without this a failed digest is
# silent, and no email looks exactly like a quiet day.
OnFailure=cti-agent-alert@%n.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ctiagent
Group=ctiagent

# 0077, so a lane that writes with a bare open() cannot land a world- or
# group-readable file. The Python lanes (brief.py, scout.py) do exactly that:
# no chmod, no umask in the code, so under systemd's default 0022 the digest
# HTML and enriched-*.json - which carries host names - were 0644. The Go
# commands set 0600 explicitly and are unaffected; this closes the rest.
# The orchestrator is allowed to run journalctl, and without this it
# would be allowed to run a command that returns nothing: reading the
# SYSTEM journal needs group membership, not just execute permission.
# cti-agent-alert@.service already had this; the heartbeat did not, so
# journalctl stayed "blocked" even after the tool allowlist landed.
SupplementaryGroups=systemd-journal
UMask=0077

# FHS layout. Nothing lives under /home, which is what lets ProtectHome=yes
# hide it entirely - the original units used ProtectHome=read-only plus a
# ReadWritePaths punch-through into /home, which is order-dependent in systemd
# and the exact pattern SELinux is most likely to deny on Fedora.
#
#   /opt/cti-agent     code      root-owned, read-only to this service
#   /etc/cti-agent     config    root:ctiagent 0750, secrets 0640
#   /var/lib/cti-agent state     systemd creates and chowns this
StateDirectory=cti-agent
StateDirectoryMode=0750
WorkingDirectory=/var/lib/cti-agent
# EnvironmentFile FIRST, then Environment=. systemd applies these in
# written order and the last assignment wins, so with the file last a
# stale FLEET_HOME in fleet.env silently replaced the layout this unit
# specifies. The unit owns the layout; fleet.env owns the settings.
# BEGIN settings - generated by scripts/settings-manifest, do not edit
# fleet.env first while it exists (before the split), then core and this
# lane's own file. A missing file is skipped.
EnvironmentFile=-/etc/cti-agent/fleet.env
EnvironmentFile=-/etc/cti-agent/fleet.d/00-core.env
EnvironmentFile=-/etc/cti-agent/fleet.d/appowners.env
EnvironmentFile=-/etc/cti-agent/fleet.d/appscan.env
EnvironmentFile=-/etc/cti-agent/fleet.d/checkin.env
EnvironmentFile=-/etc/cti-agent/fleet.d/digest.env
EnvironmentFile=-/etc/cti-agent/fleet.d/domains.env
EnvironmentFile=-/etc/cti-agent/fleet.d/mailbox.env
EnvironmentFile=-/etc/cti-agent/fleet.d/supplier.env
EnvironmentFile=-/etc/cti-agent/fleet.d/vmscan.env
Environment="FLEET_ENV_FILES=/etc/cti-agent/fleet.d/00-core.env /etc/cti-agent/fleet.d/appowners.env /etc/cti-agent/fleet.d/appscan.env /etc/cti-agent/fleet.d/checkin.env /etc/cti-agent/fleet.d/digest.env /etc/cti-agent/fleet.d/domains.env /etc/cti-agent/fleet.d/mailbox.env /etc/cti-agent/fleet.d/supplier.env /etc/cti-agent/fleet.d/vmscan.env"
# END settings
Environment=HOME=/var/lib/cti-agent
Environment=FLEET_HOME=/var/lib/cti-agent
Environment=FLEET_CODE=/opt/cti-agent
Environment=FLEET_ENV=/etc/cti-agent/fleet.env
Environment=FLEET_FEEDS=/etc/cti-agent/feeds.txt

# BEGIN credentials - generated by scripts/settings-manifest, do not edit
# Only these secrets reach this unit, as files under $CREDENTIALS_DIRECTORY.
# One missing from /etc/credstore.encrypted is skipped, not an error.
ImportCredential=ANTHROPIC_API_KEY
ImportCredential=ANTHROPIC_AUTH_TOKEN
ImportCredential=CLAUDE_CODE_OAUTH_TOKEN
ImportCredential=CLIENT_ID
ImportCredential=CLIENT_SECRET
ImportCredential=FALCON_BASE_URL
ImportCredential=FALCON_CLIENT_ID
ImportCredential=FALCON_CLIENT_SECRET
ImportCredential=GODADDY_PAT
ImportCredential=JIRA_API_TOKEN
ImportCredential=JIRA_BASE_URL
ImportCredential=JIRA_CLOUD_ID
ImportCredential=JIRA_EMAIL
ImportCredential=NVD_API_KEY
ImportCredential=POD_API_TOKEN
ImportCredential=POD_CLUSTER_ID
ImportCredential=QUALYS_BASE_URL
ImportCredential=QUALYS_PASSWORD
ImportCredential=QUALYS_USERNAME
ImportCredential=REPORT_REDACTION_SALT
ImportCredential=TENANT_ID
# END credentials
ExecStart=/opt/cti-agent/bin/run-checkin --for-real
TimeoutStartSec=1800
Nice=15

# Least privilege. ProtectHome=yes is stronger than the read-only variant and
# safe here only because no fleet path is under /home.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=

# journald, not hand-rolled log files: Fedora ships journald and it handles
# rotation, size caps and retention already.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cti-agent-checkin
