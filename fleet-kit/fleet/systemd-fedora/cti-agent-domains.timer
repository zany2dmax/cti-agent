[Unit]
Description=Weekly domains check, Tuesday 08:00 local

[Timer]
# Tuesday, so the weekly lanes do not all land on Monday - and before the
# Friday AppSec report, which reads the website list this run writes.
OnCalendar=Tue *-*-* 08:00:00
AccuracySec=1min
Persistent=true
Unit=cti-agent-domains.service

[Install]
WantedBy=timers.target
