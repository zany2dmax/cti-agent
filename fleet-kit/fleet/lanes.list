# The fleet's lanes - generated by scripts/lanes from fleet-kit/lanes/*.toml, do not edit.
# Installed as /opt/cti-agent/share/lanes.list. FLEET_LANES names lanes from here.
# lane<TAB>units<TAB>credential checks the beat runs for it (- for none)
checkin	checkin	-
digest	digest,weekly	-
scout	scout	-
patchtuesday	patchtuesday	-
appscan	appscan	cti-appreport
appowners	appowners	-
domains	domains	cti-domains
vmscan	vmscan	cti-vmscan
supplier	supplier	-
mailbox	mailbox	-
