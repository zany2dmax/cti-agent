# ~/fleet/fleet.env   chmod 600 - this file holds a client secret.
# Superset of the Go agent's .env so one file drives the whole fleet.

# ── Entra / Microsoft Graph ────────────────────────────────────────────────
# Same app registration the Go agent uses to READ the mailbox.
# Add Mail.Send (Application) and grant admin consent so the fleet can send.
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=replace-me
GRAPH_MAILBOX=security@example.com
GRAPH_FOLDER=inbox
GRAPH_LOOKBACK_HOURS=24

# ── Vulnerability lookup provider ─────────────────────────────────────────
# qualys | crowdstrike | none
LOOKUP_PROVIDER=qualys
# Your Qualys pod's API URL - qg1/qg2/qg3/qg4 etc. differ per subscription.
# Check Help > About in the Qualys UI if you are not sure which pod you are on.
QUALYS_BASE_URL=https://qualysapi.qg1.apps.qualys.com
QUALYS_USERNAME=replace-me
QUALYS_PASSWORD=replace-me
QUALYS_KB_CACHE=/home/ctifleet/fleet/state/qualys_kb_cache.json

# ── Fleet layout ──────────────────────────────────────────────────────────
FLEET_HOME=/home/ctifleet/fleet
CTI_AGENT_DIR=/home/ctifleet/cti-qualys-agent
REPORT_PATH=/home/ctifleet/fleet/reports/raw-latest.md

# ── Outbound mail ─────────────────────────────────────────────────────────
DIGEST_TO=security@example.com
# Hard allowlist. mailer.py refuses any recipient not on this list unless the
# orchestrator passes --approve after the operator okays that specific send.
FLEET_ALLOW_TO=security@example.com

# ── Enrichment ────────────────────────────────────────────────────────────
# Free from https://nvd.nist.gov/developers/request-an-api-key
# Without it NVD throttles to 5 requests / 30s, so a 50-CVE day takes ~5 min.
NVD_API_KEY=

# ── Operator identity ─────────────────────────────────────────────────────
# Who the orchestrator reports to and escalates to. Used in phone messages
# and board lines; the @operator handle refers to this person.
FLEET_OPERATOR=Firstname Lastname

# Sent as the User-Agent to NVD, EPSS, CISA and advisory feeds. Some feeds ask
# for a contact address; supply one only if you are comfortable publishing it.
FLEET_USER_AGENT=cti-fleet/1.0

# ── Phone channel (orchestrator only) ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
