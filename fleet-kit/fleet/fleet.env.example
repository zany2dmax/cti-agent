# ~/fleet/fleet.env   chmod 600 - this file holds a client secret.
# Superset of the Go agent's .env so one file drives the whole fleet.

# ── Entra / Microsoft Graph ────────────────────────────────────────────────
# Same app registration the Go agent uses to READ the mailbox.
# Add Mail.Send (Application) and grant admin consent so the fleet can send.
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=replace-me
GRAPH_MAILBOX=security@example.com
GRAPH_FOLDER=inbox
GRAPH_LOOKBACK_HOURS=24

# ── Vulnerability lookup provider ─────────────────────────────────────────
# qualys | crowdstrike | none
LOOKUP_PROVIDER=qualys
# Your Qualys pod's API URL - qg1/qg2/qg3/qg4 etc. differ per subscription.
# Check Help > About in the Qualys UI if you are not sure which pod you are on.
QUALYS_BASE_URL=https://qualysapi.qg1.apps.qualys.com
QUALYS_USERNAME=replace-me
QUALYS_PASSWORD=replace-me
QUALYS_KB_CACHE=/home/ctifleet/fleet/state/qualys_kb_cache.json
# Hours before the CVE->QID cache is refreshed (default 168 = 7 days). An
# expired mapping silently reports newer CVEs as UNKNOWN, which reads as clean.
QUALYS_KB_MAX_AGE_HOURS=168

# ── Fleet layout ──────────────────────────────────────────────────────────
FLEET_HOME=/home/ctifleet/fleet
CTI_AGENT_DIR=/home/ctifleet/cti-qualys-agent
REPORT_PATH=/home/ctifleet/fleet/reports/raw-latest.md

# Hostname disclosure in the report: full (default) | redact | count
# The report pairs exploitable CVEs with the machines that have them, which is
# a targeting list if it leaks - never commit it or attach it outside
# controlled locations. "full" is still the default because "redact" produces
# pseudonyms that cannot be looked up in the scanner, which makes a P1
# unactionable. Use redact/count only for copies leaving the DL.
REPORT_HOSTNAMES=full
# Private, stable salt for hostname pseudonyms. Without it the mapping is
# confirmable by anyone holding a list of candidate hostnames.
REPORT_REDACTION_SALT=replace-me-with-a-private-stable-value

# ── Outbound mail ─────────────────────────────────────────────────────────
DIGEST_TO=security@example.com
# Hard allowlist. mailer.py refuses any recipient not on this list unless the
# orchestrator passes --approve after the operator okays that specific send.
FLEET_ALLOW_TO=security@example.com

# ── Enrichment ────────────────────────────────────────────────────────────
# Free from https://nvd.nist.gov/developers/request-an-api-key
# Without it NVD throttles to 5 requests / 30s, so a 50-CVE day takes ~5 min.
NVD_API_KEY=

# ── Claude Code ───────────────────────────────────────────────────────────
# Absolute path to the claude binary. Leave blank to auto-detect. Set it if you
# have more than one install, or if `which claude` differs between your shell
# and the systemd unit's environment (it usually does).
#   native installer:  /home/ctifleet/.local/bin/claude
#   apt / dnf / apk:   /usr/bin/claude
CLAUDE_BIN=

# ── Operator identity ─────────────────────────────────────────────────────
# Who the orchestrator reports to. Used in escalation emails and board
# lines; the @operator handle refers to this person.
FLEET_OPERATOR=Firstname Lastname

# Sent as the User-Agent to NVD, EPSS, CISA and advisory feeds. Some feeds ask
# for a contact address; supply one only if you are comfortable publishing it.
FLEET_USER_AGENT=cti-fleet/1.0

# ── Escalation channel (orchestrator only) ────────────────────────────────
# Where the orchestrator emails you when it needs a decision it cannot make.
# Escalations here are pre-approved - it must be able to ask without asking.
FLEET_OPERATOR_EMAIL=you@example.com

# Mailbox you reply INTO. The orchestrator reads it each check-in and matches
# replies by the [FLEET <id>] subject tag. Defaults to GRAPH_MAILBOX, which is
# usually right: the agent already has Mail.Read on it.
CTI_REPLY_MAILBOX=
