# fleet.env - every setting the CTI fleet reads, in one file.
#
# WHERE THIS LIVES
#   install-fedora.sh   /etc/cti-agent/fleet.env      0640 root:ctiagent
#   install.sh          $FLEET_HOME/fleet.env         0600 ctiagent
#
# It holds a client secret, Qualys credentials and a Claude token. Never commit
# it, never make it world-readable, and never copy it between machines without
# re-checking the PATHS section - paths are the one group that differs per box,
# and a laptop's paths on a server fail several minutes into a run rather than
# at startup.
#
# CHECK YOUR WORK
#   <fleet> mailer.py --check      lists every required setting and its state
#   <fleet> cti-budget status      quota ceilings, as parsed
# where <fleet> is `sudo cti-agent` on Fedora, or
# `sudo -u ctiagent $FLEET_HOME/bin` on the generic layout.
#
# Syntax: KEY=value, one per line. No `export`, no spaces around `=`. Values
# are read literally - do not quote unless the value contains a space. Lines
# starting with # are ignored. A later duplicate of a key wins.


# ══ 1. MICROSOFT GRAPH - required ════════════════════════════════════════════
# An Entra app registration with APPLICATION permissions Mail.Read and
# Mail.Send, both admin-consented. Delegated permissions will not work: there
# is no signed-in user on a timer at 06:00.
#
# Azure portal -> Entra ID -> App registrations -> your app:
#   TENANT_ID      Overview -> Directory (tenant) ID
#   CLIENT_ID      Overview -> Application (client) ID
#   CLIENT_SECRET  Certificates & secrets -> New client secret (copy it now;
#                  it is shown once). Note the expiry - when it lapses the
#                  fleet stops and the error names authentication, not expiry.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# The shared mailbox the fleet reads CTI email from and sends the digest as.
# No default, deliberately: an unconfigured install must fail rather than read
# some other organisation's mailbox.
GRAPH_MAILBOX=

# Folder within that mailbox. Use the display name as it appears in Outlook.
# If ingest finds 0 CVEs but the mailbox clearly has mail, this is the first
# thing to check - rules may be filing it into a subfolder.
GRAPH_FOLDER=inbox

# How far back each ingest looks. 24 suits a daily timer. Raise it for the
# first run or after an outage; a value far larger than the cadence means
# re-processing the same mail every day.
GRAPH_LOOKBACK_HOURS=24

# Optional. Where operators should reply when the fleet asks a question.
# Defaults to GRAPH_MAILBOX.
CTI_REPLY_MAILBOX=


# ══ 2. VULNERABILITY SCANNER - required when LOOKUP_PROVIDER=qualys ══════════
# Which scanner answers "is this CVE actually present here?".
#   qualys  the supported provider
#   none    skip the lookup - every CVE reports UNKNOWN. Useful for testing
#           the mail path without scanner credentials.
LOOKUP_PROVIDER=qualys

# Your Qualys POD, not the login page. Check the URL you use for the UI:
#   US POD1 https://qualysapi.qualys.com
#   US POD2 https://qualysapi.qg2.apps.qualys.com
#   US POD3 https://qualysapi.qg3.apps.qualys.com
#   US POD4 https://qualysapi.qg4.apps.qualys.com
#   EU POD1 https://qualysapi.qualys.eu
#   EU POD2 https://qualysapi.qg2.apps.qualys.eu
# The wrong pod authenticates and returns nothing, which reads as "you are not
# affected" - the most dangerous wrong answer this system can give.
QUALYS_BASE_URL=

# A read-only account. It needs KnowledgeBase and Host Detection API access;
# it does not need scan-launch or admin rights.
QUALYS_USERNAME=
QUALYS_PASSWORD=


# ══ 3. PATHS - re-check these on every box ═══════════════════════════════════
# The only group that is machine-specific. Values below are the FEDORA layout
# (install-fedora.sh). For install.sh, everything is under one FLEET_HOME.
#
#                        Fedora                  | generic
#   FLEET_HOME           /var/lib/cti-agent      | /home/ctiagent/fleet
#   CTI_AGENT_DIR        /opt/cti-agent/agent    | /home/ctiagent/cti-agent
#   QUALYS_KB_CACHE      $FLEET_HOME/state/...   | $FLEET_HOME/state/...
#   REPORT_PATH          $FLEET_HOME/reports/... | $FLEET_HOME/reports/...

# State: findings database, board, reports, caches, lock files, the budget
# ledger, and Claude Code's credentials. Must be writable by the service user.
FLEET_HOME=/var/lib/cti-agent

# Where the Go agent's source and compiled binary live. run-digest looks for
# $CTI_AGENT_DIR/cti-agent first and falls back to `go run ./cmd/cti-agent`,
# which recompiles on every digest - so a wrong value here is slow at best and
# "CTI_AGENT_DIR not set or not found" at worst.
CTI_AGENT_DIR=/opt/cti-agent/agent

# The Qualys KnowledgeBase cache: a CVE-to-QID map, ~150k entries and roughly
# 17MB. Building it takes minutes, so it is cached and refreshed
# incrementally. Never commit this file.
QUALYS_KB_CACHE=/var/lib/cti-agent/state/qualys_kb_cache.json

# How long the cache is trusted before refresh. Past this the agent attempts
# an incremental update, then a full rebuild, and if both fail it uses the
# stale cache and marks every UNKNOWN as "coverage UNVERIFIED" rather than
# implying absence.
QUALYS_KB_MAX_AGE_HOURS=168

# Where the Go agent writes its raw markdown report. Written 0600; it can
# contain real hostnames. Gitignored - keep it that way.
REPORT_PATH=/var/lib/cti-agent/reports/raw-latest.md

# Advisory feed list for the scout lane. One URL per line in that file.
FLEET_FEEDS=/etc/cti-agent/feeds.txt

# Set by systemd and the cti-agent wrapper, not usually by hand. Only needed
# if you invoke a lane directly with neither in play.
#   FLEET_CODE  where bin/ and lanes/ are    (/opt/cti-agent)
#   FLEET_ENV   this file's own path         (/etc/cti-agent/fleet.env)
#FLEET_CODE=/opt/cti-agent
#FLEET_ENV=/etc/cti-agent/fleet.env


# ══ 4. RECIPIENTS AND THE SEND GATE - required ═══════════════════════════════
# Who gets the scheduled digest. Comma-separated.
DIGEST_TO=

# Hard allowlist, enforced in code. A send to any address not listed here is
# refused even with --approve. Defaults to DIGEST_TO if unset. This is the
# control that stops a compromised or confused agent mailing your findings
# somewhere else - keep it as tight as the job allows.
FLEET_ALLOW_TO=

# Where escalations and failure alerts go: a person, not the DL. Mail to the
# operator is pre-approved and needs no gate, on the principle that telling
# you something is wrong is not an outward-facing send. cti-alert refuses to
# run without this.
FLEET_OPERATOR_EMAIL=

# The operator's name, used in the orchestrator's prompt and board lines so
# it addresses a person rather than "the operator". Quoted because it contains
# a space: run-digest and run-checkin source this file with `set -a`, and an
# unquoted second word is read as a command, not part of the value.
FLEET_OPERATOR="Firstname Lastname"


# ══ 4b. SCHEDULE TIMEZONE ════════════════════════════════════════════════════
# systemd's OnCalendar= uses the SYSTEM timezone, and servers are usually UTC.
# A digest timed for 06:00 therefore lands at 02:00 for an operator on US
# Eastern - six hours stale by the time anyone reads it, which defeats the
# point of a morning digest.
#
# Set an IANA timezone here and install-fedora.sh writes systemd drop-ins that
# pin the digest and weekly timers to it. DST is handled by systemd; a
# hardcoded UTC offset would drift an hour every winter.
#
# Leave blank to keep the system timezone. Only the two human-facing timers
# are pinned - the heartbeat every 2h and the scout every 4h do not care what
# a clock on a wall says.
#
#   timedatectl list-timezones | grep -i york      # find yours
FLEET_TIMEZONE=

# When the daily digest and the Monday weekly run, in FLEET_TIMEZONE.
FLEET_DIGEST_TIME=06:00:00
FLEET_WEEKLY_TIME=07:00:00


# ══ 5. REPORT CONTENT ════════════════════════════════════════════════════════
# How hostnames appear in digests.
#   full    real hostnames. Actionable, and the reason to pick it: a finding
#           nobody can locate is not a finding. The digest then contains an
#           inventory of vulnerable machines - treat it accordingly.
#   redact  salted SHA-256 pseudonyms, host-xxxxxxxx. Stable across runs,
#           not reversible, and not resolvable by whoever has to patch it.
#   count   host counts only.
REPORT_HOSTNAMES=full

# Salt for redact mode. Any non-empty string, kept private and kept stable:
# changing it changes every pseudonym and breaks continuity with older
# digests, and leaving it empty makes the pseudonyms trivially reversible by
# anyone who can guess a hostname. The report says so in its own header when
# this is unset.
REPORT_REDACTION_SALT=


# ══ 6. ENRICHMENT ════════════════════════════════════════════════════════════
# Free from https://nvd.nist.gov/developers/request-an-api-key
# Without it NVD throttles to 5 requests / 30s, so a 50-CVE day takes ~5
# minutes of the digest window. With it, 50 requests / 30s.
NVD_API_KEY=

# User-Agent the enrich and scout lanes send to NVD, EPSS, CISA and your RSS
# feeds. Some feeds rate-limit or block unrecognised agents; naming yourself
# is also the courteous thing to do when polling someone's server six times
# a day. Include a contact if you want to be reachable.
FLEET_USER_AGENT=cti-agent-fleet/1.0


# ══ 7. CLAUDE CODE - the heartbeat lane only ═════════════════════════════════
# The digest, weekly and scout lanes are stdlib Python and need none of this.
# Only run-checkin calls claude, so an unset token costs you the heartbeat,
# never the morning email.

# Absolute path to the claude binary. Blank auto-detects.
#   native installer  /var/lib/cti-agent/.local/bin/claude
#   dnf / apt / apk   /usr/bin/claude
#   Homebrew          /opt/homebrew/bin/claude
CLAUDE_BIN=

# Authentication. The service account has no browser and, on Fedora, no login
# shell, so it cannot complete the interactive flow. Set EXACTLY ONE of these;
# run-checkin verifies before every beat rather than hanging on a prompt
# nobody can answer.
#
# A. Console API key, from platform.claude.com. Metered per token, billed to
#    the org, revocable on its own without touching anyone's login. Pick this
#    if you have access to a Console account.
ANTHROPIC_API_KEY=
#
# B. Subscription token. Run `claude setup-token` on any machine where you are
#    already logged in - a laptop is fine - and paste the result here. Bills
#    against a subscription seat rather than metered tokens, and is the only
#    workable option on Fedora. It expires in about a year and the heartbeat
#    stops dead when it does, so calendar the renewal.
CLAUDE_CODE_OAUTH_TOKEN=
#
# C. Bearer token for an LLM gateway or proxy that fronts Claude.
ANTHROPIC_AUTH_TOKEN=
#
# D. Authenticate the service account itself, once, interactively. Requires
#    that the account HAS a login shell, which the Fedora layout does not give
#    it. Leave A/B/C blank and run:
#        sudo -u ctiagent HOME=/var/lib/cti-agent claude
#    Credentials land in $HOME/.claude/.credentials.json, inside
#    StateDirectory, so they survive restarts and upgrades.
#
# B, C and D all share a person's seat with an unattended process. A costs
# money instead. There is no option that avoids both.

# Optional. Moves Claude Code's config and credentials elsewhere. Leave blank
# unless you have a reason - the default is under FLEET_HOME already.
CLAUDE_CONFIG_DIR=


# ══ 8. QUOTA CEILINGS - matters most with option B, C or D ═══════════════════
# With a subscription credential the fleet spends YOUR quota. An overrun does
# not cost money, it costs you your own access mid-afternoon, with no warning.
#
# The fleet cannot negotiate for quota: it runs on a different machine from
# your own sessions, nothing reports how much of the window is left, and the
# only signal either side gets is a rate-limit error after the fact. So it
# takes a fixed slice and leaves the rest alone.
#
# Defaults suit the shipped 2-hour cadence: 12 beats/day, 2-3 per 5h window.
# WINDOW_BEATS=4 therefore does not bind in normal operation - it is there to
# absorb catch-up bursts and retry storms. Raise it to give the fleet more of
# your quota; lower DAILY_BEATS to reserve more for yourself.
FLEET_BUDGET_WINDOW_HOURS=5
FLEET_BUDGET_WINDOW_BEATS=4
FLEET_BUDGET_DAILY_BEATS=14

# After a rate limit the fleet backs off, doubling each consecutive time, so a
# throttled heartbeat stops asking instead of digging the hole deeper. Hours;
# fractions are fine.
FLEET_BUDGET_BACKOFF_BASE_HOURS=0.5
FLEET_BUDGET_BACKOFF_MAX_HOURS=6

# Where the ledger lives. Defaults to $FLEET_HOME/budget.json, mode 0600.
FLEET_BUDGET_FILE=
