# fleet.env - every setting the CTI fleet reads, in one file.
#
# WHERE THIS LIVES
#   install-fedora.sh   /etc/cti-agent/fleet.env      0640 root:ctiagent
#
# It holds a client secret, Qualys credentials and a Claude token. Never commit
# it, never make it world-readable, and never copy it between machines without
# re-checking the PATHS section - paths are the one group that differs per box,
# and a laptop's paths on a server fail several minutes into a run rather than
# at startup.
#
# CHECK YOUR WORK
#   <fleet> mailer.py --check      lists every required setting and its state
#   <fleet> cti-budget status      quota ceilings, as parsed
# where <fleet> is `sudo cti-agent`.
#
# Syntax: KEY=value, one per line. No `export`, no spaces around `=`. Values
# are read literally - do not quote unless the value contains a space. Lines
# starting with # are ignored. A later duplicate of a key wins.


# ══ 1. MICROSOFT GRAPH - required ════════════════════════════════════════════
# An Entra app registration with APPLICATION permissions Mail.Read and
# Mail.Send, both admin-consented. Delegated permissions will not work: there
# is no signed-in user on a timer at 06:00.
#
# Azure portal -> Entra ID -> App registrations -> your app:
#   TENANT_ID      Overview -> Directory (tenant) ID
#   CLIENT_ID      Overview -> Application (client) ID
#   CLIENT_SECRET  Certificates & secrets -> New client secret (copy it now;
#                  it is shown once). Note the expiry - when it lapses the
#                  fleet stops and the error names authentication, not expiry.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# The shared mailbox the fleet reads CTI email from and sends the digest as.
# No default, deliberately: an unconfigured install must fail rather than read
# some other organisation's mailbox.
GRAPH_MAILBOX=

# Folder within that mailbox. Use the display name as it appears in Outlook.
# If ingest finds 0 CVEs but the mailbox clearly has mail, this is the first
# thing to check - rules may be filing it into a subfolder.
GRAPH_FOLDER=inbox

# How far back each ingest looks. 24 suits a daily timer. Raise it for the
# first run or after an outage; a value far larger than the cadence means
# re-processing the same mail every day.
GRAPH_LOOKBACK_HOURS=24

# OPTIONAL. Subjects the daily digest reads NO CVEs from: comma-separated,
# case-insensitive substrings. Unset = Qualys's weekly "Latest Vulnerabilities
# Added to the Knowledge Base" (the built-in default: "latest vulnerabilities
# added" and "added to the knowledge base"). That mail lists thousands of CVEs
# that are a catalogue of what Qualys can detect, not news about us, and each
# one costs a live scanner lookup. Set it (even to a different list) and the
# default no longer applies; set it empty to skip nothing. Skipped mail is
# named in the log and left in the mailbox, never moved by the cleanup lane.
#DIGEST_SKIP_SUBJECTS=

# Optional. Where operators should reply when the fleet asks a question.
# Defaults to GRAPH_MAILBOX.
CTI_REPLY_MAILBOX=


# ══ 2. VULNERABILITY SCANNER - required when LOOKUP_PROVIDER=qualys ══════════
# Which scanner answers "is this CVE actually present here?".
#   qualys  the supported provider
#   none    skip the lookup - every CVE reports UNKNOWN. Useful for testing
#           the mail path without scanner credentials.
LOOKUP_PROVIDER=qualys

# Your Qualys POD, not the login page. Check the URL you use for the UI:
#   US POD1 https://qualysapi.qualys.com
#   US POD2 https://qualysapi.qg2.apps.qualys.com
#   US POD3 https://qualysapi.qg3.apps.qualys.com
#   US POD4 https://qualysapi.qg4.apps.qualys.com
#   EU POD1 https://qualysapi.qualys.eu
#   EU POD2 https://qualysapi.qg2.apps.qualys.eu
# The wrong pod authenticates and returns nothing, which reads as "you are not
# affected" - the most dangerous wrong answer this system can give.
QUALYS_BASE_URL=

# A read-only account. It needs KnowledgeBase and Host Detection API access;
# it does not need scan-launch or admin rights.
QUALYS_USERNAME=
QUALYS_PASSWORD=


# ══ 3. PATHS - re-check these on every box ═══════════════════════════════════
# The only group that is machine-specific. Values below are the layout
# install-fedora.sh creates: code in /opt/cti-agent, state in /var/lib/cti-agent.

# State: findings database, board, reports, caches, lock files, the budget
# ledger, and Claude Code's credentials. Must be writable by the service user.
FLEET_HOME=/var/lib/cti-agent

# Where the Go agent's source and compiled binary live. run-digest looks for
# $CTI_AGENT_DIR/cti-agent first and falls back to `go run ./cmd/cti-agent`,
# which recompiles on every digest - so a wrong value here is slow at best and
# "CTI_AGENT_DIR not set or not found" at worst.
CTI_AGENT_DIR=/opt/cti-agent/agent

# The Qualys KnowledgeBase cache: a CVE-to-QID map, ~150k entries and roughly
# 17MB. Building it takes minutes, so it is cached and refreshed
# incrementally. Never commit this file.
QUALYS_KB_CACHE=/var/lib/cti-agent/state/qualys_kb_cache.json

# How long the cache is trusted before refresh. Past this the agent attempts
# an incremental update, then a full rebuild, and if both fail it uses the
# stale cache and marks every UNKNOWN as "coverage UNVERIFIED" rather than
# implying absence.
QUALYS_KB_MAX_AGE_HOURS=168

# Where the Go agent writes its raw markdown report. Written 0600; it can
# contain real hostnames. Gitignored - keep it that way.
REPORT_PATH=/var/lib/cti-agent/reports/raw-latest.md

# Advisory feed list for the scout lane. One URL per line in that file.
FLEET_FEEDS=/etc/cti-agent/feeds.txt

# Set by systemd and the cti-agent wrapper, not usually by hand. Only needed
# if you invoke a lane directly with neither in play.
#   FLEET_CODE  where bin/ and lanes/ are    (/opt/cti-agent)
#   FLEET_ENV   this file's own path         (/etc/cti-agent/fleet.env)
#FLEET_CODE=/opt/cti-agent
#FLEET_ENV=/etc/cti-agent/fleet.env


# ══ 4. RECIPIENTS AND THE SEND GATE - required ═══════════════════════════════
# Who gets the scheduled digest. Comma-separated.
DIGEST_TO=

# Additional recipients, on CC. Use this for individuals who should see the
# digest but are not the distribution list - a DL plus four names on the To
# line reads as a mail to five parties and invites reply-all.
#
# Also gated by VM_ALLOW_TO below: a CC is still a delivery, and exempting
# it would make the allowlist trivially bypassable. Add anyone here to
# VM_ALLOW_TO as well, or the send is refused.
#
# Not used for escalations - a question addressed to one person should not
# become a thread.
DIGEST_CC=

# Shortcut: CC everyone on VM_ALLOW_TO as well, so adding a standing
# recipient is one edit instead of two.
#
# Understand what this changes before enabling it. VM_ALLOW_TO is a
# PERMISSION list - addresses this fleet MAY mail. Turning it on makes it also
# a DISTRIBUTION list - addresses this fleet DOES mail. The cost: adding
# someone to the allowlist to approve a single off-cycle send then subscribes
# them to every digest from then on. Keep the allowlist to standing
# recipients and use --approve for one-offs.
#
# FLEET_OPERATOR_EMAIL is NOT included automatically. It is added to the
# allowlist in code so the orchestrator can always escalate, and CC-ing the
# operator on every digest is not what enabling this asks for. List them in
# VM_ALLOW_TO explicitly if you do want that.
#
# Accepts true/yes/1/on. Anything else is off - a flag that turns a security
# control into a mailing list should not be enabled by a typo.
DIGEST_CC_FROM_ALLOW_TO=

# Hard allowlist, enforced in code, covering To AND Cc. A send to any address
# not listed here is refused. Defaults to DIGEST_TO if unset. This is the
# control that stops a compromised or confused agent mailing your findings
# somewhere else - keep it as tight as the job allows.
#
# When you add someone to DIGEST_TO or DIGEST_CC, add them here too. The
# fallback only covers DIGEST_TO, so a CC added without updating this is
# refused rather than silently delivered.
#
# Named FLEET_ALLOW_TO before 1.3.1. The old name is still read, with a
# note asking you to rename it; both set to different lists refuses to send.
VM_ALLOW_TO=

# ─── a second audience: application security ────────────────────────────────
#
# The Qualys WAS lane reports to Application Development, not to the
# Infrastructure people who get the daily digest. `cti-mailer --lane was` uses
# these two and NOTHING else.
#
# WAS_ALLOW_TO HAS NO FALLBACK. Unset means the lane refuses to send and says
# so. That is deliberate and it is the whole reason for a second pair: the
# default path falls back to DIGEST_TO when its allowlist is empty, and
# inheriting that here would deliver a report naming which applications have
# open Urgent findings - and which are scanned with no authentication - to a
# distribution list that never asked for it, as a successful send.
#
# A list may build on another with $NAME, which is expanded here and nowhere
# else in this file:
#
#     WAS_ALLOW_TO=$VM_ALLOW_TO,appdev@example.com
#
# An unset reference is an ERROR, not an empty string: a typo would otherwise
# silently remove everyone inherited through it. Wildcards are refused - a
# reference names exactly one list, because "every allowlist" means an audience
# that grows when somebody adds an unrelated lane.
WAS_TO=
WAS_ALLOW_TO=

# The weekly Qualys VM scan report (run-vmscan): the two scheduled scans
# combined into one email, sent to the same people as the VM digest. Like the
# WAS lane it has its own pair and NO FALLBACK - unset means it refuses to send.
# The usual setting reuses the VM audience, by reference, so there is no second
# copy of the addresses to drift:
#
#     VMSCAN_TO=$VM_ALLOW_TO
#     VMSCAN_ALLOW_TO=$VM_ALLOW_TO
#
# (VMSCAN_TO is the list it is addressed to; VMSCAN_ALLOW_TO is the list those
# recipients are checked against. They are two settings so that neither can
# silently fall back to an audience nobody chose; a reference is the explicit
# way to say "the same people".)
#
# VMSCAN_SCANS names the scheduled scans to combine, by their Qualys title,
# comma separated. Set it: unset, it is two example titles (shown below) that
# match no real schedule, so every scan would be reported missing. A scan named
# here that left no result in the last week is the first thing the report says.
VMSCAN_TO=
VMSCAN_ALLOW_TO=
#VMSCAN_SCANS=Weekly Scheduled Scan for Main Sites,North/East Weekly

# The supplier-request lane (run-supplier). The shared mailbox is on the
# supplier-request distribution list: each new request (a conversation with
# this address in To or Cc) is read, judged against one question - will this
# supplier touch company data, systems or networks, or provide technology? -
# and a Yes or an Unsure gets a Kanban item; one digest email points the
# security team at the board. It does NOTHING until SUPPLIER_ADDRESS is set,
# and the timer is off until you enable it.
#
# The address is the list's own, e.g. supplier-requests@yourcompany.example:
SUPPLIER_ADDRESS=
# The digest's audience, security team only. Own pair, NO FALLBACK.
SUPPLIER_TO=
SUPPLIER_ALLOW_TO=
# The Kanban items. The project must also be in JIRA_ALLOW_CREATE, or the items
# are not filed (the digest still goes out, and the run reports the problem).
# The owner is a Jira user's email; an unknown one leaves items unassigned.
SUPPLIER_JIRA_PROJECT=
#SUPPLIER_JIRA_TYPE=Task
# Jira files every item in the workflow's first status (Open here), which a board
# with no column for it hides: the item lands in a person's backlog. The lane
# moves each new item to this status (default To Do). Set it empty to leave
# items where Jira puts them.
#SUPPLIER_JIRA_STATUS=To Do
#SUPPLIER_OWNER_EMAIL=
# Where the digest points: an https link to the board, and what to call it.
#SUPPLIER_BOARD_URL=https://yourcompany.atlassian.net/jira/software/projects/KEY/boards/1
#SUPPLIER_BOARD_NAME=the Kanban board
# The model that judges each request: an alias (haiku, sonnet, opus) or a full
# claude-... id. It is started with NO tools. Unset - or the model down, or its
# answer unusable - every request is Unsure and gets a Kanban item, so the lane
# fails toward asking a person, never toward a No. Needs ANTHROPIC_API_KEY or
# CLAUDE_CODE_OAUTH_TOKEN below, and CLAUDE_BIN if claude is not on the path.
#SUPPLIER_MODEL=sonnet
# Your own wording. Generic defaults apply to each.
#SUPPLIER_QUESTION=Will this supplier have access to company data, systems or networks, or provide technology?
#SUPPLIER_MEANING=A Yes means the supplier is critical: ... A No means a supplier of materials or other non-technology goods. If you cannot tell, the answer is unsure.
#SUPPLIER_TPRM=third-party risk management process
#SUPPLIER_UNSURE_TEXT=We could not determine a 100% Yes, so this is Unsure, and an Unsure gets a to-do on the board.
# Words that stop a No from standing (whole words in the supplier's name, the
# subject or the form's notes). Unset: a built-in list; set empty: none.
#SUPPLIER_TECH_TERMS=software,saas,cloud,network,hosting
# Staff mail domains besides the one in SUPPLIER_ADDRESS. A thread is set aside as
# "not a request to set up a supplier" only if someone at one of these started it.
#SUPPLIER_INTERNAL_DOMAINS=
# The only attachment type read (default .xlsx). A file named like a tax or bank
# form (w9, bank, routing, void, tax, irs, ach) is never opened, whatever its type.
#SUPPLIER_FORM_TYPES=.xlsx
# How many days back to look for requests with something new (1-60, default 3).
# A thread is read whole, back 21 days before that, so a request is judged with
# the message that carries its form. A request is reported once.
#SUPPLIER_WINDOW_DAYS=3

# The coverage check in that report: the network spreadsheet against the Asset
# Groups the scans cover. It needs to find the spreadsheet in SharePoint: the
# drive and item ids of the file (Graph shows them in the file's URL or API), and
# a Graph application permission that reaches it (Sites.Selected with a read
# grant on the site, or Files.Read.All). Leave them out and the check is skipped,
# and the report says so. The ids are specific to your tenant: set them here, in
# the root-owned file, never in the repository.
#SUBNETS_DRIVE_ID=
#SUBNETS_ITEM_ID=
#SUBNETS_SHEET=Sites
# Your answers about locations the sheet does not make clear (see cti-vmscan(1)).
#NETRULES_FILE=/etc/cti-agent/netrules.txt

# Who owns each application, for the AppSec lane's Jira tickets: one ticket
# per application, assigned to its owner. The file lives beside domains.txt,
# NEVER in the repository (people's names and emails):
#
#     # application   | owner email          | Jira component (optional)
#     id:123456       | dev.lead@example.com | Web Portal
#     Customer Portal | dev.lead@example.com
#     id:777777       | dev.lead@example.com | Web | covers=www.example.com
#     id:888888       | dev.lead@example.com | watchers=a@example.com,b@example.com
#     site:brochure.example.net | web.team@example.com
#
# covers= marks a web app that is a staging/test copy scanned INSTEAD of the
# production site(s) named - reported as "covered via staging", never as a
# scan of production (RUNBOOK 11f). watchers=a@example.com,b@example.com
# (max 10) adds each as a Jira watcher on the app's ticket; needs "Manage
# watcher list" on the Jira API account, best-effort. site: lines name who should get a scan
# set up for a live website nothing scans yet. Generate the whole file with
# "cti-appscan --list-apps".
#
# The application is the scanner's web-app id ("id:" + digits, survives a
# rename) or its exact name. An application not listed gets an UNASSIGNED
# ticket and the weekly email says so. Owners are looked up in Jira by email,
# so the Jira API account needs "Browse users and groups".
APPSCAN_OWNERS_FILE=/etc/cti-agent/app-owners.txt

# Application reports to their owners, by email (run-appowners, daily). The
# domains an owner or watcher in app-owners.txt may be at: yours and each outside
# developer's, comma-separated, exact (a subdomain is a different domain). An
# address at any other domain is not sent the report, so a typo cannot mail our
# unfixed vulnerabilities to a stranger. UNSET MEANS THE LANE IS OFF.
# Only until owners.db exists: after "fleet-owners import" the allowed domains
# are kept there (fleet-owners domain allow), this line is ignored, and
# cti-mailer says so - delete it.
#OWNER_ALLOW_DOMAINS=example.com,devshop.example

# One Jira ticket per application (run-appscan). OFF by default: the reports go
# to owners by email instead. Only 1 turns tickets on.
#WAS_TICKETS=0

# Attach the scanner's own report (a zip) to each application's Jira ticket when
# it is filed or its findings change. OFF by default: test it first (RUNBOOK
# 11f, "Attaching the scanner's report"). The report contains the scan account's
# session cookies; it is deleted from the scanner and from local state after
# attaching. Only 1 turns it on. Real runs only, never --dry-run or --to-dev.
#WAS_ATTACH_REPORT=0

# Which scanner's report to fetch. Only qualys-was is built in; another scanner
# implements appscan.ReportFetcher (README "Adding a second scanner").
#APPSCAN_REPORT_PROVIDER=qualys-was

# Qualys API rate limit, read from Qualys's response headers (it follows limit
# increases by itself - nothing to change when your contract's limits rise).
# RESERVE: calls to leave for the VM lane and KnowledgeBase lookups; when only
# this many remain the optional report work gives way. MAX_WAIT: the longest it
# will sleep out a refusal (a Go duration); a longer wait is an error.
#QUALYS_RL_RESERVE=5
#QUALYS_RL_MAX_WAIT=5m

# The domains lane's list of our live websites, for the AppSec lane's NOT
# SCANNED coverage check. Empty: $FLEET_HOME/state/domains-websites.json,
# which run-domains writes every week.
APPSCAN_WEBSITES_FILE=

# ─── a third audience: the weekly domains check ─────────────────────────────
#
# `cti-mailer --lane dom`. The security team only: the report lists every
# domain we own and which of them can be spoofed, which is a target list. Same
# rules as WAS_*: NO fallback, unset refuses, $NAME references allowed.
#
#     DOM_TO=$FLEET_OPERATOR_EMAIL
#     DOM_ALLOW_TO=$DOM_TO
DOM_TO=
DOM_ALLOW_TO=

# The domain inventory. NOT in the repository (it is public): one domain per
# line, then markers that pick its row in the decision chart - send, receive,
# saas, unknown, legacy (see man cti-domains) - and # for comments. "landing"
# marks a live website as a landing page, so the AppSec lane does not ask for
# a web application scan of it (landers, parked pages and redirects are
# recognised without it).
#
#     example.com  send receive
#     example.org  receive legacy
#     example.net
#
# Owned root:ctiagent 0640, like this file.
DOMAINS_FILE=/etc/cti-agent/domains.txt

# GoDaddy Personal Access Token, READ-ONLY: grant domains.domain:read and
# nothing else. Used for one call, GET /v1/domains, which never requests auth
# codes. Unset means the report runs DNS and web checks only and says
# "[REGISTRAR NOT CHECKED]" in the subject.
GODADDY_PAT=

# DKIM selectors to probe, space- or comma-separated. Empty uses
# selector1 selector2 google default mail s1 s2 k1 dkim. Add the mail
# gateway's selector here once known - DKIM keys cannot be enumerated, so a
# selector not listed is a key this check cannot see.
DOMAINS_DKIM_SELECTORS=

# Where DMARC aggregate reports should go (e.g. the address the mail gateway
# gives you). Empty: the check is only that a sending domain has SOME rua=.
# Set: every sending domain's rua= must include this.
DOMAINS_DMARC_RUA=

# Mail-gateway evidence for the domains lane (needs POD_CLUSTER_ID and
# POD_API_TOKEN). "pod" reads the Proofpoint on Demand log for the last N days
# and never asks IT to lock down a domain that sends. Off unless set. If the
# read fails, no lock-down is asked and no ticket changes that week.
#DOMAINS_MAIL_GATEWAY=pod
# Whole days to read, 1 to 28. Default 7.
#DOMAINS_GATEWAY_DAYS=7

# Proofpoint on Demand tenant id - the 00xxxxxx in mx0a-00xxxxxx.pphosted.com.
# Empty: learned as the most common PoD tenant across the inventory's MX
# records, and the gateway section is off when no domain is on PoD at all.
# Set it if the guess could ever be wrong (most domains mid-acquisition, say).
# A domain whose MX is on a DIFFERENT PoD tenant is reported as High.
PROOFPOINT_POD_TENANT=

# Proofpoint on Demand addresses that some SPF records list DIRECTLY, because
# adding spf-<tenant>.pphosted.com would push the record over SPF's limit of
# 10 DNS lookups. An SPF that lists one of these (or a range inside one) counts
# as authorising PoD, so it is not reported as "does not authorise Proofpoint".
# Addresses or CIDR ranges, separated by COMMAS (this file is sourced by the
# shell: an unquoted space would run the second address as a command).
# Empty: none.
#PROOFPOINT_POD_IPS=148.163.143.101,148.163.147.152

# Who an SPF include is for. The weekly's "SPF INCLUDES - WHO EACH ONE IS FOR"
# section names the vendor behind each include from a built-in list of common
# senders; one not on it is shown as NOT RECOGNISED. Add or correct entries
# here as suffix=description, comma separated (no commas inside a description).
# The whole value is in quotes because descriptions contain spaces and this
# file is sourced by the shell.
#DOMAINS_SPF_VENDORS="mail.acme-surveys.example=Acme Surveys - HR survey mail,spf.smtp2go.com=SMTP2GO - web app relay"

# Proofpoint on Demand Log API, read only by cti-podprobe for now (the domains
# lane does not use it yet). The cluster ID is shown at the top right of the
# management interface. The token needs its own token, created in the Email
# Protection portal under Settings > API Key Management: the service allows
# ONE SESSION PER TOKEN, so a second client with the same token gets HTTP 409.
# POD_CLUSTER_ID=example_hosted
# POD_API_TOKEN=<token>

# The SMTP greeting probe (sitecheck.go's -smtp, plus STARTTLS): connects to
# the first answering MX of each domain, reads the banner, sends EHLO, QUITs.
# Never MAIL FROM. Each MX host is dialled once per run. "off" disables it.
# If outbound 25 is firewalled from this host the report says so once.
DOMAINS_SMTP=
DOMAINS_SMTP_PORT=25

# Which DNS the domains lane asks. Empty = public resolvers (1.1.1.1, 8.8.8.8),
# because the report is about what the INTERNET sees: a box on the corporate
# network often resolves the organisation's own domains through internal DNS
# with a split-horizon view, where SPF and DMARC records are simply absent.
# "system" = this host's resolver. Or a list of IPs, port optional:
#     DOMAINS_DNS_SERVERS=9.9.9.9,149.112.112.112
# The web and SMTP probes connect to the addresses these servers return.
DOMAINS_DNS_SERVERS=

# Where escalations and failure alerts go: a person, not the DL. Mail to the
# operator is pre-approved and needs no gate, on the principle that telling
# you something is wrong is not an outward-facing send. cti-alert refuses to
# run without this.
FLEET_OPERATOR_EMAIL=

# Development only: your own address, for --to-dev, which sends a report ONLY
# here (never CC'd, subject "[DEV TEST] ...") so you can see it rendered in
# Outlook without mailing the team. Accepted by cti-mailer, cti-alert and the
# run-digest, run-patchtuesday, run-appscan and run-domains runners; a runner
# test send records nothing, files no tickets and advances no baseline.
# Nothing scheduled uses it.
FLEET_DEV_EMAIL=

# Your organisation, shown in the digest header and footer. Makes a forwarded
# copy identifiable and stops the mail reading like a vendor newsletter.
# Defaults to "Security" so the kit stays generic. Quote it - the runners
# source this file with `set -a`, and an unquoted second word is read as a
# command rather than part of the value.
FLEET_ORG="Example Org"

# The credit line at the foot of the daily digest, the monthly Patch Tuesday
# synopsis, the AppSec weekly and the emails to application owners (the owners
# are often outside the company, so this is how they learn who sent it). Both
# are unset by default, which renders the plain
# "Generated by the <FLEET_ORG>" every lane's email carries - the kit
# advertises nobody until you ask it to.
#
# Setting FLEET_REPO_URL alone is enough; the text then defaults to
# "Correlated and published by the <FLEET_ORG> Claude Code Agent Fleet".
# Set FLEET_ATTRIBUTION to override the wording.
#
# BEFORE YOU SET THE URL, CHECK WHAT IT POINTS AT.
# This puts a clickable link in every digest that goes to the distribution
# list, so it is an advertisement for whatever is at the other end. If the
# repository is public, everyone on the DL now has a direct route to the
# architecture, the Graph permission model, and the fact that generated
# reports contain hostname targeting lists. None of that is secret, and the
# history here has been scrubbed - but a fork made before the scrub keeps the
# old commits, and an origin rewrite cannot reach it. Confirm the fork
# situation before widening the audience.
#
# Only http:// and https:// are rendered as links. Anything else is refused
# and logged, because this value ends up in an href in Outlook.
FLEET_ATTRIBUTION=
FLEET_REPO_URL=

# ─────────────────────────────────── mailbox cleanup ───────────────────────
#
# Once a day, after the digest: processed advisories to Archive, out-of-office
# auto-replies to Deleted Items, anything the agent has no record of reading
# left exactly where it is.
#
# THIS NEEDS A NEW GRAPH PERMISSION. Mail.Read cannot move a message. The app
# registration needs Mail.ReadWrite as an APPLICATION permission with admin
# consent. Understand what that widens before granting it: a leaked client
# secret goes from "read this mailbox and send as it" to "move and delete mail
# in every mailbox the access policy allows". If you have not applied the
# New-ApplicationAccessPolicy restriction in the README, do that first - with
# it, the new role is confined to the CTI mailbox like the others.
#
# Nothing in this fleet can permanently delete mail. internal/graph implements
# move-to-folder and nothing else; Graph's DELETE and purge endpoints are not
# there, so "delete" means Deleted Items and emptying it stays a person's job.
#
# FLEET_PROCESSED_LOG overrides where the agent records which messages it read.
# The default is $FLEET_HOME/state/processed-messages.json. That file is the
# lane's entire authority to move anything: no entry, no move.
# Not a setting - a one-shot confirmation, passed on the command line, never
# stored here. `run-patchtuesday --for-real --month <past month>` refuses
# unless FLEET_CONFIRM_RESEND names that same month, because the combination
# sends a past month's synopsis to the distribution list dated today. Putting
# it in this file would defeat the point.
#   sudo FLEET_CONFIRM_RESEND=2026-08 cti-agent run-patchtuesday --for-real --month 2026-08

FLEET_PROCESSED_LOG=

# Report when this many inbox messages have no processing record. A growing
# backlog is what "the agent stopped reading the mailbox" looks like from
# outside - the digest keeps succeeding and quietly reports on nothing.
FLEET_MAILBOX_BACKLOG_THRESHOLD=25

# The operator's name, used in the orchestrator's prompt and board lines so
# it addresses a person rather than "the operator". Quoted because it contains
# a space: run-digest and run-checkin source this file with `set -a`, and an
# unquoted second word is read as a command, not part of the value.
FLEET_OPERATOR="Firstname Lastname"


# ══ 4b. SCHEDULE TIMEZONE ════════════════════════════════════════════════════
# systemd's OnCalendar= uses the SYSTEM timezone, and servers are usually UTC.
# A digest timed for 06:00 therefore lands at 02:00 for an operator on US
# Eastern - six hours stale by the time anyone reads it, which defeats the
# point of a morning digest.
#
# Set an IANA timezone here and install-fedora.sh writes systemd drop-ins that
# pin the digest and weekly timers to it. DST is handled by systemd; a
# hardcoded UTC offset would drift an hour every winter.
#
# Leave blank to keep the system timezone. Only the two human-facing timers
# are pinned - the heartbeat every 2h and the scout every 4h do not care what
# a clock on a wall says.
#
#   timedatectl list-timezones | grep -i york      # find yours
FLEET_TIMEZONE=

# When the daily digest, the Monday weekly and the monthly Patch Tuesday
# synopsis run, in FLEET_TIMEZONE.
#
# The Patch Tuesday timer fires on the Wednesday AFTER the second Tuesday -
# deliberately not "the second Wednesday", which is the usual way to say it and
# is wrong about one month in seven. Whenever the 1st is a Wednesday the second
# Wednesday lands six days BEFORE Patch Tuesday, and the lane would wake up
# before the content existed.
FLEET_DIGEST_TIME=06:00:00
FLEET_WEEKLY_TIME=07:00:00
FLEET_PATCHTUESDAY_TIME=07:30:00
# Mailbox cleanup. It must run AFTER the digest: it only archives on a day the
# digest has processed CTI mail, so a time before FLEET_DIGEST_TIME means it
# does nothing, every day. Before this setting existed the timer was not moved
# to FLEET_TIMEZONE, ran at 07:00 UTC (02:00 Eastern) and did exactly that.
FLEET_MAILBOX_TIME=07:00:00
# The AppSec lanes, in FLEET_TIMEZONE. Owner reports go out daily, the AppSec
# weekly on Fridays and the domains check on Tuesdays. Keep the domains run
# before the Friday AppSec report (it writes the website list that report
# reads), and keep the owner report and the weekly at least a few minutes
# apart: both spend the shared Qualys API budget.
FLEET_APPOWNERS_TIME=07:15:00
FLEET_APPSCAN_TIME=07:30:00
FLEET_DOMAINS_TIME=08:00:00
# The weekly Qualys VM scan report, Mondays, after the Thursday scans finish.
FLEET_VMSCAN_TIME=08:00:00
# The supplier-request lane, every morning, before the day's requests pile up.
FLEET_SUPPLIER_TIME=07:45:00


# ══ 5. REPORT CONTENT ════════════════════════════════════════════════════════
# How hostnames appear in digests.
#   full    real hostnames. Actionable, and the reason to pick it: a finding
#           nobody can locate is not a finding. The digest then contains an
#           inventory of vulnerable machines - treat it accordingly.
#   redact  salted SHA-256 pseudonyms, host-xxxxxxxx. Stable across runs,
#           not reversible, and not resolvable by whoever has to patch it.
#   count   host counts only.
REPORT_HOSTNAMES=full

# Salt for redact mode. Any non-empty string, kept private and kept stable:
# changing it changes every pseudonym and breaks continuity with older
# digests, and leaving it empty makes the pseudonyms trivially reversible by
# anyone who can guess a hostname. The report says so in its own header when
# this is unset.
REPORT_REDACTION_SALT=


# ══ 6. ENRICHMENT ════════════════════════════════════════════════════════════
# Free from https://nvd.nist.gov/developers/request-an-api-key
# Without it NVD throttles to 5 requests / 30s, so a 50-CVE day takes ~5
# minutes of the digest window. With it, 50 requests / 30s.
NVD_API_KEY=

# User-Agent the fleet sends to the sites it polls: NVD, EPSS, CISA and your
# RSS feeds (scout, enrich), Microsoft and the Patch Tuesday wrap-ups, and the
# domains web check. Some publishers block unrecognised agents; naming
# yourself is also the courteous thing to do when polling someone's server six
# times a day. The fleet appends GRAPH_MAILBOX as the contact, read at run
# time, so the agent goes out as
#     cti-agent-fleet/1.0 (+mailto:<GRAPH_MAILBOX>)
# Put your own "(...)" comment in this value to replace that contact. Unset,
# each component sends its own name (cti-agent-scout/1.0 and so on).
FLEET_USER_AGENT=cti-agent-fleet/1.0


# ══ 7. CLAUDE CODE - the heartbeat lane only ═════════════════════════════════
# The digest, weekly and scout lanes are stdlib Python and need none of this.
# Only run-checkin calls claude, so an unset token costs you the heartbeat,
# never the morning email.

# Absolute path to the claude binary. Blank auto-detects /usr/bin/claude
# (dnf) or /usr/local/bin/claude. On Linux it must be root-owned: run-checkin
# refuses a claude the service account could replace, such as a native
# install in /var/lib/cti-agent/.local/bin.
CLAUDE_BIN=

# The model the heartbeat runs on: an alias (haiku, sonnet, opus, fable) or a
# full id (claude-...). Blank uses the account's default. The beat is routine
# work - reading the board, journal and timers, writing a short memory - so a
# cheaper model is usually enough; watch a week or two of beats before going
# further (BACKLOG: "Heartbeat escalation to a stronger model"). Each beat logs
# "model: ..." in its journal, and the healthcheck shows the last one. A value
# that is not a model name refuses the beat with an ERROR on the board, rather
# than quietly running the default.
CHECKIN_MODEL=

# The beat trace: every heartbeat's full record (the model, each tool call,
# what was denied, turns, tokens, cost) kept in state/traces, read with
# `sudo cti-agent fleet-trace show --last` or `list`. Days to keep them (0 runs
# the beat untraced, as before traces existed) and the most one beat's trace may grow to.
# A trace holds the untrusted text the beat read: 0600, never mailed, and not
# readable by the beat. A value that is not a number warns and uses the default.
CHECKIN_TRACE_DAYS=14
CHECKIN_TRACE_MAX_MB=20

# Authentication. The service account has no browser and, on Fedora, no login
# shell, so it cannot complete the interactive flow. Set EXACTLY ONE of these.
#
# EXACTLY ONE IS ENFORCED, not merely advised - run-checkin refuses to beat
# when more than one is set, and names the credential it is using on every
# beat. The reason is that claude silently prefers ANTHROPIC_API_KEY, so a
# fleet deliberately wired to a subscription seat (option B) will draw down a
# Console credit balance instead if a stale key is left in this file. That
# failure surfaces as "Credit balance is too low" on a box nobody believed
# was metered, and before this was enforced no log ever said which credential
# was in play.
#
# A. Console API key, from platform.claude.com. Metered per token, billed to
#    the org, revocable on its own without touching anyone's login. Pick this
#    if you have access to a Console account.
ANTHROPIC_API_KEY=
#
# B. Subscription token. Run `claude setup-token` on any machine where you are
#    already logged in - a laptop is fine - and paste the result here. Bills
#    against a subscription seat rather than metered tokens, and is the only
#    workable option on Fedora. It expires in about a year and the heartbeat
#    stops dead when it does, so calendar the renewal.
CLAUDE_CODE_OAUTH_TOKEN=
#
# C. Bearer token for an LLM gateway or proxy that fronts Claude.
ANTHROPIC_AUTH_TOKEN=
#
# D. Authenticate the service account itself, once, interactively. Requires
#    that the account HAS a login shell, which the Fedora layout does not give
#    it. Leave A/B/C blank and run:
#        sudo -u ctiagent HOME=/var/lib/cti-agent claude
#    Credentials land in $HOME/.claude/.credentials.json, inside
#    StateDirectory, so they survive restarts and upgrades.
#
# B, C and D all share a person's seat with an unattended process. A costs
# money instead. There is no option that avoids both.

# Optional. Moves Claude Code's config and credentials elsewhere. Leave blank
# unless you have a reason - the default is under FLEET_HOME already.
CLAUDE_CONFIG_DIR=


# ══ 8. QUOTA CEILINGS - matters most with option B, C or D ═══════════════════
# With a subscription credential the fleet spends YOUR quota. An overrun does
# not cost money, it costs you your own access mid-afternoon, with no warning.
#
# The fleet cannot negotiate for quota: it runs on a different machine from
# your own sessions, nothing reports how much of the window is left, and the
# only signal either side gets is a rate-limit error after the fact. So it
# takes a fixed slice and leaves the rest alone.
#
# Defaults suit the shipped 2-hour cadence: 12 beats/day, 2-3 per 5h window.
# WINDOW_BEATS=4 therefore does not bind in normal operation - it is there to
# absorb catch-up bursts and retry storms. Raise it to give the fleet more of
# your quota; lower DAILY_BEATS to reserve more for yourself.
FLEET_BUDGET_WINDOW_HOURS=5
FLEET_BUDGET_WINDOW_BEATS=4
FLEET_BUDGET_DAILY_BEATS=14

# After a rate limit the fleet backs off, doubling each consecutive time, so a
# throttled heartbeat stops asking instead of digging the hole deeper. Hours;
# fractions are fine.
FLEET_BUDGET_BACKOFF_BASE_HOURS=0.5
FLEET_BUDGET_BACKOFF_MAX_HOURS=6

# Where the ledger lives. Defaults to $FLEET_HOME/budget.json, mode 0600.
FLEET_BUDGET_FILE=

# ══ 9. JIRA TICKETING - confirmed exposure becomes tracked work ══════════════
# When the daily digest finds a CISA KEV entry or a Sev5, the fleet files ONE
# ticket per CVE carrying every affected QID and host, and then quotes that
# ticket in the digest until the scanner stops finding the vulnerability.
#
# One per CVE, not one per host and not one per QID. CVE-2026-85880 alone is
# ~441 hosts across two QIDs; per-host tickets would be a storm nobody reads,
# and per-QID tickets fragment one CISA deadline across several tickets.
#
# Leave JIRA_ALLOW_CREATE empty and the fleet writes nothing to Jira: no new
# tickets, and (since 1.3) no comments or attachments on existing ones either.
# That is a valid way to run this - everything else still works.

JIRA_BASE_URL=https://yourorg.atlassian.net

# OPTIONAL. Only for an Atlassian SCOPED API token (a service account's token
# with read:jira-work, write:jira-work, read:jira-user), which Atlassian
# refuses at the site URL. Set this and API calls go through the gateway
# https://api.atlassian.com/ex/jira/<cloud id>; links in email still use
# JIRA_BASE_URL. Unset = unchanged: a classic token against JIRA_BASE_URL.
# A UUID only; find it at https://yourorg.atlassian.net/_edge/tenant_info
#JIRA_CLOUD_ID=11111111-2222-3333-4444-555555555555

# The account the API token belongs to. Its permissions ARE the fleet's
# permissions: an API token carries everything that account can do, so this
# should be a service account that can create issues in the allowlisted
# project and as little else as possible. Not a person's own login - when they
# leave, the ticketing lane stops, and every ticket filed was attributed to
# somebody who did not file it.
JIRA_EMAIL=
JIRA_API_TOKEN=

# Where tickets go. NO DEFAULT, deliberately - same rule as DIGEST_TO. A
# ticket filed into the wrong project has been seen by whatever automation
# watches that project, and cannot be unseen.
JIRA_PROJECT_KEY=

# The issue type NAME, exactly as the project spells it.
#
# "Task" is the obvious guess and it is wrong for a Jira Service Management
# desk: such a project's types are things like "IT Support", "Off-Boarding",
# "New-Hire IT Request" - there may be no Task at all. Check the project
# before setting this; a wrong value fails on the first create with
#
#   issuetype: Task is not valid for project CR
JIRA_ISSUE_TYPE=

# OPTIONAL. Send the weekly domains lock-down ticket to a different project
# from JIRA_PROJECT_KEY (IT tracks DNS work in INF; CVE and AppSec tickets stay
# where JIRA_PROJECT_KEY puts them). Unset = the same project as everything
# else. Set the issue type with it: a separate project has its own types, and
# JIRA_ISSUE_TYPE is not assumed to exist there. The project must ALSO be in
# JIRA_ALLOW_CREATE below, and the ticket the lane updates is the open one in
# this project labelled cti-agent and cti-domains-lockdown.
#JIRA_DOMAINS_PROJECT_KEY=
#JIRA_DOMAINS_ISSUE_TYPE=

# The write gate. Comma-separated project keys the fleet may create issues in.
# Empty means create nothing - this fails CLOSED, exactly like VM_ALLOW_TO.
# The project key alone is not enough: this has to be set as a second,
# deliberate act, so that a copied fleet.env cannot start filing tickets into
# somebody else's project.
JIRA_ALLOW_CREATE=

# The close gate, separate from the write gate above. Comma-separated project
# keys in which the weekly AppSec run may CLOSE the open ticket of a Qualys web
# app that has been deleted from the scanner (the only place the fleet changes
# a ticket's status). Empty means never close. Needs the Jira permission
# "Transition issues"; `cti-jira --check` lists it once this is set.
#JIRA_ALLOW_CLOSE=

# OPTIONAL. Only when the workflow has several transitions into a Done-category
# status: the name of the one to use (case-insensitive). Unset = the single
# transition that leads to Done; if there are several and this is unset, the
# ticket is left open and the report says why.
#JIRA_CLOSE_TRANSITION=

# ══ 10. MAILBOX CLEANUP WINDOW ═══════════════════════════════════════════════
# How far back the cleanup lane looks, and how long a processed advisory stays
# in the inbox before it is filed away.
#
# THESE ARE NOT GRAPH_LOOKBACK_HOURS, and that is the point.
#
# The cleanup used to share that variable. With both at 24h the window was
# exactly the interval between runs, which leaves a gap that never closes: an
# advisory arriving in the hour before the lane fires is processed later that
# day, and by the next run it has already fallen out of a 24h window. It is
# never archived, ever. Four advisories a day quietly accumulating in a shared
# inbox, looking like the lane "sometimes misses some".
#
# So the window must EXCEED the time between runs - and, since 1.3.2, cover
# the weekly application-security lane too: it reports a week of Qualys WAS
# notices at once, and the cleanup can only archive one it can still see.
# 336h (14 days) matches how long the processed log keeps its records; it was
# 72h before 1.3.2.
MAILBOX_LOOKBACK_HOURS=336

# How long an advisory the agent has already read stays in the inbox.
#
# Without this, whether today's roundup gets filed depends on what time the
# lane happens to run: before the morning digest it is unprocessed and left
# alone, after it the CVEs are banked and it is archived immediately. Same
# code, same mailbox, different outcome by clock position. The grace makes the
# answer the same whenever it runs, and leaves this morning's intel where a
# colleague expects to find it.
#
# Must be LESS than MAILBOX_LOOKBACK_HOURS - the agent refuses to start
# otherwise, because a grace at least as long as the window means nothing is
# ever both old enough and still visible, and the lane silently does nothing.
#
# MUST BE AT LEAST GRAPH_LOOKBACK_HOURS. The agent reads this grace as the
# promise that the digest has finished with a message before it is filed.
#
# cti-agent ingests from the INBOX over GRAPH_LOOKBACK_HOURS and rebuilds its
# report from scratch every run. Archive a message still inside that window and
# it is gone from the next ingest, so any CVE reported only by that message
# disappears from tomorrow's digest - not because the exposure changed, but
# because the mail was filed. The digest stops describing the estate and starts
# describing how tidy the mailbox is.
#
# That happened on 1 October 2026: a manual cleanup archived three advisories
# hours after they arrived, and the next morning's digest was missing what only
# they had reported. The agent refuses to start if this is set shorter.
#
# 48 rather than 24 for margin: the two lanes run on independent timers and
# nothing synchronises them.
#
# 0 disables the grace and restores the old archive-on-sight behaviour.
# Auto-replies are deleted immediately either way; the grace exists so a
# person can still read an advisory, and nobody wants to read a bounce.
MAILBOX_MIN_AGE_HOURS=48

# How long the fleet's own reports (the daily digest, the weeklies) stay in the
# inbox before cleanup archives them: a week, so the team can still read them
# where they arrive. Must be less than MAILBOX_LOOKBACK_HOURS. 0 archives them
# on sight.
#MAILBOX_SELF_MIN_AGE_HOURS=168

# The quarantine digest's sending address(es), exactly, comma-separated - the
# "End User Digest" mail. The cleanup reads each digest's list of held
# messages: if none is from a sender the fleet reads (Qualys, built in, and
# MAILBOX_FEED_SENDERS below) the digest goes to Deleted Items on sight,
# whoever it is addressed to. If one is, the digest stays a week and the
# operator is told by cti-alert to release it - the fleet never releases mail.
# Blank turns the rule off.
#MAILBOX_DIGEST_SENDERS=digest@example.com

# The senders the fleet reads besides Qualys - the threat-intel newsletters and
# advisory lists - so quarantined mail from them is caught. "name@example.com"
# for that address exactly, "@example.com" for that domain exactly.
#MAILBOX_FEED_SENDERS=intel@example.com,@advisories.example.com
