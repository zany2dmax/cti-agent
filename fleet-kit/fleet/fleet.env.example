# ~/fleet/fleet.env   chmod 600 - this file holds a client secret.
# Superset of the Go agent's .env so one file drives the whole fleet.

# ── Entra / Microsoft Graph ────────────────────────────────────────────────
# Same app registration the Go agent uses to READ the mailbox.
# Add Mail.Send (Application) and grant admin consent so the fleet can send.
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=replace-me
GRAPH_MAILBOX=security@example.com
GRAPH_FOLDER=inbox
GRAPH_LOOKBACK_HOURS=24

# ── Vulnerability lookup provider ─────────────────────────────────────────
# qualys | crowdstrike | none
LOOKUP_PROVIDER=qualys
# Your Qualys pod's API URL - qg1/qg2/qg3/qg4 etc. differ per subscription.
# Check Help > About in the Qualys UI if you are not sure which pod you are on.
QUALYS_BASE_URL=https://qualysapi.qg1.apps.qualys.com
QUALYS_USERNAME=replace-me
QUALYS_PASSWORD=replace-me
QUALYS_KB_CACHE=/home/ctiagent/fleet/state/qualys_kb_cache.json
# Hours before the CVE->QID cache is refreshed (default 168 = 7 days). An
# expired mapping silently reports newer CVEs as UNKNOWN, which reads as clean.
QUALYS_KB_MAX_AGE_HOURS=168

# ── Fleet layout ──────────────────────────────────────────────────────────
FLEET_HOME=/home/ctiagent/fleet
CTI_AGENT_DIR=/home/ctiagent/cti-agent
REPORT_PATH=/home/ctiagent/fleet/reports/raw-latest.md

# Hostname disclosure in the report: full (default) | redact | count
# The report pairs exploitable CVEs with the machines that have them, which is
# a targeting list if it leaks - never commit it or attach it outside
# controlled locations. "full" is still the default because "redact" produces
# pseudonyms that cannot be looked up in the scanner, which makes a P1
# unactionable. Use redact/count only for copies leaving the DL.
REPORT_HOSTNAMES=full
# Private, stable salt for hostname pseudonyms. Without it the mapping is
# confirmable by anyone holding a list of candidate hostnames.
REPORT_REDACTION_SALT=replace-me-with-a-private-stable-value

# ── Outbound mail ─────────────────────────────────────────────────────────
DIGEST_TO=security@example.com
# Hard allowlist. mailer.py refuses any recipient not on this list unless the
# orchestrator passes --approve after the operator okays that specific send.
FLEET_ALLOW_TO=security@example.com

# ── Enrichment ────────────────────────────────────────────────────────────
# Free from https://nvd.nist.gov/developers/request-an-api-key
# Without it NVD throttles to 5 requests / 30s, so a 50-CVE day takes ~5 min.
NVD_API_KEY=

# ── Claude Code ───────────────────────────────────────────────────────────
# Absolute path to the claude binary. Leave blank to auto-detect. Set it if you
# have more than one install, or if `which claude` differs between your shell
# and the systemd unit's environment (it usually does).
#   native installer:  /var/lib/cti-agent/.local/bin/claude
#   apt / dnf / apk:   /usr/bin/claude
CLAUDE_BIN=

# Authentication for the checkin lane. The service account has no browser and
# no interactive terminal, so it cannot complete the normal login flow - if
# none of the options below is satisfied, run-checkin finds the binary and then
# fails at authentication, which reads confusingly in the journal.
#
# Set EXACTLY ONE. systemd passes this file in as the unit environment, so a
# value here is all that is needed; leave the others blank.
#
# Option A: a Console API key. Metered per token, billed to the org, revocable
# on its own without touching anyone's login. The checkin lane's usage is
# small. This is the one to pick if you do not have a reason to prefer B.
ANTHROPIC_API_KEY=
#
# Option B: a long-lived subscription token. Run this on a machine where you
# are already logged in - a laptop is fine, it does not have to be the server:
#     claude setup-token
# Paste the result here. It bills against a Claude subscription seat rather
# than metered tokens, and it is the only workable choice on Fedora, where the
# service account is a system account with no login shell and so cannot run
# the interactive flow at all. The token expires and the heartbeat stops dead
# when it does, so calendar the renewal.
#
# IMPORTANT with option B: the fleet is now spending YOUR quota. An overrun
# does not cost money, it costs you your own access mid-afternoon. Set the
# ceilings below deliberately rather than leaving them to chance.
CLAUDE_CODE_OAUTH_TOKEN=
#
# Option C: authenticate as the service account itself, once, interactively.
# Requires that the account HAS a login shell:
#     sudo -u ctiagent HOME=/var/lib/cti-agent claude
# It prints a URL to open in a browser. Credentials are written to
# /var/lib/cti-agent/.claude/.credentials.json, inside StateDirectory, so they
# persist across restarts and upgrades. Leave both variables above blank.
#
# B and C both place a person's credentials on a server and share their seat
# with an unattended process. Weigh that against A's metered billing; there is
# no option that avoids both.

# ── Quota ceilings for the heartbeat ──────────────────────────────────────
# Only the checkin lane spends quota; the digest, weekly and scout lanes are
# stdlib Python and cost nothing. These ceilings exist because the fleet and
# the operator draw on the same subscription from different machines, and
# nothing reports how much is left - so the fleet takes a fixed slice and
# leaves the rest alone rather than discovering the limit by hitting it.
#
# Defaults suit the shipped 2-hour cadence (12 beats/day, 2-3 per 5h window).
# WindowBeats=4 therefore does not bind in normal operation; it is there to
# absorb catch-up bursts and retry storms. Raising it is how you give the
# fleet more of your quota.
FLEET_BUDGET_WINDOW_HOURS=5
FLEET_BUDGET_WINDOW_BEATS=4
FLEET_BUDGET_DAILY_BEATS=14

# After a rate limit the fleet backs off, doubling each consecutive time, so a
# throttled heartbeat stops asking instead of hammering a quota you are trying
# to use. Hours; fractions are fine.
FLEET_BUDGET_BACKOFF_BASE_HOURS=0.5
FLEET_BUDGET_BACKOFF_MAX_HOURS=6

# Where the ledger lives. Defaults to $FLEET_HOME/budget.json, mode 0600.
FLEET_BUDGET_FILE=

# ── Operator identity ─────────────────────────────────────────────────────
# Who the orchestrator reports to. Used in escalation emails and board
# lines; the @operator handle refers to this person.
FLEET_OPERATOR=Firstname Lastname

# Sent as the User-Agent to NVD, EPSS, CISA and advisory feeds. Some feeds ask
# for a contact address; supply one only if you are comfortable publishing it.
FLEET_USER_AGENT=cti-agent/1.0

# ── Escalation channel (orchestrator only) ────────────────────────────────
# Where the orchestrator emails you when it needs a decision it cannot make.
# Escalations here are pre-approved - it must be able to ask without asking.
FLEET_OPERATOR_EMAIL=you@example.com

# Mailbox you reply INTO. The orchestrator reads it each check-in and matches
# replies by the [FLEET <id>] subject tag. Defaults to GRAPH_MAILBOX, which is
# usually right: the agent already has Mail.Read on it.
CTI_REPLY_MAILBOX=
