#!/usr/bin/env python3
"""fleet-db - SQLite memory for the CTI fleet.

  fleet-db init                       create schema (idempotent)
  fleet-db remember <cat> <topic> <content>
  fleet-db recent [n]                 recent memories, open tasks, unacked mail
  fleet-db task add <title> | done <id> | list
  fleet-db mail send <agent> <kind> <body> | inbox <agent> | ack <id>
  fleet-db finding upsert <json>      persist an enriched finding
  fleet-db findings [--priority Sev5] [--stale-days N]
  fleet-db sent <date> <s5> <s4> <s3> <s2> <s1> <message_id>
  fleet-db note <cve> <text>          record who is handling a finding
  fleet-db was-sent <date> <kind>     exit 0 if a digest already went out
  fleet-db vacuum
"""
import json
import os
import sqlite3
import sys
from datetime import datetime, timezone

FLEET_HOME = os.environ.get("FLEET_HOME", os.path.expanduser("~/fleet"))
DB = os.path.join(FLEET_HOME, "state", "memory.db")

# Renaming the scale is a data migration, not just a label change: rows
# already written say P1-P4, and the digests table had four count columns.
# Applied on every connect, cheap and idempotent - a fleet that upgrades and
# then silently reports zero findings because the values no longer match is
# worse than one that refuses to start.
MIGRATIONS = [
    # digests: p1..p4 -> sev5..sev1. Old rows keep their numbers under the new
    # names in urgency order; the split band starts empty rather than guessing.
    ("digests", "sev5", [
        "ALTER TABLE digests ADD COLUMN sev5 INTEGER",
        "ALTER TABLE digests ADD COLUMN sev4 INTEGER",
        "ALTER TABLE digests ADD COLUMN sev3 INTEGER",
        "ALTER TABLE digests ADD COLUMN sev2 INTEGER",
        "ALTER TABLE digests ADD COLUMN sev1 INTEGER",
        "UPDATE digests SET sev5=p1, sev4=p2, sev3=0, sev2=p3, sev1=p4 "
        "WHERE sev5 IS NULL",
    ]),
]

# findings.priority values, old -> new. P2 mapped to Sev4 rather than Sev3
# because the old band was mostly confirmed-present; anything that should be
# Sev3 gets there on the next enrich pass, which recomputes every row anyway.
PRIORITY_MAP = {"P1": "Sev5", "P2": "Sev4", "P3": "Sev2", "P4": "Sev1"}

SCHEMA = """
CREATE TABLE IF NOT EXISTS memories (
  id INTEGER PRIMARY KEY, category TEXT NOT NULL, topic TEXT,
  content TEXT NOT NULL, ts TEXT NOT NULL);
CREATE INDEX IF NOT EXISTS ix_mem_cat ON memories(category, ts);

CREATE TABLE IF NOT EXISTS tasks (
  id INTEGER PRIMARY KEY, title TEXT NOT NULL,
  done INTEGER NOT NULL DEFAULT 0, ts TEXT NOT NULL, done_ts TEXT);

CREATE TABLE IF NOT EXISTS mailbox (
  id INTEGER PRIMARY KEY, to_agent TEXT NOT NULL, kind TEXT NOT NULL,
  body TEXT NOT NULL, acked INTEGER NOT NULL DEFAULT 0, ts TEXT NOT NULL);
CREATE INDEX IF NOT EXISTS ix_mail_agent ON mailbox(to_agent, acked);

-- One row per CVE we have ever seen. first_seen never changes; everything
-- else is refreshed on each enrich pass.
CREATE TABLE IF NOT EXISTS findings (
  cve TEXT PRIMARY KEY, status TEXT, provider TEXT, qids TEXT,
  host_count INTEGER DEFAULT 0, qualys_score INTEGER DEFAULT 0,
  last_seen TEXT, sample_hosts TEXT,
  cvss REAL, cvss_severity TEXT, epss REAL, epss_pct REAL,
  kev INTEGER DEFAULT 0, kev_added TEXT, kev_due TEXT, ransomware TEXT,
  priority TEXT, rationale TEXT, description TEXT,
  first_seen TEXT, updated TEXT, remediation_note TEXT);
CREATE INDEX IF NOT EXISTS ix_find_pri ON findings(priority, updated);

CREATE TABLE IF NOT EXISTS scout_items (
  id INTEGER PRIMARY KEY, cve TEXT, feed TEXT, title TEXT, link TEXT,
  published TEXT, correlated INTEGER DEFAULT 0, ts TEXT NOT NULL,
  UNIQUE(cve, feed));

CREATE TABLE IF NOT EXISTS digests (
  id INTEGER PRIMARY KEY, kind TEXT NOT NULL, day TEXT NOT NULL,
  sev5 INTEGER, sev4 INTEGER, sev3 INTEGER, sev2 INTEGER, sev1 INTEGER,
  message_id TEXT, ts TEXT NOT NULL, UNIQUE(kind, day));
"""


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def conn():
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    c = sqlite3.connect(DB)
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA journal_mode=WAL")   # concurrent lanes reading while one writes
    c.execute("PRAGMA busy_timeout=5000")
    return c


def migrate(c):
    """Apply the Sev rename to an existing database.

    Runs on every call, after the schema. Each step is guarded by whether the
    target column already exists, so it is idempotent and costs one PRAGMA.

    Done in code rather than by hand because the alternative is a fleet that
    upgrades, finds no rows matching the new severity values, and reports a
    clean estate - the most dangerous wrong answer this system can give.
    """
    for table, marker, steps in MIGRATIONS:
        cols = {r[1] for r in c.execute(f"PRAGMA table_info({table})")}
        if not cols or marker in cols:
            continue          # table absent, or already migrated
        for stmt in steps:
            try:
                c.execute(stmt)
            except Exception as e:                              # noqa: BLE001
                print(f"migrate: {table}: {stmt.split()[0]} failed: {e}",
                      file=sys.stderr)
        print(f"migrate: {table} -> Sev5..Sev1", file=sys.stderr)

    # findings.priority values.
    cols = {r[1] for r in c.execute("PRAGMA table_info(findings)")}
    if "priority" in cols:
        n = 0
        for old, new in PRIORITY_MAP.items():
            cur = c.execute("UPDATE findings SET priority=? WHERE priority=?",
                            (new, old))
            n += cur.rowcount or 0
        if n:
            print(f"migrate: remapped {n} finding(s) from P1-P4 to Sev5-Sev1",
                  file=sys.stderr)
    c.commit()


def main(argv):
    if not argv:
        print(__doc__)
        return 2
    cmd, args = argv[0], argv[1:]
    c = conn()

    if cmd == "init":
        c.executescript(SCHEMA)
        c.commit()
        migrate(c)
        print(f"initialized {DB}")
        return 0

    c.executescript(SCHEMA)  # cheap, keeps schema current on every call
    c.commit()
    migrate(c)

    if cmd == "remember":
        cat, topic, content = args[0], args[1], " ".join(args[2:])
        c.execute("INSERT INTO memories(category,topic,content,ts) VALUES(?,?,?,?)",
                  (cat, topic, content, now()))
        c.commit()
        print("ok")

    elif cmd == "recent":
        n = int(args[0]) if args else 20
        print("== recent memories ==")
        for r in c.execute("SELECT ts,category,topic,content FROM memories "
                           "ORDER BY id DESC LIMIT ?", (n,)):
            print(f"{r['ts']}  [{r['category']}] {r['topic']}: {r['content'][:160]}")
        print("\n== open tasks ==")
        for r in c.execute("SELECT id,title,ts FROM tasks WHERE done=0 ORDER BY id"):
            print(f"#{r['id']} {r['title']}  (since {r['ts']})")
        print("\n== unacked mailbox ==")
        for r in c.execute("SELECT id,to_agent,kind,body FROM mailbox WHERE acked=0"):
            print(f"#{r['id']} -> {r['to_agent']} [{r['kind']}] {r['body'][:120]}")
        print("\n== priority counts ==")
        for r in c.execute("SELECT priority,COUNT(*) n FROM findings "
                           "GROUP BY priority ORDER BY priority"):
            print(f"{r['priority'] or 'unscored'}: {r['n']}")

    elif cmd == "task":
        sub = args[0]
        if sub == "add":
            c.execute("INSERT INTO tasks(title,done,ts) VALUES(?,0,?)",
                      (" ".join(args[1:]), now()))
        elif sub == "done":
            c.execute("UPDATE tasks SET done=1, done_ts=? WHERE id=?", (now(), int(args[1])))
        elif sub == "list":
            for r in c.execute("SELECT id,title,done FROM tasks ORDER BY done,id"):
                print(f"[{'x' if r['done'] else ' '}] #{r['id']} {r['title']}")
        c.commit()

    elif cmd == "mail":
        sub = args[0]
        if sub == "send":
            c.execute("INSERT INTO mailbox(to_agent,kind,body,acked,ts) VALUES(?,?,?,0,?)",
                      (args[1], args[2], " ".join(args[3:]), now()))
        elif sub == "inbox":
            for r in c.execute("SELECT id,kind,body,ts FROM mailbox "
                               "WHERE to_agent=? AND acked=0 ORDER BY id", (args[1],)):
                print(f"#{r['id']} [{r['kind']}] {r['body']}  ({r['ts']})")
        elif sub == "ack":
            c.execute("UPDATE mailbox SET acked=1 WHERE id=?", (int(args[1]),))
        c.commit()

    elif cmd == "ack":
        c.execute("UPDATE mailbox SET acked=1 WHERE id=?", (int(args[0]),))
        c.commit()

    elif cmd == "finding":
        # upsert from a JSON object or a JSON array on argv or stdin
        raw = " ".join(args[1:]) if len(args) > 1 else sys.stdin.read()
        payload = json.loads(raw)
        rows = payload if isinstance(payload, list) else [payload]
        for f in rows:
            cols = ("cve status provider qids host_count qualys_score last_seen "
                    "sample_hosts cvss cvss_severity epss epss_pct kev kev_added "
                    "kev_due ransomware priority rationale description").split()
            vals = [f.get(k) for k in cols]
            ph = ",".join("?" * len(cols))
            sets = ",".join(f"{k}=excluded.{k}" for k in cols if k != "cve")
            c.execute(
                f"INSERT INTO findings({','.join(cols)},first_seen,updated) "
                f"VALUES({ph},?,?) ON CONFLICT(cve) DO UPDATE SET {sets}, updated=excluded.updated",
                vals + [now(), now()])
        c.commit()
        print(f"upserted {len(rows)} findings")

    elif cmd == "note":
        # Record that a finding has been handed to somebody. Until now nothing
        # could write remediation_note, while `findings --stale-days` used
        # "remediation_note IS NULL" to decide what counts as un-actioned - so
        # a CVE with a ticket open against it was reported as ignored forever.
        #
        # Deliberately NOT part of the `finding` upsert: that runs every night
        # from enrich.py and would overwrite the note with null on each pass.
        # The column is excluded from its SET list for the same reason.
        cve = args[0]
        text = " ".join(args[1:]) if len(args) > 1 else ""
        cur = c.execute("UPDATE findings SET remediation_note=?, updated=? "
                        "WHERE cve=?", (text or None, now(), cve))
        c.commit()
        if cur.rowcount == 0:
            # Not an error: cti-jira can file a ticket for a CVE the findings
            # table has not seen yet, and failing here would make a ticket
            # look unfiled.
            print(f"no finding for {cve} - note not recorded")
            return 0
        print(f"noted {cve}: {text or '(cleared)'}")

    elif cmd == "findings":
        q = "SELECT * FROM findings WHERE 1=1"
        p = []
        if "--priority" in args:
            q += " AND priority=?"
            p.append(args[args.index("--priority") + 1])
        if "--stale-days" in args:
            # datetime(updated), not updated.
            #
            # `updated` is stored as ISO-8601 with a T separator and a +00:00
            # offset; datetime('now', ...) yields "YYYY-MM-DD HH:MM:SS". A raw
            # string comparison therefore sorts the stored form ABOVE sqlite's
            # whenever the date portion matches, because 'T' (84) > ' ' (32).
            #
            # The effect is a consistent off-by-up-to-one-day understatement:
            # a row timestamped on the same calendar day as the cutoff is never
            # counted as stale, so --stale-days 1 misses everything from
            # yesterday. It is not a total failure, which is exactly why it
            # survived - a differing date portion hides it most of the time.
            q += " AND remediation_note IS NULL AND datetime(updated) < datetime('now', ?)"
            p.append(f"-{args[args.index('--stale-days') + 1]} days")
        q += " ORDER BY priority, host_count DESC"
        print(json.dumps([dict(r) for r in c.execute(q, p)], indent=2))

    elif cmd == "sent":
        # kind is args[7], NOT args[6]. args[6] is the message id, and reading
        # kind from the same index stored the Graph request id as the kind on
        # every row - so `was-sent <day> daily` never matched, the duplicate
        # guard in run-digest never fired, and UNIQUE(kind,day) never
        # collided because each request id was unique. Silent since the table
        # was written; found by the orchestrator noticing that was-sent said
        # "no" for digests the board confirmed had gone out.
        day, s5, s4, s3, s2, s1, mid = args[0], *map(int, args[1:6]), args[6]
        kind = args[7] if len(args) > 7 else "daily"
        c.execute("INSERT OR REPLACE INTO digests(kind,day,sev5,sev4,sev3,sev2,sev1,"
                  "message_id,ts) VALUES(?,?,?,?,?,?,?,?,?)",
                  (kind, day, s5, s4, s3, s2, s1, mid, now()))
        c.commit()
        print("logged")

    elif cmd == "was-sent":
        day, kind = args[0], (args[1] if len(args) > 1 else "daily")
        hit = c.execute("SELECT 1 FROM digests WHERE day=? AND kind=?", (day, kind)).fetchone()
        print("yes" if hit else "no")
        return 0 if hit else 1

    elif cmd == "vacuum":
        c.execute("VACUUM")
        print("vacuumed")

    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
