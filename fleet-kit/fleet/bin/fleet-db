#!/usr/bin/python3 -sE
"""fleet-db - SQLite memory for the CTI fleet.

  fleet-db init                       create schema (idempotent)
  fleet-db remember <cat> <topic> <content>
  fleet-db recent [n]                 recent memories, open tasks, unacked mail
  fleet-db task add <title> | done <id> | list
  fleet-db mail send <agent> <kind> <body> | inbox <agent> | ack <id>
  fleet-db finding upsert <json>      persist an enriched finding
  fleet-db findings [--cve CVE-ID] [--priority Sev5] [--status UNKNOWN] [--stale-days N]
  fleet-db sent <date> <s5> <s4> <s3> <s2> <s1> <message_id>
  fleet-db note <cve> <text>          record who is handling a finding
  fleet-db was-sent <date> <kind>     exit 0 if a digest already went out
  fleet-db last-sent <kind> [--hours] when the newest digest of a kind went out, or
                                      how many whole hours ago, rounded up (exit 1: never)
  fleet-db vacuum

Every command that writes checks its arguments first (see "WHAT IS CHECKED"
below) and refuses with "fleet-db: <reason>" and exit 2, before it writes any
row. Reads are unchanged. `finding upsert` exits 3 when it skipped a row (the
valid rows are written).
"""
import json
import math
import os
import re
import sqlite3
import sys
from datetime import date, datetime, timezone

FLEET_HOME = os.environ.get("FLEET_HOME", os.path.expanduser("~/fleet"))
DB = os.path.join(FLEET_HOME, "state", "memory.db")

# ---- WHAT IS CHECKED ------------------------------------------------------
#
# This database is written from several places: the heartbeat (a model, whose
# arguments checkin-bash-guard already restricts), the enrich and digest lanes,
# cti-jira, and an operator. The guard protects only the first path, so the
# command itself refuses what no caller should send: a number that is not a
# number, a date that is not a date, text with control characters or far past
# the size anything here stores. The names, counts and lengths below mirror the
# guard's (a test fails if they drift). The guard is stricter on one thing: it
# allows printable ASCII only, where this accepts any text without control
# characters, so a lane or an operator can store a non-English supplier name.
#
# A batch (`finding upsert`) is not all-or-nothing: a row that fails is skipped
# and named on stderr, the rest are written, so one bad value cannot stop the
# nightly upsert.

MAX_MEMORY_CONTENT = 1500   # mirrors checkin-bash-guard
MAX_MAIL_BODY = 400         # mirrors checkin-bash-guard (MAX_BOARD_MESSAGE)
MAX_TASK_TITLE = 200
MAX_NOTE = 1000
MAX_COUNT = 10_000_000

ID_RX = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,31}\Z")
NUM_ID_RX = re.compile(r"[0-9]{1,9}\Z")
CATEGORY_RX = re.compile(r"[a-z][a-z0-9_]{0,31}\Z")
TOPIC_RX = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:-]{0,63}\Z")
CVE_RX = re.compile(r"CVE-[0-9]{4}-[0-9]{4,19}\Z")
KIND_RX = re.compile(r"[a-z]{1,20}\Z")
CTRL_RX = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")   # tab and newline are allowed
SEV_VALUES = ("Sev5", "Sev4", "Sev3", "Sev2", "Sev1")


class Invalid(ValueError):
    """An argument the command refuses to write."""


def _short(v):
    v = str(v)
    v = CTRL_RX.sub("?", v)
    return v if len(v) <= 40 else v[:40] + "..."


def v_text(name, v, limit):
    if not isinstance(v, str) or not v.strip():
        raise Invalid(f"{name} is empty")
    if len(v) > limit:
        raise Invalid(f"{name} is too long ({len(v)} characters, at most {limit})")
    if CTRL_RX.search(v):
        raise Invalid(f"{name} has control characters")
    return v


def v_match(name, v, rx, what):
    if not isinstance(v, str) or not rx.match(v):
        raise Invalid(f"{name} {_short(v)!r} is not {what}")
    return v


def v_num_id(name, v):
    v_match(name, v, NUM_ID_RX, "a row number")
    n = int(v)
    if n < 1:
        raise Invalid(f"{name} {v} is not a row number")
    return n


def v_count(name, v):
    try:
        n = int(v)
    except (TypeError, ValueError):
        raise Invalid(f"{name} {_short(v)!r} is not a whole number") from None
    if not 0 <= n <= MAX_COUNT:
        raise Invalid(f"{name} {n} is outside 0 to {MAX_COUNT}")
    return n


def v_day(name, v):
    v_match(name, v, re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}\Z"), "a date (YYYY-MM-DD)")
    try:
        datetime.strptime(v, "%Y-%m-%d")
    except ValueError:
        raise Invalid(f"{name} {v} is not a real date") from None
    return v


# findings columns: the longest text each may hold, and numeric ranges.
FINDING_TEXT = {"status": 80, "provider": 80, "qids": 5000, "last_seen": 100, "sample_hosts": 20000,
                "cvss_severity": 40, "kev_added": 100, "kev_due": 100, "ransomware": 100,
                "rationale": 2000, "description": 20000}
FINDING_RANGE = {"host_count": (0, MAX_COUNT), "qualys_score": (0, MAX_COUNT), "cvss": (0, 10),
                 "epss": (0, 1), "epss_pct": (0, 100)}


def validate_finding(f):
    """One enriched finding, or Invalid. Unknown keys are ignored (as the
    upsert always has); a known column must hold what it says it holds."""
    if not isinstance(f, dict):
        raise Invalid("a finding is a JSON object")
    f = dict(f)
    v_match("cve", f.get("cve"), CVE_RX, "a CVE id")
    for k, limit in FINDING_TEXT.items():
        v = f.get(k)
        if v is None:
            continue
        if isinstance(v, bool) or not isinstance(v, (str, int, float)):
            raise Invalid(f"{k} must be text")
        if len(str(v)) > limit:
            raise Invalid(f"{k} is too long ({len(str(v))} characters, at most {limit})")
        # Text from an advisory or a feed may carry a stray control character
        # (a carriage return from an external CNA is common). Losing the whole
        # finding over it would lose its history, so it is replaced, not refused.
        if isinstance(v, str) and CTRL_RX.search(v):
            f[k] = CTRL_RX.sub(" ", v)
    for k, (lo, hi) in FINDING_RANGE.items():
        v = f.get(k)
        if v is None or v == "":
            continue
        if isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(v):
            raise Invalid(f"{k} must be a number")
        if not lo <= v <= hi:
            raise Invalid(f"{k} {v} is outside {lo} to {hi}")
    if f.get("kev") not in (None, 0, 1, True, False):
        raise Invalid("kev must be 0 or 1")
    if f.get("priority") is not None and f.get("priority") not in SEV_VALUES:
        raise Invalid(f"priority {_short(f.get('priority'))!r} is not one of {', '.join(SEV_VALUES)}")
    return f


# Renaming the scale is a data migration, not just a label change: rows
# already written say P1-P4, and the digests table had four count columns.
# Applied on every connect, cheap and idempotent - a fleet that upgrades and
# then silently reports zero findings because the values no longer match is
# worse than one that refuses to start.
MIGRATIONS = [
    # digests: p1..p4 -> sev5..sev1. Old rows keep their numbers under the new
    # names in urgency order; the split band starts empty rather than guessing.
    ("digests", "sev5", [
        "ALTER TABLE digests ADD COLUMN sev5 INTEGER",
        "ALTER TABLE digests ADD COLUMN sev4 INTEGER",
        "ALTER TABLE digests ADD COLUMN sev3 INTEGER",
        "ALTER TABLE digests ADD COLUMN sev2 INTEGER",
        "ALTER TABLE digests ADD COLUMN sev1 INTEGER",
        "UPDATE digests SET sev5=p1, sev4=p2, sev3=0, sev2=p3, sev1=p4 "
        "WHERE sev5 IS NULL",
    ]),
]

# findings.priority values, old -> new. P2 mapped to Sev4 rather than Sev3
# because the old band was mostly confirmed-present; anything that should be
# Sev3 gets there on the next enrich pass, which recomputes every row anyway.
PRIORITY_MAP = {"P1": "Sev5", "P2": "Sev4", "P3": "Sev2", "P4": "Sev1"}

SCHEMA = """
CREATE TABLE IF NOT EXISTS memories (
  id INTEGER PRIMARY KEY, category TEXT NOT NULL, topic TEXT,
  content TEXT NOT NULL, ts TEXT NOT NULL);
CREATE INDEX IF NOT EXISTS ix_mem_cat ON memories(category, ts);

CREATE TABLE IF NOT EXISTS tasks (
  id INTEGER PRIMARY KEY, title TEXT NOT NULL,
  done INTEGER NOT NULL DEFAULT 0, ts TEXT NOT NULL, done_ts TEXT);

CREATE TABLE IF NOT EXISTS mailbox (
  id INTEGER PRIMARY KEY, to_agent TEXT NOT NULL, kind TEXT NOT NULL,
  body TEXT NOT NULL, acked INTEGER NOT NULL DEFAULT 0, ts TEXT NOT NULL);
CREATE INDEX IF NOT EXISTS ix_mail_agent ON mailbox(to_agent, acked);

-- One row per CVE we have ever seen. first_seen never changes; everything
-- else is refreshed on each enrich pass.
CREATE TABLE IF NOT EXISTS findings (
  cve TEXT PRIMARY KEY, status TEXT, provider TEXT, qids TEXT,
  host_count INTEGER DEFAULT 0, qualys_score INTEGER DEFAULT 0,
  last_seen TEXT, sample_hosts TEXT,
  cvss REAL, cvss_severity TEXT, epss REAL, epss_pct REAL,
  kev INTEGER DEFAULT 0, kev_added TEXT, kev_due TEXT, ransomware TEXT,
  priority TEXT, rationale TEXT, description TEXT,
  first_seen TEXT, updated TEXT, remediation_note TEXT);
CREATE INDEX IF NOT EXISTS ix_find_pri ON findings(priority, updated);

CREATE TABLE IF NOT EXISTS scout_items (
  id INTEGER PRIMARY KEY, cve TEXT, feed TEXT, title TEXT, link TEXT,
  published TEXT, correlated INTEGER DEFAULT 0, ts TEXT NOT NULL,
  UNIQUE(cve, feed));

CREATE TABLE IF NOT EXISTS digests (
  id INTEGER PRIMARY KEY, kind TEXT NOT NULL, day TEXT NOT NULL,
  sev5 INTEGER, sev4 INTEGER, sev3 INTEGER, sev2 INTEGER, sev1 INTEGER,
  message_id TEXT, ts TEXT NOT NULL, UNIQUE(kind, day));
"""


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def conn():
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    c = sqlite3.connect(DB)
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA journal_mode=WAL")   # concurrent lanes reading while one writes
    c.execute("PRAGMA busy_timeout=5000")
    return c


def migrate(c):
    """Apply the Sev rename to an existing database.

    Runs on every call, after the schema. Each step is guarded by whether the
    target column already exists, so it is idempotent and costs one PRAGMA.

    Done in code rather than by hand because the alternative is a fleet that
    upgrades, finds no rows matching the new severity values, and reports a
    clean estate - the most dangerous wrong answer this system can give.
    """
    for table, marker, steps in MIGRATIONS:
        cols = {r[1] for r in c.execute(f"PRAGMA table_info({table})")}
        if not cols or marker in cols:
            continue          # table absent, or already migrated
        for stmt in steps:
            try:
                c.execute(stmt)
            except Exception as e:                              # noqa: BLE001
                print(f"migrate: {table}: {stmt.split()[0]} failed: {e}",
                      file=sys.stderr)
        print(f"migrate: {table} -> Sev5..Sev1", file=sys.stderr)

    # findings.priority values.
    cols = {r[1] for r in c.execute("PRAGMA table_info(findings)")}
    if "priority" in cols:
        n = 0
        for old, new in PRIORITY_MAP.items():
            cur = c.execute("UPDATE findings SET priority=? WHERE priority=?",
                            (new, old))
            n += cur.rowcount or 0
        if n:
            print(f"migrate: remapped {n} finding(s) from P1-P4 to Sev5-Sev1",
                  file=sys.stderr)
    c.commit()


def main(argv):
    try:
        return _main(argv)
    except Invalid as e:
        # Before anything was written: say what was refused and why.
        print(f"fleet-db: {e}", file=sys.stderr)
        return 2


def _main(argv):
    if not argv:
        print(__doc__)
        return 2
    cmd, args = argv[0], argv[1:]
    c = conn()

    if cmd == "init":
        c.executescript(SCHEMA)
        c.commit()
        migrate(c)
        print(f"initialized {DB}")
        return 0

    c.executescript(SCHEMA)  # cheap, keeps schema current on every call
    c.commit()
    migrate(c)

    if cmd == "remember":
        if len(args) < 3:
            raise Invalid("remember takes a category, a topic and the text")
        cat = v_match("category", args[0], CATEGORY_RX, "a category (lowercase letters, digits, underscore)")
        topic = v_match("topic", args[1], TOPIC_RX, "a topic")
        content = v_text("the text", " ".join(args[2:]), MAX_MEMORY_CONTENT)
        c.execute("INSERT INTO memories(category,topic,content,ts) VALUES(?,?,?,?)",
                  (cat, topic, content, now()))
        c.commit()
        print("ok")

    elif cmd == "recent":
        n = int(args[0]) if args else 20
        print("== recent memories ==")
        for r in c.execute("SELECT ts,category,topic,content FROM memories "
                           "ORDER BY id DESC LIMIT ?", (n,)):
            print(f"{r['ts']}  [{r['category']}] {r['topic']}: {r['content'][:160]}")
        print("\n== open tasks ==")
        for r in c.execute("SELECT id,title,ts FROM tasks WHERE done=0 ORDER BY id"):
            print(f"#{r['id']} {r['title']}  (since {r['ts']})")
        print("\n== unacked mailbox ==")
        for r in c.execute("SELECT id,to_agent,kind,body FROM mailbox WHERE acked=0"):
            print(f"#{r['id']} -> {r['to_agent']} [{r['kind']}] {r['body'][:120]}")
        print("\n== priority counts ==")
        for r in c.execute("SELECT priority,COUNT(*) n FROM findings "
                           "GROUP BY priority ORDER BY priority"):
            print(f"{r['priority'] or 'unscored'}: {r['n']}")

    elif cmd == "task":
        sub = args[0]
        if sub == "add":
            title = v_text("the title", " ".join(args[1:]), MAX_TASK_TITLE)
            c.execute("INSERT INTO tasks(title,done,ts) VALUES(?,0,?)", (title, now()))
        elif sub == "done":
            if len(args) != 2:
                raise Invalid("task done takes one row number")
            c.execute("UPDATE tasks SET done=1, done_ts=? WHERE id=?", (now(), v_num_id("the task id", args[1])))
        elif sub == "list":
            for r in c.execute("SELECT id,title,done FROM tasks ORDER BY done,id"):
                print(f"[{'x' if r['done'] else ' '}] #{r['id']} {r['title']}")
        c.commit()

    elif cmd == "mail":
        sub = args[0]
        if sub == "send":
            if len(args) < 4:
                raise Invalid("mail send takes an agent, a kind and the body")
            agent = v_match("agent", args[1], ID_RX, "an agent name")
            kind = v_match("kind", args[2], ID_RX, "a message kind")
            body = v_text("the body", " ".join(args[3:]), MAX_MAIL_BODY)
            c.execute("INSERT INTO mailbox(to_agent,kind,body,acked,ts) VALUES(?,?,?,0,?)",
                      (agent, kind, body, now()))
        elif sub == "inbox":
            for r in c.execute("SELECT id,kind,body,ts FROM mailbox "
                               "WHERE to_agent=? AND acked=0 ORDER BY id", (args[1],)):
                print(f"#{r['id']} [{r['kind']}] {r['body']}  ({r['ts']})")
        elif sub == "ack":
            if len(args) != 2:
                raise Invalid("mail ack takes one row number")
            c.execute("UPDATE mailbox SET acked=1 WHERE id=?", (v_num_id("the mail id", args[1]),))
        c.commit()

    elif cmd == "ack":
        if len(args) != 1:
            raise Invalid("ack takes one row number")
        c.execute("UPDATE mailbox SET acked=1 WHERE id=?", (v_num_id("the mail id", args[0]),))
        c.commit()

    elif cmd == "finding":
        # upsert from a JSON object or a JSON array on argv or stdin
        raw = " ".join(args[1:]) if len(args) > 1 else sys.stdin.read()
        try:
            payload = json.loads(raw)
        except ValueError:
            raise Invalid("finding upsert takes a JSON object or array") from None
        rows = payload if isinstance(payload, list) else [payload]
        # A batch is not all-or-nothing: a row that fails is skipped and
        # named, so one bad value cannot stop the nightly upsert.
        good, skipped = [], 0
        for i, f in enumerate(rows):
            try:
                good.append(validate_finding(f))
            except Invalid as e:
                skipped += 1
                print(f"fleet-db: finding {i + 1} skipped: {e}", file=sys.stderr)
        rows = good
        for f in rows:
            cols = ("cve status provider qids host_count qualys_score last_seen "
                    "sample_hosts cvss cvss_severity epss epss_pct kev kev_added "
                    "kev_due ransomware priority rationale description").split()
            vals = [f.get(k) for k in cols]
            ph = ",".join("?" * len(cols))
            sets = ",".join(f"{k}=excluded.{k}" for k in cols if k != "cve")
            # cols is the fixed list above; every value goes through a ? bind.
            # The two "nosec B608" below are kept on purpose. Some bandit
            # versions flag these f-strings as SQL injection and some do not;
            # where it does not, bandit logs "nosec encountered, but no failed
            # test" - expected, harmless, and cheaper than a failed build.
            names = ",".join(cols)
            upsert = f"ON CONFLICT(cve) DO UPDATE SET {sets}, updated=excluded.updated"  # nosec B608
            sql = f"INSERT INTO findings({names},first_seen,updated) VALUES({ph},?,?) {upsert}"  # nosec B608
            c.execute(sql, vals + [now(), now()])
        c.commit()
        print(f"upserted {len(rows)} findings" + (f" ({skipped} skipped, see above)" if skipped else ""))
        # Exit 3 when any row was skipped, so a caller can tell a clean upsert
        # from one that lost rows. The rows that were valid ARE written.
        if skipped:
            return 3

    elif cmd == "note":
        # Record that a finding has been handed to somebody. Until now nothing
        # could write remediation_note, while `findings --stale-days` used
        # "remediation_note IS NULL" to decide what counts as un-actioned - so
        # a CVE with a ticket open against it was reported as ignored forever.
        #
        # Deliberately NOT part of the `finding` upsert: that runs every night
        # from enrich.py and would overwrite the note with null on each pass.
        # The column is excluded from its SET list for the same reason.
        if not args:
            raise Invalid("note takes a CVE id and the text")
        cve = v_match("cve", args[0], CVE_RX, "a CVE id")
        text = " ".join(args[1:]) if len(args) > 1 else ""
        if text:  # empty clears the note
            v_text("the note", text, MAX_NOTE)
        cur = c.execute("UPDATE findings SET remediation_note=?, updated=? "
                        "WHERE cve=?", (text or None, now(), cve))
        c.commit()
        if cur.rowcount == 0:
            # Not an error: cti-jira can file a ticket for a CVE the findings
            # table has not seen yet, and failing here would make a ticket
            # look unfiled.
            print(f"no finding for {cve} - note not recorded")
            return 0
        print(f"noted {cve}: {text or '(cleared)'}")

    elif cmd == "findings":
        q = "SELECT * FROM findings WHERE 1=1"
        p = []
        if "--cve" in args:
            # One CVE: a beat checking a CVE it read about asked for it as a
            # positional argument and was refused (2026-11-12).
            q += " AND cve=?"
            p.append(args[args.index("--cve") + 1].upper())
        if "--priority" in args:
            q += " AND priority=?"
            p.append(args[args.index("--priority") + 1])
        if "--status" in args:
            # The flag was accepted and ignored: a beat asking for UNKNOWN
            # findings got every finding and believed it had filtered.
            q += " AND status=?"
            p.append(args[args.index("--status") + 1])
        if "--stale-days" in args:
            # datetime(updated), not updated.
            #
            # `updated` is stored as ISO-8601 with a T separator and a +00:00
            # offset; datetime('now', ...) yields "YYYY-MM-DD HH:MM:SS". A raw
            # string comparison therefore sorts the stored form ABOVE sqlite's
            # whenever the date portion matches, because 'T' (84) > ' ' (32).
            #
            # The effect is a consistent off-by-up-to-one-day understatement:
            # a row timestamped on the same calendar day as the cutoff is never
            # counted as stale, so --stale-days 1 misses everything from
            # yesterday. It is not a total failure, which is exactly why it
            # survived - a differing date portion hides it most of the time.
            q += " AND remediation_note IS NULL AND datetime(updated) < datetime('now', ?)"
            p.append(f"-{args[args.index('--stale-days') + 1]} days")
        q += " ORDER BY priority, host_count DESC"
        print(json.dumps([dict(r) for r in c.execute(q, p)], indent=2))

    elif cmd == "rollup":
        # Emit an enriched-shaped JSON covering a window, built from STORED
        # findings rather than from a fresh mailbox read.
        #
        # WHY THE WEEKLY NEEDED THIS
        #
        # cti-agent-weekly.service ran `run-digest weekly` with no --lookback,
        # so the weekly read GRAPH_LOOKBACK_HOURS - the same 24 hours as the
        # daily. Its window really was one day; it had never been a week. Both
        # briefs on 2026-10-05 reported reading the same four emails.
        #
        # Widening the mailbox read to 168h does not fix it either: the cleanup
        # lane archives advisories once a completed run has read them, on a
        # 48-hour grace, so a 7-day mailbox query would still only see what
        # happened not to be archived yet. That is a partial week presented as
        # a whole one - a silently wrong number, which is worse than the honest
        # 24-hour one.
        #
        # Stored findings have neither problem. They are what the fleet
        # actually concluded, they outlive the mail they came from, and a
        # rollup of them is immune to the archive grace entirely.
        days = int(args[args.index("--days") + 1]) if "--days" in args else 7
        cutoff = f"-{days} days"

        # Anything seen OR re-confirmed in the window. A CVE first seen three
        # weeks ago that is still PRESENT today is part of this week's picture;
        # one that nothing has touched since is not.
        rows = [dict(r) for r in c.execute(
            "SELECT * FROM findings WHERE datetime(updated) >= datetime('now', ?) "
            "   OR datetime(first_seen) >= datetime('now', ?) "
            "ORDER BY priority, host_count DESC", (cutoff, cutoff))]

        # is_new distinguishes "appeared this window" from "still open from
        # before". The daily sets this from the ingest; here it comes from
        # first_seen, which is the same question asked of stored data.
        first_cut = c.execute("SELECT datetime('now', ?)", (cutoff,)).fetchone()[0]
        for r in rows:
            fs = (r.get("first_seen") or "").replace("T", " ")[:19]
            r["is_new"] = bool(fs and fs >= first_cut)

        # Every band present, zero or not, the same shape enrich.py writes.
        # It used to hold only the bands that had findings, so a week with no
        # Sev5 had no "Sev5" key and run-digest's log step died with KeyError
        # AFTER the weekly had been sent - which left the send unrecorded, and
        # a re-run of the failed unit would have mailed it again.
        counts = {b: 0 for b in ("Sev5", "Sev4", "Sev3", "Sev2", "Sev1")}
        for r in rows:
            k = r.get("priority") or "unscored"
            counts[k] = counts.get(k, 0) + 1

        # Deadlines, computed the same way the daily reports them
        # (enrich.kev_summary, and cti-kev): only CVEs the scanner found here,
        # PRESENT on at least one host. This loop once counted every stored
        # row with a passed date, CVEs not in the estate included, so the
        # weekly said "9 KEV deadlines OVERDUE" on weeks cti-kev said none
        # (2026-11-04 and 11-09), and the check-in could not tell which was
        # right. A deadline on a CVE we do not run is not an obligation.
        today = datetime.now(timezone.utc).date()
        overdue, worst, soon, ransomware, overdue_cves = 0, 0, 0, 0, []
        for r in rows:
            if r.get("status") != "PRESENT" or (r.get("host_count") or 0) <= 0:
                continue
            due = (r.get("kev_due") or "").strip()[:10]
            if not due:
                continue
            try:
                left = (date.fromisoformat(due) - today).days
            except ValueError:
                continue
            if str(r.get("ransomware") or "").lower() == "known":
                ransomware += 1
            if left < 0:
                overdue += 1
                worst = max(worst, -left)
                overdue_cves.append(r["cve"])
            elif left <= 14:
                soon += 1

        out = {
            "generated": now(),
            # No "mailbox", "emails" or "with_cves": this run did not read a
            # mailbox, and reporting zero for those would read as "the mailbox
            # was empty" rather than "we did not look".
            "source_meta": {
                "rollup": f"{days} days of stored findings - no mailbox read this run",
                "provider": "stored",
            },
            "counts": counts,
            "total": len(rows),
            "degraded": [],
            "kev_deadlines": {"overdue": overdue, "due_within_14d": soon,
                              "worst_overdue_days": worst,
                              "ransomware_present": ransomware,
                              "overdue_cves": overdue_cves},
            # Omitted deliberately, not set to []: brief.py drops the
            # "emails read this run" section when it is absent.
            "findings": rows,
        }
        print(json.dumps(out, indent=2))

    elif cmd == "sent":
        # kind is args[7], NOT args[6]. args[6] is the message id, and reading
        # kind from the same index stored the Graph request id as the kind on
        # every row - so `was-sent <day> daily` never matched, the duplicate
        # guard in run-digest never fired, and UNIQUE(kind,day) never
        # collided because each request id was unique. Silent since the table
        # was written; found by the orchestrator noticing that was-sent said
        # "no" for digests the board confirmed had gone out.
        if len(args) < 7:
            raise Invalid("sent takes a date, five counts and a message id")
        day = v_day("date", args[0])
        s5, s4, s3, s2, s1 = (v_count(n, a) for n, a in zip(("sev5", "sev4", "sev3", "sev2", "sev1"), args[1:6]))
        mid = v_text("message id", args[6] if args[6].strip() else "unknown", 512)
        kind = v_match("kind", args[7] if len(args) > 7 else "daily", KIND_RX, "a digest kind (lowercase letters)")
        c.execute("INSERT OR REPLACE INTO digests(kind,day,sev5,sev4,sev3,sev2,sev1,"
                  "message_id,ts) VALUES(?,?,?,?,?,?,?,?,?)",
                  (kind, day, s5, s4, s3, s2, s1, mid, now()))
        c.commit()
        print("logged")

    elif cmd == "was-sent":
        day, kind = args[0], (args[1] if len(args) > 1 else "daily")
        hit = c.execute("SELECT 1 FROM digests WHERE day=? AND kind=?", (day, kind)).fetchone()
        print("yes" if hit else "no")
        return 0 if hit else 1

    elif cmd == "last-sent":
        # run-digest reads back to here, so a day the daily failed is read by
        # the next run instead of never. ts is written by `sent`, after the
        # send, so it is the time of a COMPLETED digest.
        rest = [a for a in args if a != "--hours"]
        kind = rest[0] if rest else "daily"
        row = c.execute("SELECT ts FROM digests WHERE kind=? ORDER BY datetime(ts) DESC LIMIT 1",
                        (kind,)).fetchone()
        if not row or not row[0]:
            return 1
        if "--hours" not in args:
            print(row[0])
            return 0
        try:
            t = datetime.fromisoformat(row[0].replace("Z", "+00:00"))
        except ValueError:
            return 1
        if t.tzinfo is None:
            t = t.replace(tzinfo=timezone.utc)
        secs = (datetime.now(timezone.utc) - t).total_seconds()
        print(max(0, -(-int(secs) // 3600)))  # whole hours, rounded up
        return 0

    elif cmd == "vacuum":
        c.execute("VACUUM")
        print("vacuumed")

    else:
        print(__doc__)
        return 2
    return 0


def beat_main(argv):
    """Inside a heartbeat (CHECKIN_BEAT_ID, set by run-checkin) everything this
    prints is cleaned before the model reads it: memories, findings and mail
    hold text from advisories and feeds (Scenario-222). The output is captured,
    passed through cti-sanitize and written; if that cannot run the beat gets
    nothing. Outside a beat main() runs as it always did, so the lanes that
    parse this output are untouched."""
    import io
    import subprocess
    san = os.path.join(os.path.dirname(os.path.abspath(__file__)), "cti-sanitize")
    if not os.access(san, os.X_OK):
        print("fleet-db: cti-sanitize is missing", file=sys.stderr)
        return 2
    real, buf = sys.stdout, io.StringIO()
    sys.stdout = buf
    try:
        code = main(argv)
    finally:
        sys.stdout = real
    # Bandit B603 is suppressed on the next line: the root-owned cti-sanitize
    # binary beside this file, fixed arguments, no shell - nothing a caller
    # chooses. (Bandit reads every word after its marker
    # as a test id, so the reason lives here, not after it.)
    r = subprocess.run([san, "--source", "fleet-db"],  # nosec B603
                       input=buf.getvalue().encode("utf-8", "replace"),
                       capture_output=True, check=False)
    if r.returncode != 0:
        print("fleet-db: could not clean the output", file=sys.stderr)
        return 2
    sys.stdout.write(r.stdout.decode("utf-8", "replace"))
    sys.stdout.flush()
    return code


if __name__ == "__main__":
    if os.environ.get("CHECKIN_BEAT_ID"):
        sys.exit(beat_main(sys.argv[1:]))
    sys.exit(main(sys.argv[1:]))
