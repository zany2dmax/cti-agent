#!/usr/bin/env bash
#
# run-vmscan - the weekly Qualys VM scan report, the scheduled scans combined
# into one email.
#
# Reads the "Qualys: Scan Results" notices that arrived in the CTI mailbox over
# the last week, takes the newest result of every scheduled scan, renders one
# report with the scans kept separate, and mails it through cti-mailer --lane
# vmscan. An active Qualys scan schedule that launched nothing this week, or a
# week with no scan at all, is the first thing the report says.
#
# Recipients are VMSCAN_TO, checked against VMSCAN_ALLOW_TO, which has no
# fallback: unset means the mailer refuses. Set VMSCAN_ALLOW_TO=$VM_ALLOW_TO to
# reuse the VM audience. See cti-mailer(1).
#
# USAGE (one of the three is required; with none it prints usage and exits 2)
#   run-vmscan --for-real   render, send, and record the notices as used
#   run-vmscan --dry-run    render, print the subject, send nothing
#   run-vmscan --to-dev     test send: FLEET_DEV_EMAIL only, [DEV TEST] subject
#
# THE SPREADSHEET TICKET
#
# The rows of the network spreadsheet the coverage check cannot read go to the
# help desk as ONE Jira ticket, unassigned, for the network team (cti-jira
# --vmscan-fixes; cti-vmscan --fixes-out writes the list). A real run files it,
# or comments on the open one only when the list changed; a dry run and a test
# send only preview it. Written to Jira only when its project
# (JIRA_VMSCAN_PROJECT_KEY, else JIRA_PROJECT_KEY) is in JIRA_ALLOW_CREATE, and
# never fatal: the report goes out whatever Jira does.
#
# The report names the ticket. It is rendered with a slot (--ticket-slot),
# cti-jira says what happened to the ticket (--ref-out), and cti-vmscan
# --stamp-ticket fills the slot with its key, status and link before the send:
# "filed HD-12", "HD-12 already has this exact list", "NOT updated - why".
set -euo pipefail
# shellcheck source=../share/fleet-mode.sh
. "$(dirname "${BASH_SOURCE[0]}")/../share/fleet-mode.sh"

# Sourced here AND loaded by the binary, as every runner does: the `sudo
# cti-agent` wrapper passes only the layout variables, so the credentials can
# only arrive through fleet.env.
FLEET_HOME="${FLEET_HOME:-$HOME}"
FLEET_ENV="${FLEET_ENV:-$FLEET_HOME/fleet.env}"
_inj_home="${FLEET_HOME:-}"; _inj_code="${FLEET_CODE:-}"
set -a
# shellcheck source=/dev/null
[ -f "$FLEET_ENV" ] && . "$FLEET_ENV"
# The per-lane settings files (step 3, RUNBOOK 11o): core, then this lane's.
for _f in ${FLEET_ENV_FILES:-}; do
  # shellcheck source=/dev/null
  if [ -f "$_f" ]; then . "$_f"; fi
done
set +a
# Secrets systemd provided as credentials: drop the environment copy (fleet-mode.sh).
fleet_secrets_from_credentials
[ -n "$_inj_home" ] && FLEET_HOME="$_inj_home"
[ -n "$_inj_code" ] && FLEET_CODE="$_inj_code"
FLEET_CODE="${FLEET_CODE:-$FLEET_HOME}"
export FLEET_HOME FLEET_CODE
STATE="$FLEET_HOME/state"

fail() { echo "[run-vmscan] error: $*" >&2; exit 1; }
log()  { echo "[run-vmscan] $*" >&2; }

DRY=""
REAL=""
TODEV=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)  DRY="--dry-run" ;;
    --for-real) REAL=1 ;;
    --to-dev)   TODEV=1 ;;
    *)          fail "unknown argument: $1 (only --dry-run, --for-real and --to-dev are accepted)" ;;
  esac
  shift
done
fleet_require_mode run-vmscan "$DRY" "$REAL" "$TODEV" allow-dev
if [ -n "$TODEV" ] && [ -z "${FLEET_DEV_EMAIL:-}" ]; then
  fail "--to-dev needs FLEET_DEV_EMAIL set in $FLEET_ENV"
fi

VMSCAN="$FLEET_CODE/bin/cti-vmscan"
MAILER="$FLEET_CODE/bin/cti-mailer"
JIRA="$FLEET_CODE/bin/cti-jira"
[ -x "$VMSCAN" ] || fail "cti-vmscan not found at $VMSCAN - rerun the installer"
[ -x "$MAILER" ] || fail "cti-mailer not found at $MAILER - rerun the installer"

mkdir -p "$STATE"
chmod 0700 "$STATE" 2>/dev/null || true

# One run of this lane at a time; a dry run or test send refuses while a run
# is active instead of waiting (see fleet_lock in fleet-mode.sh).
if [ -n "$REAL" ]; then
  fleet_lock vmscan real || fail "another run of run-vmscan is still going - this one did not start"
else
  fleet_lock vmscan dry
fi

# A DRY RUN OR TEST SEND HAS ITS OWN FILES, under $FLEET_HOME/dryrun/vmscan/.
# Every file below used to be the real run's for the day, and the run begins
# by deleting them: a rehearsal on the timer's day deleted its SEEN list (what
# the mailbox cleanup may archive once the report is out) and replaced its
# report and findings worksheet.
OUTDIR="$STATE"
if [ -z "$REAL" ]; then
  OUTDIR="$(fleet_dryrun_dir vmscan)" || fail "no rehearsal directory - nothing was run"
fi

STAMP="$(date -u +%Y-%m-%d)"
HTML="$OUTDIR/vmscan-$STAMP.html"
TXT="$OUTDIR/vmscan-$STAMP.txt"
SUBJFILE="$OUTDIR/vmscan-subject-$STAMP.txt"
SEEN="$OUTDIR/vmscan-seen-$STAMP.json"
FINDINGS="$OUTDIR/vmscan-findings-$STAMP.csv"
FIXES="$OUTDIR/vmscan-fixes-$STAMP.json"
TICKET="$OUTDIR/vmscan-ticket-$STAMP.json"
# Mode set before anything is written: the report names which scans found what.
: > "$HTML"; chmod 0600 "$HTML"
: > "$TXT";  chmod 0600 "$TXT"
rm -f "$SUBJFILE" "$SEEN" "$FINDINGS" "$FIXES" "$TICKET"

"$VMSCAN" --out "$HTML" --text-out "$TXT" --subject-out "$SUBJFILE" --seen-out "$SEEN" \
  --csv-out "$FINDINGS" --fixes-out "$FIXES" --ticket-slot \
  || fail "cti-vmscan exited non-zero (check outbound 443 to Graph)"
[ -s "$SUBJFILE" ] || fail "cti-vmscan wrote no subject line"
SUBJECT="$(head -n 1 "$SUBJFILE")"
log "subject: $SUBJECT"
# The coverage findings as a worksheet for the network and acquisitions teams,
# attached when there is anything to work through.
ATTACH=()
[ -s "$FINDINGS" ] && ATTACH=(--attach "$FINDINGS")

# The spreadsheet ticket. Every failure is logged and survived.
if [ ! -x "$JIRA" ]; then
  log "cti-jira not installed - no spreadsheet ticket"
elif [ ! -s "$FIXES" ]; then
  log "no spreadsheet fixes list written - no spreadsheet ticket"
elif [ -z "$REAL" ]; then
  log "ticket: rehearsal, previewing the spreadsheet ticket only"
  "$JIRA" --vmscan-fixes "$FIXES" --dry-run --ref-out "$TICKET" \
    || log "WARNING: spreadsheet ticket preview failed"
else
  "$JIRA" --vmscan-fixes "$FIXES" --for-real --ref-out "$TICKET" \
    || log "WARNING: spreadsheet ticket not filed or updated - see the lines above"
fi
# Then its line in the report. A missing ref file (cti-jira died before
# writing it) stamps "status unavailable"; no ticket step at all just clears
# the slot. The report goes out either way.
if [ -x "$JIRA" ] && [ -s "$FIXES" ]; then
  "$VMSCAN" --stamp-ticket "$TICKET" --out "$HTML" --text-out "$TXT" \
    || { log "WARNING: could not stamp the ticket into the report; removing the slot"
         sed -i.bak 's/<!--CTI_VMSCAN_TICKET-->//g' "$HTML" "$TXT" 2>/dev/null || true
         rm -f "$HTML.bak" "$TXT.bak"; }
else
  sed -i.bak 's/<!--CTI_VMSCAN_TICKET-->//g' "$HTML" "$TXT" 2>/dev/null || true
  rm -f "$HTML.bak" "$TXT.bak"
fi
rm -f "$TICKET"

if [ -n "$TODEV" ]; then
  # FLEET_DEV_EMAIL only. VMSCAN_TO / VMSCAN_ALLOW_TO are not consulted, so a
  # test works before the lane's audience is configured.
  # shellcheck disable=SC2086
  "$MAILER" --to-dev --html "$HTML" --text "$TXT" --subject "$SUBJECT" ${ATTACH[@]+"${ATTACH[@]}"} $DRY \
    || fail "test send failed"
else
  # shellcheck disable=SC2086
  "$MAILER" --lane vmscan --html "$HTML" --text "$TXT" --subject "$SUBJECT" ${ATTACH[@]+"${ATTACH[@]}"} "${DRY:---for-real}" \
    || fail "send failed - if VMSCAN_TO or VMSCAN_ALLOW_TO is unset the mailer refuses by design"
  # Sent: the lane has now used these notices, so the mailbox cleanup may
  # archive them 48 hours on. Non-fatal - the report is out, and an unrecorded
  # notice is only left in the inbox.
  if [ -z "$DRY" ] && [ -s "$SEEN" ]; then
    "$VMSCAN" --commit-seen "$SEEN" \
      || log "warn: could not record the notices for the mailbox cleanup; they stay in the inbox"
  fi
fi
rm -f "$SEEN"

if [ -n "$DRY" ]; then
  log "dry run - nothing was sent. The rendered report is at $HTML"
elif [ -n "$TODEV" ]; then
  log "test send - mailed to FLEET_DEV_EMAIL only. The rendered report is at $HTML"
fi
log "done"
