#!/usr/bin/env bash
#
# run-appscan - weekly application-security report to the App Dev audience.
#
# Reads the Qualys WAS scan notifications that arrived in the CTI mailbox over
# the last week, renders a report, and mails it through cti-mailer --lane was.
#
# WHY THIS IS A SEPARATE LANE AND NOT A SECTION OF THE DIGEST
#
#   Different audience. The daily digest goes to the people who patch servers;
#   this goes to the people who own application code. Mixing them means each
#   team skims past most of the mail, and a report people skim is a report that
#   stops being read.
#
#   The recipient split is enforced in code: cti-mailer --lane was resolves
#   WAS_TO against WAS_ALLOW_TO and REFUSES if either is unset. It does not
#   fall back to the digest audience.
#
# USAGE
#   run-appscan              render, file/update one Jira ticket per application, send
#   run-appscan --dry-run    render, print the subject, send nothing
#   run-appscan --to-dev     test send: FLEET_DEV_EMAIL only, [DEV TEST]
#                            subject, auth-failure alert to you too
set -euo pipefail

# THE RUNNER SOURCES fleet.env. The Go binaries do not.
#
# internal/config reads the environment; it does not open the config file.
# Every other runner sources fleet.env before invoking anything, and this one
# did not - so cti-appscan ran with no credentials at all and reported
# "missing required environment variables: CLIENT_ID CLIENT_SECRET
# GRAPH_MAILBOX TENANT_ID" on a box where all four are set.
#
# The error was accurate and pointed at the wrong thing: it reads as a
# fleet.env problem when the file was fine and the runner simply never read
# it. The `sudo cti-agent` wrapper passes FLEET_ENV through
# --preserve-env and strips everything else, so the credentials can ONLY
# arrive this way.
FLEET_HOME="${FLEET_HOME:-$HOME}"
FLEET_ENV="${FLEET_ENV:-$FLEET_HOME/fleet.env}"

# Layout variables belong to whoever launched us - the systemd unit or the
# wrapper - not to fleet.env. `set -a` assigns unconditionally, so a stale
# FLEET_HOME in the config file would silently replace the correct one and
# this lane would write its report under a path it does not own.
_inj_home="${FLEET_HOME:-}"; _inj_code="${FLEET_CODE:-}"
set -a; [ -f "$FLEET_ENV" ] && . "$FLEET_ENV"; set +a
[ -n "$_inj_home" ] && FLEET_HOME="$_inj_home"
[ -n "$_inj_code" ] && FLEET_CODE="$_inj_code"
FLEET_CODE="${FLEET_CODE:-$FLEET_HOME}"
export FLEET_HOME FLEET_CODE
STATE="$FLEET_HOME/state"

fail() { echo "[run-appscan] error: $*" >&2; exit 1; }
log()  { echo "[run-appscan] $*" >&2; }

# An unrecognised argument is an error, not something to ignore.
#
# The unit file for this lane was first generated from the weekly one and
# arrived with a stray "weekly" argument on its ExecStart. A runner that
# shrugs at that runs in the wrong mode and reports success - and the service
# file looks correct to anyone reading it.
DRY=""
TODEV=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)  DRY="--dry-run" ;;
    --to-dev)   TODEV=1 ;;
    *)          fail "unknown argument: $1 (only --dry-run and --to-dev are accepted)" ;;
  esac
  shift
done
if [ -n "$TODEV" ] && [ -z "${FLEET_DEV_EMAIL:-}" ]; then
  fail "--to-dev needs FLEET_DEV_EMAIL set in $FLEET_ENV"
fi

APPSCAN="$FLEET_CODE/bin/cti-appscan"
MAILER="$FLEET_CODE/bin/cti-mailer"
[ -x "$APPSCAN" ] || fail "cti-appscan not found at $APPSCAN - rerun the installer"
[ -x "$MAILER" ]  || fail "cti-mailer not found at $MAILER - rerun the installer"

mkdir -p "$STATE"
chmod 0700 "$STATE" 2>/dev/null || true

STAMP="$(date -u +%Y-%m-%d)"
HTML="$STATE/appscan-$STAMP.html"
TXT="$STATE/appscan-$STAMP.txt"
AUTHFAIL="$STATE/appscan-authfail-$STAMP.tsv"
# The notices this report covers. Committed to the processed log only after a
# real send, so the mailbox cleanup archives them once App Dev has the report
# - never on a dry run or a test send.
SEEN="$STATE/appscan-seen-$STAMP.json"
rm -f "$SEEN"
# One Jira ticket per application: the input cti-appscan writes, and what
# cti-jira did with it. Both deleted first, so a stale one is never stamped.
TICKETS="$STATE/appscan-tickets-$STAMP.json"
TICKETREF="$STATE/appscan-tickets-ref-$STAMP.json"
JIRA="$FLEET_CODE/bin/cti-jira"
rm -f "$TICKETS" "$TICKETREF"
# The scanner's own report per application, attached to the ticket when
# WAS_ATTACH_REPORT=1. Fetched only for tickets about to be filed or
# commented (PLAN is a cti-jira preview), and deleted after cti-jira: each
# report carries the scan account's session cookies.
APPREPORT="$FLEET_CODE/bin/cti-appreport"
PLAN="$STATE/appscan-tickets-plan-$STAMP.json"
REPORTS="$STATE/appscan-reports-$STAMP"
rm -rf "$PLAN" "$REPORTS"
# And on every way out - a timeout or SIGTERM included - plus any left by an
# earlier run that was killed before it could clean up.
trap 'rm -rf "$PLAN" "$REPORTS"' EXIT
find "$STATE" -maxdepth 1 -name 'appscan-reports-*' -type d -mtime +0 -exec rm -rf {} + 2>/dev/null || true
REPORTARGS=()

# Mode set BEFORE anything is written. A report naming which applications have
# open Urgent findings, and which are scanned without authentication, is a map
# of where to look - the same handling the VM reports get.
: > "$HTML"; chmod 0600 "$HTML"
: > "$TXT";  chmod 0600 "$TXT"

# REMOVED, not created. The other two are pre-created so the mode is set before
# any content exists; this one is deleted instead, because its ABSENCE is a
# signal and creating it destroys that signal.
#
# cti-appscan writes this file on every run, so after the run: present and
# empty means "checked, nothing failed", and absent means the binary does not
# understand --auth-fail-out and nothing was checked at all. Pre-creating an
# empty file collapses those two into the reassuring one - which is this
# project's recurring bug, a silent nothing that reads as a clean result.
#
# cti-appscan writes it 0600 itself, so the mode does not depend on this.
# Deleting a stale file from an earlier run on the same day also matters: that
# one would be read as this run's answer.
rm -f "$AUTHFAIL"

"$APPSCAN" --out "$HTML" --text-out "$TXT" --auth-fail-out "$AUTHFAIL" --seen-out "$SEEN" \
  --tickets-out "$TICKETS" --ticket-slot \
  || fail "cti-appscan exited non-zero (check outbound 443 to Graph and Qualys)"

SUBJECT="$("$APPSCAN" --subject-only)" || fail "could not build the subject line"
[ -n "$SUBJECT" ] || fail "empty subject - refusing to send a report nobody can triage from the subject"

log "subject: $SUBJECT"

# The application tickets, BEFORE the send, so the email names each one.
# Never fatal: Jira trouble becomes a "not updated" line, and the email goes.
# A dry run or a test send only previews - nothing is written to Jira.
if [ -x "$JIRA" ] && [ -s "$TICKETS" ]; then
  if [ -n "$DRY" ] || [ -n "$TODEV" ]; then
    # The would-be ticket text names URLs and parameters on our own
    # applications: a 0600 file, not the journal.
    PREVIEW="$STATE/appscan-tickets-preview-$STAMP.txt"
    : > "$PREVIEW"; chmod 0600 "$PREVIEW"
    log "tickets: preview only - nothing will be filed or commented; would-be text in $PREVIEW"
    "$JIRA" --appscan-tickets "$TICKETS" --ref-out "$TICKETREF" > "$PREVIEW" \
      || log "WARNING: application ticket preview failed"
  else
    if [ "${WAS_ATTACH_REPORT:-0}" = 1 ]; then
      if [ -x "$APPREPORT" ]; then
        # Never fatal: without the report each ticket still carries every
        # finding. The preview's would-be text is not wanted here.
        if "$JIRA" --appscan-tickets "$TICKETS" --ref-out "$PLAN" > /dev/null \
           && "$APPREPORT" --tickets "$TICKETS" --only-ref "$PLAN" --out-dir "$REPORTS"; then
          REPORTARGS=(--appscan-reports "$REPORTS")
        else
          log "WARNING: scanner reports not fetched - tickets go out without them"
        fi
      else
        log "WAS_ATTACH_REPORT=1 but cti-appreport is not installed - rerun the installer"
      fi
    fi
    "$JIRA" --appscan-tickets "$TICKETS" --for-real --ref-out "$TICKETREF" \
      ${REPORTARGS[@]+"${REPORTARGS[@]}"} \
      || log "WARNING: application tickets not all filed or updated - see the lines above"
    rm -rf "$PLAN" "$REPORTS"
  fi
  "$APPSCAN" --stamp-tickets "$TICKETREF" --tickets-out "$TICKETS" --out "$HTML" --text-out "$TXT" \
    || { log "WARNING: could not stamp the tickets into the report; removing the slot"
         sed -i.bak 's/<!--CTI_APPSCAN_TICKETS-->//g' "$HTML" "$TXT" 2>/dev/null || true
         rm -f "$HTML.bak" "$TXT.bak"; }
else
  [ -x "$JIRA" ] || log "cti-jira not installed - no application tickets"
  sed -i.bak 's/<!--CTI_APPSCAN_TICKETS-->//g' "$HTML" "$TXT" 2>/dev/null || true
  rm -f "$HTML.bak" "$TXT.bak"
fi

if [ -n "$TODEV" ]; then
  # FLEET_DEV_EMAIL only. WAS_TO / WAS_ALLOW_TO are not consulted, so a test
  # works before the lane's audience is configured - which is when you most
  # want to see the report.
  # shellcheck disable=SC2086
  "$MAILER" --to-dev --html "$HTML" --text "$TXT" --subject "$SUBJECT" $DRY \
    || fail "test send failed"
else
  # shellcheck disable=SC2086
  "$MAILER" --lane was --html "$HTML" --text "$TXT" --subject "$SUBJECT" $DRY \
    || fail "send failed - if WAS_TO or WAS_ALLOW_TO is unset the mailer refuses by design"
  # Sent: the owning lane has now seen these notices. Non-fatal - the report
  # is out, and an unrecorded notice is only left in the inbox.
  if [ -z "$DRY" ] && [ -s "$SEEN" ]; then
    "$APPSCAN" --commit-seen "$SEEN" \
      || log "warn: could not record the notices for the mailbox cleanup; they stay in the inbox"
  fi
fi
rm -f "$SEEN"

# ── the operator's half of the report ────────────────────────────────────────
#
# A SCANNER CREDENTIAL THAT STOPPED WORKING GOES TO A DIFFERENT PERSON.
#
# The report above is addressed to the people who own application code. They
# cannot fix a Qualys authentication record, and a week where the scanner
# silently stopped logging in is a week where the numbers they are reading
# describe a smaller surface than last week's while looking like an
# improvement. So the fault is mailed to the fleet operator through cti-alert,
# the fleet's only escalation channel.
#
# The report is sent FIRST and this cannot fail the lane: an alerting problem
# must not cost the weekly mail. HOLD rather than FAILED as the kind - the
# unit did its job; something it depends on is broken - so `systemctl --failed`
# keeps meaning what it says.
#
# An absent file is not the same as an empty one. cti-appscan writes this file
# on every run, so empty means "checked, none found" while missing means the
# binary is older than this runner. Say which.
ALERT="$FLEET_CODE/bin/cti-alert"
if [ ! -f "$AUTHFAIL" ]; then
  log "note: no authentication-failure file at $AUTHFAIL - cti-appscan predates --auth-fail-out, so nothing was checked"
elif [ -s "$AUTHFAIL" ]; then
  n=$(wc -l < "$AUTHFAIL" | tr -d ' ')
  # Applications only. The record name and vendor status stay in the file,
  # which is 0600; the alert says what broke and where to look.
  # awk, not `paste -sd', '`. paste treats the -d argument as a LIST of
  # delimiters used cyclically, so with two characters it joins the first pair
  # with a comma and the next with a space: "a, b c, d". awk joins with one
  # separator, and exits 0 on an empty file, which matters under pipefail.
  apps=$(awk -F'\t' '{printf "%s%s", sep, $1; sep=", "} END {print ""}' "$AUTHFAIL")
  log "AUTH FAILED on $n scan(s): $apps"
  if [ -n "$DRY" ]; then
    log "dry run - would alert the operator about $n authentication failure(s)"
  elif [ -x "$ALERT" ]; then
    # --to-dev on a test send: the alert goes to you too, not the operator.
    "$ALERT" --unit cti-agent-appscan.service --kind HOLD ${TODEV:+--to-dev} \
      --reason "Qualys WAS authentication failed on $n application(s): $apps. The scan covered only the public surface, so this week's counts are not comparable with last week's. Check the authentication record in Qualys WAS; details in $AUTHFAIL on $(hostname -s)." \
      || log "warn: cti-alert failed - the failure is still recorded in $AUTHFAIL"
  else
    log "warn: cti-alert not found at $ALERT - $n authentication failure(s) recorded in $AUTHFAIL and NOT escalated"
  fi
fi

if [ -n "$DRY" ]; then
  log "dry run - nothing was sent. The rendered report is at $HTML"
elif [ -n "$TODEV" ]; then
  log "test send - mailed to FLEET_DEV_EMAIL only. The rendered report is at $HTML"
fi
log "done"
