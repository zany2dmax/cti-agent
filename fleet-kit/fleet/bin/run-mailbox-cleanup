#!/usr/bin/env bash
# run-mailbox-cleanup --dry-run | --for-real
#
# Tidies the shared CTI mailbox once a day: processed advisories to Archive,
# header-confirmed out-of-office replies to Deleted Items, everything the agent
# has no record of reading left exactly where it is - until it is a month old,
# when the sweep moves it to the Unhandled folder. Once a week it says on the
# board what was left and swept, and mails the operator if any mail has gone
# unread by every lane for over a week.
#
# SAY HOW TO RUN IT. --for-real moves the mail, --dry-run prints the plan and
# the reason for every message and moves nothing, and with neither this prints
# usage and exits 2. There is no default: this lane used to rehearse unless
# told --for-real while every other lane acted unless told --dry-run, and a
# command typed from habit did the opposite of what was meant. The systemd unit
# passes --for-real, so a unit that loses it fails loudly instead of quietly
# doing nothing.
#
# It exits 0 when it decides to do nothing - no CTI email processed today, for
# instance. A working refusal is not a failed unit: a non-zero exit would have
# systemd mark this failed and cti-alert email about a lane that behaved
# correctly.
set -euo pipefail

# shellcheck source=../share/fleet-mode.sh
. "$(dirname "${BASH_SOURCE[0]}")/../share/fleet-mode.sh"
DRY=""
REAL=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)  DRY="--dry-run"; shift ;;
    --for-real) REAL="--for-real"; shift ;;
    *) echo "usage: run-mailbox-cleanup --dry-run|--for-real" >&2; exit 2 ;;
  esac
done
fleet_require_mode run-mailbox-cleanup "$DRY" "$REAL" ""

FLEET_HOME="${FLEET_HOME:-$HOME/fleet}"
FLEET_ENV="${FLEET_ENV:-$FLEET_HOME/fleet.env}"
FLEET_CODE="${FLEET_CODE:-$FLEET_HOME}"

# See run-digest: fleet.env must not overwrite the layout the unit injected.
_inj_home="${FLEET_HOME:-}"; _inj_code="${FLEET_CODE:-}"
set -a
# shellcheck source=/dev/null
[ -f "$FLEET_ENV" ] && . "$FLEET_ENV"
set +a
[ -n "$_inj_home" ] && FLEET_HOME="$_inj_home"
[ -n "$_inj_code" ] && FLEET_CODE="$_inj_code"
export FLEET_HOME FLEET_CODE
FLEET_CODE="${FLEET_CODE:-$FLEET_HOME}"

BOARD="$FLEET_CODE/bin/fleet-board"
CLEAN="$FLEET_CODE/bin/cti-mailbox"

mkdir -p "$FLEET_HOME"/{state,logs}
say()  { echo "[run-mailbox-cleanup $(date '+%F %H:%M:%S')] $*"; }
fail() { say "FAILED: $*"; "$BOARD" post @mailbox @you ERROR \
         "run-mailbox-cleanup failed: $*" 2>/dev/null || true; exit 1; }

[ -x "$CLEAN" ] || fail "cti-mailbox not found at $CLEAN - rerun the installer"

PLAN="$FLEET_HOME/state/mailbox-cleanup-$(date +%F).json"

# Pass the threshold through only when it is set, so the binary's own default
# stays the single source of truth for what it is. A variable documented in
# fleet.env.example that no consumer reads is the bug this repo already went
# looking for once.
THRESH=()
if [ -n "${FLEET_MAILBOX_BACKLOG_THRESHOLD:-}" ]; then
  THRESH=(--backlog-threshold "$FLEET_MAILBOX_BACKLOG_THRESHOLD")
fi

if [ -n "$DRY" ]; then
  say "dry run - nothing will be moved"
fi

# Capture the output: it is the audit trail for a lane that moves other
# people's mail, and it goes to the board so the orchestrator sees it too.
OUT="$("$CLEAN" $DRY $REAL ${THRESH[@]+"${THRESH[@]}"} --json "$PLAN" 2>&1)" || {
  echo "$OUT"
  fail "cti-mailbox exited non-zero (a failed move usually means the app registration is missing Mail.ReadWrite with admin consent)"
}
echo "$OUT"

SUMMARY="$(printf '%s' "$OUT" | grep -E '^ +archive [0-9]+' | tr -s ' ' || true)"
[ -n "$SUMMARY" ] || SUMMARY="nothing to do"

if [ -n "$REAL" ]; then
  "$BOARD" post @mailbox @you INFO \
    "mailbox cleanup:$SUMMARY (plan: $PLAN)" 2>/dev/null || true
else
  "$BOARD" post @mailbox @you INFO \
    "mailbox cleanup DRY RUN:$SUMMARY (plan: $PLAN)" 2>/dev/null || true
fi

# A backlog of unread mail is reported by the binary on stderr. Surface it as
# its own board line: it is the symptom of the agent having stopped reading the
# mailbox, which is otherwise silent because the digest keeps succeeding.
if printf '%s' "$OUT" | grep -q 'no processing record, at or above'; then
  "$BOARD" post @mailbox @you WARN \
    "$(printf '%s' "$OUT" | grep 'no processing record, at or above')" \
    2>/dev/null || true
fi

# The mail filter quarantined something a lane reads (a Qualys notice, a feed):
# cti-mailbox prints one QUARANTINE line per such digest, the morning it
# arrives. Releasing is a person's job - the digest's Release links act on a
# bare GET, and the fleet never follows one - so the operator is told: on the
# board, and by mail through cti-alert, whose recipient is fixed.
QUAR="$(printf '%s' "$OUT" | grep '^QUARANTINE: ' || true)"
if [ -n "$QUAR" ]; then
  while IFS= read -r line; do
    "$BOARD" post @mailbox @you WARN "$line" 2>/dev/null || true
    if [ -n "$DRY" ]; then
      say "dry run - would alert the operator: $line"
    elif [ -x "$FLEET_CODE/bin/cti-alert" ]; then
      "$FLEET_CODE/bin/cti-alert" --unit cti-agent-mailbox.service --kind ESCALATION \
        --for-real --reason "${line#QUARANTINE: }" \
        || say "warn: cti-alert failed - the held mail is named on the board"
    else
      say "warn: cti-alert not found - the held mail is named on the board only"
    fi
  done <<EOF
$QUAR
EOF
fi

# ── what stayed, what was swept, and the weekly summary ───────────────────────
# cti-mailbox prints a LEFT line (what it left in the inbox, by reason), a
# STALE line (what the 30-day sweep moved to the Unhandled folder) and, when
# mail no lane has read has sat in the inbox over a week, a NEVER-READ line.
# Every real run appends one record to $WEEK; once a week the totals go to
# the board, and NEVER-READ to the operator by mail. So mail that was swept
# rather than handled is counted where somebody reads it, and mail the fleet
# never read is said out loud instead of waiting for the sweep.
LEFT="$(printf '%s' "$OUT" | grep '^LEFT: ' | head -n 1 || true)"
STALE="$(printf '%s' "$OUT" | grep '^STALE: ' | tail -n 1 || true)"
NEVER="$(printf '%s' "$OUT" | grep '^NEVER-READ: ' | head -n 1 || true)"
[ -n "$STALE" ] && say "$STALE"
[ -n "$LEFT" ] && say "$LEFT"

if [ -n "$NEVER" ]; then
  "$BOARD" post @mailbox @you WARN "$NEVER" 2>/dev/null || true
fi

WEEK="$FLEET_HOME/state/mailbox-week.tsv"
STAMPF="$FLEET_HOME/state/mailbox-week.stamp"
swept="$(printf '%s' "$STALE" | sed -n 's/.*moved=\([0-9][0-9]*\).*/\1/p')"
if [ -n "$REAL" ]; then
  printf '%s\t%s\n' "$(date +%s)" "${swept:-0}" >> "$WEEK"
  chmod 0600 "$WEEK" 2>/dev/null || true
  # Keep a month of records; the summary reads only the last week.
  tail -n 31 "$WEEK" > "$WEEK.tmp" && mv "$WEEK.tmp" "$WEEK"
fi

# Due when there is no stamp, or it is over six days old: once a week, and a
# missed day only delays it.
due=""
if [ ! -f "$STAMPF" ] || [ -n "$(find "$STAMPF" -mmin +8640 2>/dev/null)" ]; then
  due=1
fi
if [ -n "$due" ]; then
  week_swept=0
  if [ -f "$WEEK" ]; then
    week_swept="$(awk -F'\t' -v since="$(( $(date +%s) - 7*86400 ))" \
      '$1 >= since {s += $2} END {print s + 0}' "$WEEK")"
  fi
  WSUM="mailbox week: ${week_swept:-0} message(s) swept to the Unhandled folder in 7 days; ${LEFT:-LEFT: not reported}"
  if [ -n "$DRY" ]; then
    say "dry run - would post the weekly summary: $WSUM"
    [ -n "$NEVER" ] && say "dry run - would alert the operator: $NEVER"
  else
    "$BOARD" post @mailbox @you INFO "$WSUM" 2>/dev/null || true
    if [ -n "$NEVER" ]; then
      if [ -x "$FLEET_CODE/bin/cti-alert" ]; then
        "$FLEET_CODE/bin/cti-alert" --unit cti-agent-mailbox.service --kind ESCALATION \
          --for-real --reason "${NEVER#NEVER-READ: } This week: $WSUM" \
          || say "warn: cti-alert failed - the never-read mail is on the board"
      else
        say "warn: cti-alert not found - the never-read mail is on the board only"
      fi
    fi
    touch "$STAMPF"
  fi
fi

say "done - $SUMMARY"
