#!/usr/bin/env bash
#
# run-domains - weekly domains check to the security team.
#
# For every domain in DOMAINS_FILE: registration at GoDaddy, live/parked,
# certificate validity, and whether its mail records match what the file says
# it does. Then what changed since last week. Mailed through
# cti-mailer --lane dom, which resolves DOM_TO against DOM_ALLOW_TO and
# REFUSES if either is unset - no fallback to the digest audience.
#
# No model is involved. Every line in the report is a DNS answer, an HTTP
# response, a certificate, or a field from the registrar's API.
#
# USAGE
#   run-domains              probe, render, send, advance last week's baseline
#   run-domains --dry-run    probe, render, print the subject; send nothing,
#                            leave the baseline alone, and only PREVIEW the
#                            Jira lock-down ticket
#   run-domains --to-dev     test send: FLEET_DEV_EMAIL only, [DEV TEST]
#                            subject; baseline and Jira as for --dry-run
#
# BEFORE the mail goes, cti-jira --domains-actions files the week's DNS
# changes as ONE lock-down ticket for IT, or comments on the one already open
# when the list has changed, and the ticket's key and status are stamped into
# the report - so the email says which ticket IT is working from. Non-fatal:
# Jira trouble costs the ticket line ("not updated this run - why"), never
# the report.
set -euo pipefail

# Sourced here AND loaded by the binary: see run-appscan for why both.
FLEET_HOME="${FLEET_HOME:-$HOME}"
FLEET_ENV="${FLEET_ENV:-$FLEET_HOME/fleet.env}"
_inj_home="${FLEET_HOME:-}"; _inj_code="${FLEET_CODE:-}"
set -a; [ -f "$FLEET_ENV" ] && . "$FLEET_ENV"; set +a
[ -n "$_inj_home" ] && FLEET_HOME="$_inj_home"
[ -n "$_inj_code" ] && FLEET_CODE="$_inj_code"
FLEET_CODE="${FLEET_CODE:-$FLEET_HOME}"
export FLEET_HOME FLEET_CODE
STATE="$FLEET_HOME/state"

fail() { echo "[run-domains] error: $*" >&2; exit 1; }
log()  { echo "[run-domains] $*" >&2; }

DRY=""
SEND_DRY=""
TODEV=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)  DRY="--dry-run"; SEND_DRY="--dry-run" ;;
    --to-dev)   TODEV=1 ;;
    *)          fail "unknown argument: $1 (only --dry-run and --to-dev are accepted)" ;;
  esac
  shift
done
if [ -n "$TODEV" ] && [ -z "${FLEET_DEV_EMAIL:-}" ]; then
  fail "--to-dev needs FLEET_DEV_EMAIL set in $FLEET_ENV"
fi
# A test send changes who is mailed and nothing else: the baseline is not
# advanced and the lock-down ticket is only previewed, exactly as a dry run.
[ -n "$TODEV" ] && DRY="--dry-run"

DOMAINS="$FLEET_CODE/bin/cti-domains"
MAILER="$FLEET_CODE/bin/cti-mailer"
[ -x "$DOMAINS" ] || fail "cti-domains not found at $DOMAINS - rerun the installer"
[ -x "$MAILER" ]  || fail "cti-mailer not found at $MAILER - rerun the installer"

mkdir -p "$STATE"
chmod 0700 "$STATE" 2>/dev/null || true

STAMP="$(date -u +%Y-%m-%d)"
HTML="$STATE/domains-$STAMP.html"
TXT="$STATE/domains-$STAMP.txt"
SUBJ="$STATE/domains-$STAMP.subject"
CSV="$STATE/domains-$STAMP.csv"
ACTIONS="$STATE/domains-$STAMP-actions.json"
TICKET="$STATE/domains-$STAMP-ticket.json"
JIRA="$FLEET_CODE/bin/cti-jira"

# Mode before content: the report lists every domain we own and which of them
# can be spoofed.
: > "$HTML"; chmod 0600 "$HTML"
: > "$TXT";  chmod 0600 "$TXT"
: > "$CSV";  chmod 0600 "$CSV"
: > "$ACTIONS"; chmod 0600 "$ACTIONS"
# The subject file is deleted, not pre-created: an empty one left over from a
# failed run must not read as this run's subject. The ticket ref likewise: a
# stale one would put last run's outcome in this week's email.
rm -f "$SUBJ" "$TICKET"

NOSTATE=""
[ -n "$DRY" ] && NOSTATE="--no-state-write"

# shellcheck disable=SC2086
"$DOMAINS" $NOSTATE --out "$HTML" --text-out "$TXT" --subject-out "$SUBJ" \
  --csv-out "$CSV" --actions-out "$ACTIONS" --ticket-slot \
  || fail "cti-domains exited non-zero (is DOMAINS_FILE readable by ctiagent?)"

[ -s "$SUBJ" ] || fail "no subject written - refusing to send"
SUBJECT="$(head -n1 "$SUBJ")"
[ -n "$SUBJECT" ] || fail "empty subject - refusing to send"
log "subject: $SUBJECT"

# The lock-down ticket, then its line in the report. Every failure here is
# logged and survived: the ticket line says "not updated, and why", or
# "unavailable" when cti-jira wrote nothing at all.
if [ ! -x "$JIRA" ]; then
  log "cti-jira not installed - no lock-down ticket"
elif [ ! -s "$ACTIONS" ]; then
  log "no actions file written - no lock-down ticket"
elif [ -n "$DRY" ]; then
  log "ticket: dry run, previewing the lock-down ticket only"
  "$JIRA" --domains-actions "$ACTIONS" --ref-out "$TICKET" \
    || log "WARNING: lock-down ticket preview failed"
else
  "$JIRA" --domains-actions "$ACTIONS" --for-real --ref-out "$TICKET" \
    || log "WARNING: lock-down ticket not filed or updated - see the lines above"
fi
if [ -x "$JIRA" ] && [ -s "$ACTIONS" ]; then
  "$DOMAINS" --stamp-ticket "$TICKET" --out "$HTML" --text-out "$TXT" \
    || { log "WARNING: could not stamp the ticket into the report; removing the slot"
         sed -i.bak 's/<!--CTI_DOMAINS_TICKET-->//g' "$HTML" "$TXT" 2>/dev/null || true
         rm -f "$HTML.bak" "$TXT.bak"; }
else
  # No ticket step ran, so there is nothing to say: just clear the slot.
  sed -i.bak 's/<!--CTI_DOMAINS_TICKET-->//g' "$HTML" "$TXT" 2>/dev/null || true
  rm -f "$HTML.bak" "$TXT.bak"
fi

# The CSV is sitecheck.go's full per-host output, attached so the detail the
# email summarises is one click away and sortable.
# shellcheck disable=SC2086
if [ -n "$TODEV" ]; then
  # FLEET_DEV_EMAIL only. DOM_TO / DOM_ALLOW_TO are not consulted, so a test
  # works before the lane's audience is configured.
  # shellcheck disable=SC2086
  "$MAILER" --to-dev --html "$HTML" --text "$TXT" --subject "$SUBJECT" --attach "$CSV" $SEND_DRY \
    || fail "test send failed"
else
  # shellcheck disable=SC2086
  "$MAILER" --lane dom --html "$HTML" --text "$TXT" --subject "$SUBJECT" --attach "$CSV" $DRY \
    || fail "send failed - if DOM_TO or DOM_ALLOW_TO is unset the mailer refuses by design"
fi

rm -f "$TICKET"

if [ -n "$TODEV" ] && [ -z "$SEND_DRY" ]; then
  log "test send - mailed to FLEET_DEV_EMAIL only; baseline not advanced. Report: $HTML"
elif [ -n "$DRY" ]; then
  log "dry run - nothing was sent and the baseline was not advanced. Report: $HTML"
fi
log "done"
