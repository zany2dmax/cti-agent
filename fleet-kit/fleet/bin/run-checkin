#!/usr/bin/env bash
# run-checkin - fire one orchestrator heartbeat.
#
# Exists because systemd's ExecStart needs an absolute path, and there is no
# single path where Claude Code lives:
#
#   native installer   ~/.local/bin/claude
#   Homebrew           /opt/homebrew/bin/claude  (Intel: /usr/local/bin/claude)
#   apt / dnf / apk    /usr/bin/claude
#   npm -g             varies with the npm prefix
#
# Set CLAUDE_BIN in fleet.env to pin one explicitly. Otherwise this searches
# the usual locations and fails loudly rather than letting the timer silently
# do nothing every 30 minutes. On Linux it searches only the root-owned system
# paths - see find_claude.
set -euo pipefail

# shellcheck source=../share/fleet-mode.sh
. "$(dirname "${BASH_SOURCE[0]}")/../share/fleet-mode.sh"

# Say how to run it, as every command that changes something must:
#   --for-real           fire one beat
#   --dry-run | --audit  run the integrity and steering-file checks below, report,
#                        and exit without starting a beat (--audit is the older
#                        name; install-fedora.sh runs it as the service account)
AUDIT_ONLY=0
REAL=""
for _arg in "$@"; do
  case "$_arg" in
    --audit|--dry-run) AUDIT_ONLY=1 ;;
    --for-real)        REAL=1 ;;
    *) echo "usage: run-checkin --dry-run|--for-real   (--audit = --dry-run)" >&2; exit 2 ;;
  esac
done
fleet_require_mode run-checkin "$([ "$AUDIT_ONLY" = 1 ] && echo 1)" "$REAL" ""

FLEET_HOME="${FLEET_HOME:-$HOME/fleet}"
# See run-digest: config may live outside FLEET_HOME on FHS layouts.
FLEET_ENV="${FLEET_ENV:-$FLEET_HOME/fleet.env}"
FLEET_CODE="${FLEET_CODE:-$FLEET_HOME}"

# See run-digest: `set -a` sourcing lets fleet.env overwrite the layout the
# unit or wrapper injected. Preserve what was given to us.
_inj_home="${FLEET_HOME:-}"; _inj_code="${FLEET_CODE:-}"
_inj_feeds="${FLEET_FEEDS:-}"
set -a
# shellcheck source=/dev/null
[ -f "$FLEET_ENV" ] && . "$FLEET_ENV"
set +a
[ -n "$_inj_home" ]  && FLEET_HOME="$_inj_home"
[ -n "$_inj_code" ]  && FLEET_CODE="$_inj_code"
[ -n "$_inj_feeds" ] && FLEET_FEEDS="$_inj_feeds"
export FLEET_HOME FLEET_CODE
FLEET_CODE="${FLEET_CODE:-$FLEET_HOME}"

# ── platform ────────────────────────────────────────────────────────────────
# The fleet runs on Linux in production and on macOS for development, and the
# two disagree on stat(1) flags. Detect once, branch explicitly.
case "$(uname -s)" in
  Darwin) FLEET_OS="macos" ;;
  Linux)  FLEET_OS="linux" ;;
  *)      FLEET_OS="other" ;;
esac

# mtime in epoch seconds. Getting this wrong fails SILENTLY: stat errors, the
# caller sees 0, every lock looks infinitely old, and the lock stops locking.
mtime() {
  if [ "$FLEET_OS" = "macos" ]; then
    stat -f %m "$1" 2>/dev/null || echo 0
  else
    stat -c %Y "$1" 2>/dev/null || echo 0
  fi
}

# ── code integrity: fail closed ─────────────────────────────────────────────
# The allowlist below is only as trustworthy as the files it names and the
# script that builds it. If the service account can write any of them, a beat
# that reads a hostile advisory or mail could change what the NEXT beat runs -
# and every later timer run would execute that change with the fleet's
# credentials. install-fedora.sh puts the code in /opt/cti-agent, root-owned
# 0755; the retired generic installer left it all owned by the service account.
#
# So refuse to start unless each path is owned by root and writable by nobody
# else - us included. Exit 1 rather than posting to the board: fleet-board is
# one of the files being checked, so it is the one thing not to run when the
# check fails. The unit's OnFailure= alert tells the operator instead.
#
# Skipped on macOS only, where this is a developer's own checkout, owned by
# design; it says so on every beat rather than skipping silently. Any other
# platform is checked, and refuses if its stat(1) cannot answer.
code_owned_by_root() {
  local p owner mode
  for p in "$@"; do
    # A dangling symlink is a path someone can make real later; refuse it.
    if [ -L "$p" ] && [ ! -e "$p" ]; then
      echo "run-checkin: REFUSING to start: $p is a dangling symlink." >&2
      return 1
    fi
    [ -e "$p" ] || continue
    # -L: judge what a symlink points at - that is what gets executed.
    owner="$(stat -L -c %u "$p" 2>/dev/null || echo unknown)"
    mode="$(stat -L -c %a "$p" 2>/dev/null || echo 7777)"
    if [ "$owner" != 0 ] || [ $(( 8#$mode & 8#022 )) -ne 0 ] || [ -w "$p" ]; then
      echo "run-checkin: REFUSING to start: $p is writable by the service" >&2
      echo "  account or not root-owned (owner uid $owner, mode $mode)." >&2
      echo "  The fleet's code must be root-owned and read-only to the service;" >&2
      echo "  reinstall with install-fedora.sh --for-real, which puts it in /opt/cti-agent." >&2
      return 1
    fi
  done
}

# ── what steers the beat: root-owned too ───────────────────────────────────
# Code is not the only thing a beat runs on. Claude Code also loads CLAUDE.md,
# the skills under .claude/skills, .claude/settings*.json (allow rules and
# hooks, which are shell commands), .mcp.json and ~/.claude.json from its
# working directory and HOME. The beat used to start in $FLEET_HOME, the
# service account's own HOME and state dir, where the old installer put
# CLAUDE.md and the skills owned by that account. Making the FILES root-owned
# would not have been enough there: an account that owns a directory can
# rename anything in it and put its own copy in place.
#
# So on Linux the beat starts in $FLEET_CODE/orchestrator, a root-owned
# directory that holds only CLAUDE.md and .claude/skills. It loads project
# settings only (--setting-sources project, so nothing from ~/.claude), takes
# hooks-off and deny rules from a root-owned --settings file, and loads no MCP
# server at all (--strict-mcp-config with none given). The steering audit below
# refuses a beat when a file the service account could have planted is there.
#
# macOS keeps the developer layout: the beat starts in $FLEET_HOME and the
# settings file is used when present.
if [ "$FLEET_OS" = "macos" ]; then
  AGENT_DIR="$FLEET_HOME"
else
  AGENT_DIR="$FLEET_CODE/orchestrator"
fi
CHECKIN_SETTINGS="$FLEET_CODE/checkin-settings.json"
CLAUDE_CFG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

if [ "$FLEET_OS" != "macos" ]; then
  SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
  # Every entry in bin/, not a hand-kept list: the beat is granted several of
  # them and the timers run the rest.
  code_owned_by_root "$SELF" "$(dirname "$SELF")" \
    "$FLEET_CODE" "$FLEET_CODE/bin" "$FLEET_CODE"/bin/* \
    "$CHECKIN_SETTINGS" \
    "$AGENT_DIR" "$AGENT_DIR/CLAUDE.md" "$AGENT_DIR/.claude" \
    "$AGENT_DIR/.claude/skills" "$AGENT_DIR"/.claude/skills/* \
    "$AGENT_DIR"/.claude/skills/*/* || exit 1
  # Missing is a refusal too: a box upgraded without re-running the installer
  # has no orchestrator dir, and a beat there would run with no instructions.
  for p in "$AGENT_DIR/CLAUDE.md" "$AGENT_DIR/.claude/skills/checkin/SKILL.md" \
           "$CHECKIN_SETTINGS" "$FLEET_CODE/bin/checkin-bash-guard"; do
    if [ ! -f "$p" ]; then
      echo "run-checkin: REFUSING to start: $p is missing." >&2
      echo "  Re-run install-fedora.sh --for-real; it installs the orchestrator's" >&2
      echo "  instructions root-owned in $AGENT_DIR." >&2
      exit 1
    fi
  done
  # The guard is a hook, and a hook whose command does not exist fails OPEN
  # (Claude Code treats a non-2 exit as a warning). So the settings must name
  # the guard at this box's own code path, which the check above has just
  # found present and root-owned.
  # Parsed, not grepped: hooks on, and a Bash PreToolUse hook that runs it.
  if ! /usr/bin/python3 -I - "$CHECKIN_SETTINGS" "$FLEET_CODE/bin/checkin-bash-guard" <<'PY'
import json, sys
s = json.load(open(sys.argv[1], encoding="utf-8"))
ok = s.get("disableAllHooks") is False and any(
    m.get("matcher") == "Bash" and any(h.get("type") == "command" and h.get("command") == sys.argv[2]
                                       for h in m.get("hooks", []))
    for m in s.get("hooks", {}).get("PreToolUse", []))
sys.exit(0 if ok else 1)
PY
  then
    echo "run-checkin: REFUSING to start: $CHECKIN_SETTINGS does not run" >&2
    echo "  $FLEET_CODE/bin/checkin-bash-guard as its Bash PreToolUse hook." >&2
    exit 1
  fi
  # And the guard must actually refuse. A missing interpreter or a broken
  # script exits non-2, which Claude Code treats as "allow".
  guard_rc=0
  printf '%s' '{"tool_name":"Bash","tool_input":{"command":"x > y"}}' \
    | "$FLEET_CODE/bin/checkin-bash-guard" >/dev/null 2>&1 || guard_rc=$?
  if [ "$guard_rc" -ne 2 ]; then
    echo "run-checkin: REFUSING to start: checkin-bash-guard let a redirect" >&2
    echo "  through (exit $guard_rc, want 2). Is /usr/bin/python3 installed?" >&2
    exit 1
  fi
else
  echo "[run-checkin] code integrity check skipped on macOS (developer checkout)"
fi

# Files Claude Code would load from the working directory or the account's
# HOME and config dir, none of which this fleet ships. In the root-owned
# orchestrator dir only root could have put one there; in HOME the account
# itself could, which is the case this exists for - a beat steered once must
# not be able to leave something behind that steers every beat after it.
#
# Settings files in the config dir are not loaded (--setting-sources project),
# so one is refused only when it carries something that would matter if a
# later Claude Code loaded it anyway: hooks, permissions, MCP servers, env,
# helper commands, plugins. ~/.claude.json is Claude Code's own state file and
# exists after the first run; it is refused only when it names MCP servers or
# allow rules.
steering_problems() {
  local p
  for p in \
    "$AGENT_DIR/.claude/settings.json" "$AGENT_DIR/.claude/settings.local.json" \
    "$AGENT_DIR/.mcp.json" "$AGENT_DIR/CLAUDE.local.md" \
    "$AGENT_DIR/.claude/commands" "$AGENT_DIR/.claude/agents" \
    "$AGENT_DIR/.claude/hooks" "$AGENT_DIR/.claude/rules" \
    "$AGENT_DIR/.claude/output-styles" "$AGENT_DIR/.claude/workflows" \
    "$CLAUDE_CFG/workflows" "$CLAUDE_CFG"/projects/*/memory \
    "$CLAUDE_CFG/CLAUDE.md" "$CLAUDE_CFG/skills" "$CLAUDE_CFG/commands" \
    "$CLAUDE_CFG/agents" "$CLAUDE_CFG/hooks" "$CLAUDE_CFG/rules" \
    "$CLAUDE_CFG/output-styles" \
    "$HOME/CLAUDE.md" "$HOME/CLAUDE.local.md" "$HOME/.mcp.json" \
    "$CLAUDE_CFG/settings.local.json"; do
    if [ -e "$p" ] || [ -L "$p" ]; then
      echo "$p: present, and nothing in this fleet installs it"
    fi
  done
  # -I: isolated mode, so nothing in the cwd or the environment picks the
  # modules this imports.
  python3 -I - "$CLAUDE_CFG/settings.json" "$HOME/.claude.json" \
      "$CLAUDE_CFG/.claude.json" <<'PY'
import json, os, sys
RISKY = ("hooks", "permissions", "mcpServers", "enabledMcpjsonServers",
         "enableAllProjectMcpServers", "env", "apiKeyHelper", "awsAuthRefresh",
         "awsCredentialExport", "otelHeadersHelper", "statusLine",
         "enabledPlugins", "extraKnownMarketplaces", "allowedTools")
seen = set()
for path in sys.argv[1:]:
    real = os.path.realpath(path)
    if real in seen or not os.path.lexists(path):
        continue
    seen.add(real)
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError) as e:
        print(f"{path}: cannot be read as JSON ({e.__class__.__name__})")
        continue
    if not isinstance(data, dict):
        print(f"{path}: not a JSON object")
        continue
    scopes = [("", data)]
    projects = data.get("projects")
    if isinstance(projects, dict):
        scopes += [(f"projects[{k}].", v) for k, v in projects.items() if isinstance(v, dict)]
    for where, d in scopes:
        for key in RISKY:
            if d.get(key) not in (None, False, [], {}, ""):
                print(f"{path}: {where}{key} is set")
PY
}

STEERING="$(steering_problems 2>&1)" || STEERING="${STEERING:-steering audit failed to run}"
if [ "$FLEET_OS" != "macos" ] && [ -n "$STEERING" ]; then
  echo "run-checkin: REFUSING to start: files that could steer the beat:" >&2
  echo "$STEERING" | sed 's/^/  /' >&2
  echo "  None of these is installed by this fleet. Read each one, then move it" >&2
  echo "  out of the service account's reach (install-fedora.sh does this into" >&2
  echo "  /etc/cti-agent/quarantine) or delete the key named." >&2
  "$FLEET_CODE/bin/fleet-board" post @you @operator ERROR \
    "heartbeat refused: unexpected Claude Code settings/instructions in the service account's reach; see journalctl -u cti-agent-checkin" 2>/dev/null || true
  exit 1
elif [ -n "$STEERING" ]; then
  echo "[run-checkin] steering audit (not enforced on macOS):" >&2
  echo "$STEERING" | sed 's/^/  /' >&2
fi

if [ "$AUDIT_ONLY" = 1 ]; then
  echo "[run-checkin] audit passed: code and orchestrator files are root-owned, no unexpected steering files"
  exit 0
fi

find_claude() {
  if [ -n "${CLAUDE_BIN:-}" ]; then
    [ -x "$CLAUDE_BIN" ] && { echo "$CLAUDE_BIN"; return 0; }
    echo "run-checkin: CLAUDE_BIN=$CLAUDE_BIN is not executable" >&2
    return 1
  fi
  local c
  # On Linux, only the system locations. ~/.local/bin is the service
  # account's own HOME, so a claude found there - or anywhere on a PATH that
  # reaches it - is a binary the account can replace, and it runs every beat
  # with the fleet's credentials. It was also searched FIRST, so a planted
  # copy won even on a box with the dnf package installed.
  if [ "$FLEET_OS" = "linux" ]; then
    for c in /usr/bin/claude /usr/local/bin/claude; do
      [ -x "$c" ] && { echo "$c"; return 0; }
    done
    return 1
  fi
  for c in "$HOME/.local/bin/claude" /usr/bin/claude /usr/local/bin/claude \
           /opt/homebrew/bin/claude /snap/bin/claude; do
    [ -x "$c" ] && { echo "$c"; return 0; }
  done
  c="$(command -v claude 2>/dev/null || true)"
  [ -n "$c" ] && { echo "$c"; return 0; }
  return 1
}

CLAUDE="$(find_claude)" || {
  echo "run-checkin: cannot find the claude binary." >&2
  echo "  On Linux install it system-wide (sudo dnf install claude-code), so it" >&2
  echo "  is root-owned; a copy in the service account's HOME is not used." >&2
  echo "  Or set CLAUDE_BIN=/full/path/to/claude in $FLEET_ENV." >&2
  "$FLEET_CODE/bin/fleet-board" post @you @operator ERROR \
    "heartbeat cannot start: claude binary not found; set CLAUDE_BIN in fleet.env" 2>/dev/null || true
  exit 1
}
# The binary that runs the beat is code too. Same rule, same refusal.
if [ "$FLEET_OS" = "linux" ]; then
  code_owned_by_root "$CLAUDE" || exit 1
fi

# CHECKIN_MODEL - which model the beat runs on. Unset: the account's default,
# as before. The operator's choice, never the beat's: it is read here, from
# fleet.env, and the model cannot change it mid-beat.
#
# A value that is not a model alias or a claude-* id refuses the beat, loudly,
# rather than quietly running the default: a typo would otherwise leave the
# operator comparing weeks of "Sonnet" beats that were never Sonnet. The
# character list is spelled out because a [a-z] range follows the locale.
CHECKIN_MODEL="${CHECKIN_MODEL:-}"
MODEL_ARGS=()
if [ -n "$CHECKIN_MODEL" ]; then
  model_ok=1
  case "$CHECKIN_MODEL" in
    haiku|sonnet|opus|fable) ;;
    claude-?*)
      case "$CHECKIN_MODEL" in
        *[!abcdefghijklmnopqrstuvwxyz0123456789.-]*) model_ok=0 ;;
      esac ;;
    *) model_ok=0 ;;
  esac
  if [ "$model_ok" != 1 ]; then
    echo "run-checkin: CHECKIN_MODEL='$CHECKIN_MODEL' in $FLEET_ENV is not a model." >&2
    echo "  Use an alias (haiku, sonnet, opus, fable) or a full id (claude-...)," >&2
    echo "  or leave it blank for the account's default." >&2
    "$FLEET_CODE/bin/fleet-board" post @you @operator ERROR \
      "heartbeat cannot start: CHECKIN_MODEL in fleet.env is not a model name" 2>/dev/null || true
    exit 1
  fi
  MODEL_ARGS=(--model "$CHECKIN_MODEL")
fi

# CHECKIN_TRACE_DAYS / CHECKIN_TRACE_MAX_MB - the beat trace (HARNESS.md, H1).
# Each beat's full stream-json is kept in state/traces for this many days, so
# "why did the heartbeat do that?" has an answer that is not whatever the
# model chose to print. 0 keeps no traces and runs the beat in text mode, as
# before. Unlike CHECKIN_MODEL a bad value does not refuse the beat: a typo in
# a retention setting is not worth a silent heartbeat, so it says so and uses
# the default.
CHECKIN_TRACE_DAYS="${CHECKIN_TRACE_DAYS:-14}"
CHECKIN_TRACE_MAX_MB="${CHECKIN_TRACE_MAX_MB:-20}"
case "$CHECKIN_TRACE_DAYS" in
  ''|*[!0123456789]*)
    echo "run-checkin: CHECKIN_TRACE_DAYS='$CHECKIN_TRACE_DAYS' is not a number of days; using 14" >&2
    CHECKIN_TRACE_DAYS=14 ;;
esac
case "$CHECKIN_TRACE_MAX_MB" in
  ''|0|*[!0123456789]*)
    echo "run-checkin: CHECKIN_TRACE_MAX_MB='$CHECKIN_TRACE_MAX_MB' is not a size in MB; using 20" >&2
    CHECKIN_TRACE_MAX_MB=20 ;;
esac

# A stored login does not live in the same place on both platforms, and
# checking the wrong one is worse than not checking at all. On Linux the token
# is a file under the config dir; on macOS it is a Keychain item and that file
# NEVER exists, so a file-only test would reject every dev run on a machine
# that is perfectly well authenticated.
has_stored_credentials() {
  if [ "$FLEET_OS" = "macos" ]; then
    # Existence only - no -w, which would read the secret and can prompt.
    security find-generic-password -s "Claude Code-credentials" >/dev/null 2>&1
  else
    [ -s "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json" ]
  fi
}

# Finding the binary is not the same as being able to use it. The service
# account has no browser and no TTY, so an unauthenticated claude blocks or
# errors in a way that reads like a hang rather than a config problem. Check
# for credentials up front and name the fix.
# WHICH credential, not just whether one exists.
#
# This check used to ask only "is at least one set", while fleet.env.example
# said "Set EXACTLY ONE of these". A documented invariant that nothing
# enforces is not an invariant, and this one bills real money to the wrong
# account: with both ANTHROPIC_API_KEY and CLAUDE_CODE_OAUTH_TOKEN present,
# claude uses the Console key, so a fleet configured against a subscription
# seat quietly draws down an org credit balance instead. When that balance
# hit zero the failure read "Credit balance is too low" on a box whose
# operator had deliberately wired it to a subscription - and nothing in any
# log had ever said which credential was in use.
#
# So: name the credential on every beat, and refuse when the answer is
# ambiguous. Refusing is the right direction because the alternative is
# silently charging somebody who did not agree to pay.
AUTH_SET=""
[ -n "${ANTHROPIC_API_KEY:-}" ]       && AUTH_SET="$AUTH_SET ANTHROPIC_API_KEY"
[ -n "${ANTHROPIC_AUTH_TOKEN:-}" ]    && AUTH_SET="$AUTH_SET ANTHROPIC_AUTH_TOKEN"
[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ] && AUTH_SET="$AUTH_SET CLAUDE_CODE_OAUTH_TOKEN"
AUTH_SET="${AUTH_SET# }"
AUTH_COUNT=$(printf '%s\n' $AUTH_SET | grep -c . || true)

if [ "$AUTH_COUNT" -gt 1 ]; then
  echo "run-checkin: MORE THAN ONE credential is set: $AUTH_SET" >&2
  echo "  claude picks one, and the one it picks is probably not the one you" >&2
  echo "  meant - ANTHROPIC_API_KEY bills a Console balance, while" >&2
  echo "  CLAUDE_CODE_OAUTH_TOKEN draws on a subscription seat." >&2
  echo "  Blank all but one in $FLEET_ENV." >&2
  "$FLEET_CODE/bin/fleet-board" post @you @operator ERROR \
    "heartbeat refused: more than one Claude credential set ($AUTH_SET); blank all but one in fleet.env" 2>/dev/null || true
  exit 1
fi

if [ "$AUTH_COUNT" -eq 0 ] && ! has_stored_credentials; then
  echo "run-checkin: claude is installed at $CLAUDE but not authenticated." >&2
  echo "  Set one of these in $FLEET_ENV:" >&2
  echo "    ANTHROPIC_API_KEY        Console key, billed per token" >&2
  echo "    CLAUDE_CODE_OAUTH_TOKEN  subscription token from 'claude setup-token'" >&2
  echo "  or, if this account has a login shell, authenticate it once:" >&2
  echo "    sudo -u $(id -un) HOME=$HOME claude" >&2
  "$FLEET_CODE/bin/fleet-board" post @you @operator ERROR \
    "heartbeat cannot start: claude not authenticated; set ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN in fleet.env" 2>/dev/null || true
  exit 1
fi

# The NAME only. Never the value, and never a prefix of it - a few characters
# of a live token in a journal is still a few characters of a live token.
if [ "$AUTH_COUNT" -eq 1 ]; then
  AUTH_VIA="$AUTH_SET"
else
  AUTH_VIA="stored credentials in ${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
fi
echo "[run-checkin $(date '+%F %H:%M:%S')] auth: $AUTH_VIA"

# A heartbeat that overlaps itself corrupts nothing (the board is lock-safe) but
# wastes a slot and doubles token spend. Skip if the previous beat is still up.
LOCK="$FLEET_HOME/.checkin.lock"
if ! mkdir "$LOCK" 2>/dev/null; then
  age=$(( $(date +%s) - $(mtime "$LOCK") ))
  if [ "$age" -lt 1800 ]; then
    echo "[run-checkin $(date '+%F %H:%M:%S')] previous beat still running (${age}s) - skipping"
    exit 0
  fi
  rmdir "$LOCK" 2>/dev/null || true
  mkdir "$LOCK" 2>/dev/null || true
fi
trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT

# The fleet and its operator draw on the same subscription quota, from
# different machines, with no API that reports what is left. So the fleet
# rations itself: cti-budget holds a rolling-window and daily ceiling and a
# cooldown after any rate limit. Locking prevents the fleet colliding with
# itself; this is what keeps it from crowding out the person who owns the
# account.
#
# The gate is skipped rather than failed when cti-budget is absent, so an
# older install keeps beating instead of going silent on upgrade.
BUDGET="$FLEET_CODE/bin/cti-budget"
if [ -x "$BUDGET" ]; then
  budget_out="$("$BUDGET" check --print-alert-flag 2>&1)" && budget_rc=0 || budget_rc=$?
  if [ "$budget_rc" -eq 3 ]; then
    # `|| true` because grep -v exits 1 when it filters EVERYTHING out, and
    # under `set -o pipefail` that 1 reaches the assignment and `set -e` ends
    # the script. That case is reachable: a cti-budget that prints only the
    # flag line and no explanation leaves nothing behind, and the beat would
    # die at the exact moment it was trying to report why it was holding.
    reason="$(echo "$budget_out" | { grep -v '^\(alert\|silent\)$' || true; } | tr '\n' ' ')"
    reason="${reason:-no reason given by cti-budget}"
    echo "[run-checkin $(date '+%F %H:%M:%S')] skipping: $reason"
    "$FLEET_CODE/bin/fleet-board" post @you @operator INFO \
      "heartbeat skipped - $reason" 2>/dev/null || true
    # Escalate on the first beat of each distinct denial. cti-budget decides,
    # so a six-hour backoff does not send the same email three times.
    if echo "$budget_out" | tail -1 | grep -qx alert && [ -x "$FLEET_CODE/bin/cti-alert" ]; then
      "$FLEET_CODE/bin/cti-alert" --unit cti-agent-checkin.service \
        --for-real --kind HOLD --reason "$reason" || true
    fi
    # Exit 0: a working brake is not a failed unit. Non-zero would trip
    # OnFailure= and email a second time about the fleet behaving correctly.
    exit 0
  elif [ "$budget_rc" -ne 0 ]; then
    # Fail closed. This used to say "proceeding", so a brake that could not
    # read its ledger let every beat through, and anything that could break
    # the check (an unreadable ledger, a bad flag) disabled the rate limit
    # (PrimeSec attack vector 10786557). A corrupt ledger is not this case:
    # cti-budget reads it as empty and allows. Exit 1 marks the unit failed,
    # and OnFailure= mails the operator once per failed beat.
    echo "[run-checkin] REFUSING to start: cti-budget check failed (rc=$budget_rc): $budget_out" >&2
    exit 1
  else
    echo "[run-checkin $(date '+%F %H:%M:%S')] $budget_out"
  fi
fi

echo "[run-checkin $(date '+%F %H:%M:%S')] using $CLAUDE in $AGENT_DIR"
echo "[run-checkin $(date '+%F %H:%M:%S')] model: ${CHECKIN_MODEL:-account default}"
cd "$AGENT_DIR"

# Deliberately NOT exec - exec replaces this shell and discards the EXIT trap,
# which would leave .checkin.lock behind after every beat and block the next
# one until the staleness check expires it.
#
# stdin is closed explicitly: with -p, Claude Code waits on stdin for a few
# seconds before giving up, and systemd gives a oneshot service no tty.
#
# Output is teed rather than swallowed: the journal still gets everything, and
# a copy goes to cti-budget so it can tell "the quota refused us" from "the
# script broke". Those want opposite responses - wait vs fix - and the exit
# code alone does not distinguish them.
beat_log="$(mktemp "${TMPDIR:-/tmp}/cti-checkin.XXXXXX")"
trap 'rmdir "$LOCK" 2>/dev/null || true; rm -f "$beat_log"' EXIT

# WHAT THE ORCHESTRATOR MAY RUN, AND WHY IT IS A FLAG NOT A SETTINGS FILE.
#
# With -p and stdin closed there is nobody to approve anything, so every tool
# call not granted here is denied. That was the "sandbox block" the heartbeat
# reported for ten days: it could not run fleet-board, fleet-db, cti-budget or
# journalctl. Not SELinux, not sudo - a missing allowlist.
#
# NO FILE EDITS. The beat used to run with --permission-mode acceptEdits,
# which auto-approves Edit and Write. Nothing in /checkin writes a file - its
# memory, tasks and board posts all go through the commands below - so the
# grant bought nothing, while a beat steered by a hostile advisory could use it
# to rewrite its own instructions or, on a layout where the service owns the
# code, the runners themselves. The beat keeps the read-only file tools it
# needs to look at reports/ and logs/, and Edit, Write and NotebookEdit are
# disallowed outright so a later default change in Claude Code cannot
# quietly give them back.
#
# The list lives HERE, on the command line, rather than in a settings.json
# under the agent's own HOME, which is a directory the agent's account owns.
# run-checkin is root-owned 0755 in $FLEET_CODE (checked above, fail closed),
# which makes this the one place the list cannot be widened by the thing it
# constrains.
#
# Absolute paths, so a binary of the same name earlier in PATH does not
# inherit the grant.
#
# NOT GRANTED, deliberately:
#   cti-mailer / mailer.py  - the orchestrator must not be able to address
#                             mail. Escalation goes through cti-alert, which
#                             IS granted below and has no recipient argument.
#                             The one exception is the exact command
#                             `cti-mailer --check` (no :*, and the guard takes
#                             no other argument), which requests a token and
#                             reads its roles: it cannot send.
#   run-digest, run-patchtuesday, run-appscan, run-mailbox-cleanup
#                           - every runner either sends mail or moves it.
#                             Timers own those; a beat that needs one re-run
#                             escalates with the exact command for a person.
#   cti-mailbox (bare)      - moves mail, so only the exact command
#                             `cti-mailbox --dry-run` is granted below, with no
#                             :* after it. Moving mail is a scheduled decision,
#                             not a beat-time one.
#   anything outside this list - including a plain shell.
#
# PER SUBCOMMAND, NOT PER BINARY. `fleet-db:*` granted `fleet-db sent`, which
# records a digest as delivered - run-digest then skips that day's real send -
# and `fleet-db finding`, which rewrites the findings the digest is built
# from. `cti-patchtuesday:*` granted `--mark-sent`, which CLAUDE.md forbids
# and which makes the daily drop a whole release's CVEs. A prohibition that
# lives only in the prompt, on a capability the grant includes, is not a
# control. Each line below is a prefix match, so it names exactly the
# subcommands CLAUDE.md and the /checkin skill tell the agent to use, and
# tests/test_lanes.py checks the two stay in step.
# fleet-board: say, read, tail, and the two bounded ways to prune - resolve
# (one question and its answers, by id) and expire (lines older than N days,
# ERROR lines kept a week). NOT prune itself, which takes a regex: `prune .`
# empties the board, including the ERROR lines cti-alert and the runners
# leave for the operator. That one is the operator's. NOT post either:
# post names its own sender, so a beat could sign a line as @operator (an
# answer the next beat acts on) or @systemd. `say` posts as @you, always.
ALLOWED_TOOLS=""
for sub in say read tail resolve expire; do
  ALLOWED_TOOLS="${ALLOWED_TOOLS:+$ALLOWED_TOOLS,}Bash($FLEET_CODE/bin/fleet-board $sub:*)"
done
# fleet-db: reads, plus the memory, task and board-mail writes the agent is
# told to make every beat. NOT sent (fakes a delivered digest), finding
# (rewrites what the digest reports), note (silences the stale-finding nudge
# for a CVE) or init (schema setup is the installer's).
for sub in recent findings was-sent rollup remember task mail ack vacuum; do
  ALLOWED_TOOLS="$ALLOWED_TOOLS,Bash($FLEET_CODE/bin/fleet-db $sub:*)"
done
# cti-budget: status only. `record` writes beat outcomes into budget.json,
# and `check` is run-checkin's own gate - a beat that could record its own
# results could talk the brake out of engaging.
ALLOWED_TOOLS="$ALLOWED_TOOLS,Bash($FLEET_CODE/bin/cti-budget status:*)"
ALLOWED_TOOLS="$ALLOWED_TOOLS,Bash($FLEET_CODE/bin/cti-kev:*)"
# Rendering only. cti-patchtuesday refuses --mark-sent with --dry-run, so no
# invocation that starts with --dry-run can change state.
ALLOWED_TOOLS="$ALLOWED_TOOLS,Bash($FLEET_CODE/bin/cti-patchtuesday --dry-run:*)"
ALLOWED_TOOLS="$ALLOWED_TOOLS,Bash($FLEET_CODE/bin/cti-mailbox --dry-run)"
# The credential checks: would the next run of each lane get past its logins?
# Each is the exact command, with no :* after it, so no other flag rides along.
# Each makes one or two read-only calls, writes nothing, and prints counts and
# setting names - no recipients, no hostnames and no mail text, which is why
# these and not the lanes' --dry-run (that prints addresses and inbound
# subjects, spends the Qualys budget, and writes state the real runs read).
ALLOWED_TOOLS="$ALLOWED_TOOLS,Bash($FLEET_CODE/bin/cti-mailer --check)"
ALLOWED_TOOLS="$ALLOWED_TOOLS,Bash($FLEET_CODE/bin/cti-jira --check)"
ALLOWED_TOOLS="$ALLOWED_TOOLS,Bash($FLEET_CODE/bin/cti-appreport --check)"
ALLOWED_TOOLS="$ALLOWED_TOOLS,Bash($FLEET_CODE/bin/cti-domains --check)"
ALLOWED_TOOLS="$ALLOWED_TOOLS,Bash($FLEET_CODE/bin/cti-vmscan --check)"
# Read-only, and the only way a beat can see that a timer was disabled - the
# failure that raises no alarm at all, and the one ARCHITECTURE.md says the
# orchestrator exists to catch. Through fleet-timers, not systemctl itself:
# `systemctl list-timers:*` could not become stop or disable, but it still
# took --host=user@box, which runs the query over ssh to any machine. The
# wrapper accepts --all and cti-agent-* patterns only.
ALLOWED_TOOLS="$ALLOWED_TOOLS,Bash($FLEET_CODE/bin/fleet-timers:*)"
# cti-alert is the escalation channel, and the ONLY mail capability granted.
# It is narrow by construction rather than by trust: it has no --to flag, so
# the recipient is FLEET_OPERATOR_EMAIL from the environment and the agent
# cannot choose who it reaches. The caller-supplied --reason is HTML-escaped
# before it becomes mail. So the worst an injected advisory achieves is one
# message to an address the operator already configured, from the fleet's own
# mailbox - not a send to an attacker's address.
ALLOWED_TOOLS="$ALLOWED_TOOLS,Bash($FLEET_CODE/bin/cti-alert:*)"
# The journal through fleet-journal, not journalctl itself: journalctl
# --cursor-file=PATH writes to PATH as this account, so a grant of
# journalctl:* could overwrite state/budget.json (resetting the quota) or
# memory.db. The wrapper accepts -u cti-agent-*, --since, -n and --no-pager.
ALLOWED_TOOLS="$ALLOWED_TOOLS,Bash($FLEET_CODE/bin/fleet-journal:*)"
# The beat no longer starts in $FLEET_HOME, so the state it reads with its
# file tools is named. Read rules cover Glob and Grep too. Not state/ (memory
# goes through fleet-db) and not the account's credentials.
for d in reports logs archive; do
  ALLOWED_TOOLS="$ALLOWED_TOOLS,Read(/$FLEET_HOME/$d/**)"
done

DISALLOWED_TOOLS="Edit,Write,NotebookEdit"

echo "[run-checkin $(date '+%F %H:%M:%S')] allowed tools: $ALLOWED_TOOLS"
echo "[run-checkin $(date '+%F %H:%M:%S')] disallowed tools: $DISALLOWED_TOOLS"

# errexit OFF around the beat. Under `set -euo pipefail` a non-zero claude exit
# failed the pipeline and ended the script on this line, so rc was never read:
# the budget never recorded the failure, rate-limit backoff never engaged, the
# exit-4 HOLD path below was unreachable, and running out of credit failed the
# unit and mailed FAILED - the outage the HOLD path exists to prevent.
set +e
# Auto-memory is a CLAUDE.md the model writes for itself, under the account's
# config dir, and loaded on the next session: persistence by design. Off.
export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1

# PER-BEAT LIMITS (PrimeSec design review 39260, Scenario-224). The Bash guard
# counts this beat's calls under state/checkin-counts and refuses the ones past
# CHECKIN_MAX_BASH / _ALERTS / _BOARD_WRITES / _DB_WRITES (defaults 20 / 2 / 4 /
# 6 in the guard; a busy normal beat makes about 11 calls and 1 write of each
# kind, measured from the traces). The beat id is what keys the counter, and
# these variables are set here, on the claude process, which the beat cannot
# change. After the beat the runner (not the model) reads the counts and the
# board's growth and tells the operator.
CHECKIN_BEAT_ID="$(date '+%Y%m%dT%H%M%S')-$$"
export CHECKIN_BEAT_ID
BEAT_COUNTS_DIR="$FLEET_HOME/state/checkin-counts"
BEAT_BOARD="$FLEET_HOME/board.md"
board_before="$(wc -l < "$BEAT_BOARD" 2>/dev/null | tr -d ' ' || true)"
board_before="${board_before:-0}"
find "$BEAT_COUNTS_DIR" -name '*.json' -mtime +7 -delete 2>/dev/null || true
SETTINGS_ARGS=()
[ -f "$CHECKIN_SETTINGS" ] && SETTINGS_ARGS=(--settings "$CHECKIN_SETTINGS")
CLAUDE_ARGS=(-p "/checkin" ${MODEL_ARGS[@]+"${MODEL_ARGS[@]}"} --permission-mode default
  --setting-sources project ${SETTINGS_ARGS[@]+"${SETTINGS_ARGS[@]}"}
  --strict-mcp-config
  --allowedTools "$ALLOWED_TOOLS" --disallowedTools "$DISALLOWED_TOOLS")

# THE TRACE. With a trace the beat runs with --output-format stream-json and
# fleet-trace sits where tee was: it keeps every event in state/traces (0600,
# a directory the beat is granted no Read on, since a trace holds the
# untrusted text the beat read), prints a timeline to the journal, and writes
# to $beat_log only what text mode used to print - stderr, API errors and the
# final result. That last part is load-bearing: cti-budget classifies
# $beat_log by matching words like "429", "quota" and "billing", and token
# counts or tool output in front of it would turn ordinary beats into holds.
#
# Traces are best-effort. fleet-trace init proves the directory is writable
# and the interpreter runs BEFORE the beat; if it cannot, or traces are off,
# the beat runs exactly as it did before traces existed.
TRACE_TOOL="$FLEET_CODE/bin/fleet-trace"
TRACE=""
if [ "$CHECKIN_TRACE_DAYS" -gt 0 ] && [ -x "$TRACE_TOOL" ]; then
  if "$TRACE_TOOL" init >/dev/null 2>&1; then
    TRACE="$FLEET_HOME/state/traces/checkin-$(date '+%Y%m%dT%H%M%S').jsonl"
    [ -e "$TRACE" ] && TRACE="${TRACE%.jsonl}-$$.jsonl"
  else
    echo "[run-checkin $(date '+%F %H:%M:%S')] trace: off - fleet-trace init failed; beat runs in text mode" >&2
  fi
fi

if [ -n "$TRACE" ]; then
  "$CLAUDE" ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"} --output-format stream-json --verbose \
    < /dev/null 2>&1 \
    | "$TRACE_TOOL" tee --out "$TRACE" --plain "$beat_log" --max-mb "$CHECKIN_TRACE_MAX_MB"
  # One statement, so both are read from the same pipeline.
  rc="${PIPESTATUS[0]}" trace_rc="${PIPESTATUS[1]}"
  if [ "$trace_rc" -ne 0 ]; then
    echo "[run-checkin $(date '+%F %H:%M:%S')] trace: fleet-trace exited $trace_rc; the trace may be incomplete" >&2
  fi
  "$TRACE_TOOL" prune --days "$CHECKIN_TRACE_DAYS" >/dev/null 2>&1 || true
else
  "$CLAUDE" ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"} < /dev/null 2>&1 | tee "$beat_log"
  rc="${PIPESTATUS[0]}"
fi
set -e
echo "[run-checkin $(date '+%F %H:%M:%S')] beat finished rc=$rc"

# Did the beat do more than a beat does? Two signals, both read here and not by
# the model: a limit the guard enforced (the counter file's "tripped" list), and
# the board growing by more than CHECKIN_MAX_BOARD_GROWTH lines (default 8; a
# beat that prunes can only shrink it). The first trip of a day is a board line
# and a journal line; the second sends the operator one email, and a third or
# fourth sends nothing more, so a stuck beat cannot flood the inbox.
anomaly=""
counts_file="$BEAT_COUNTS_DIR/$CHECKIN_BEAT_ID.json"
if [ -f "$counts_file" ]; then
  anomaly="$(/usr/bin/python3 -I - "$counts_file" <<'PY' 2>/dev/null || echo "the beat's counter file could not be read"
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    t = [x for x in (d.get("tripped") or []) if isinstance(x, str)]
    if t:
        print("limit reached for " + ", ".join(t))
except Exception:
    print("the beat's counter file could not be read")
PY
)"
fi
# A beat that finished but left no counts file means the guard could not keep
# its counter (and so refused every call): that is not a quiet beat.
if [ "$rc" -eq 0 ] && [ ! -f "$counts_file" ]; then
  anomaly="${anomaly:+$anomaly; }no call counts were recorded for this beat"
fi
board_after="$(wc -l < "$BEAT_BOARD" 2>/dev/null | tr -d ' ' || true)"
board_after="${board_after:-0}"
growth_max="${CHECKIN_MAX_BOARD_GROWTH:-8}"
case "$growth_max" in ''|*[!0-9]*) growth_max=8 ;; esac
if [ $((board_after - board_before)) -gt "$growth_max" ]; then
  anomaly="${anomaly:+$anomaly; }the board grew by $((board_after - board_before)) lines"
fi
if [ -n "$anomaly" ]; then
  echo "[run-checkin $(date '+%F %H:%M:%S')] ANOMALY: $anomaly (beat $CHECKIN_BEAT_ID)"
  "$FLEET_CODE/bin/fleet-board" post @you @operator INFO \
    "beat $CHECKIN_BEAT_ID went past a safety limit: $anomaly" 2>/dev/null || true
  trips="$FLEET_HOME/state/checkin-trips"
  today="$(date +%F)"
  echo "$today" >> "$trips" 2>/dev/null || true
  if [ -f "$trips" ]; then
    tail -n 100 "$trips" > "$trips.tmp" 2>/dev/null && mv "$trips.tmp" "$trips" 2>/dev/null || true
    trips_today="$(grep -c "^$today\$" "$trips" 2>/dev/null || true)"
    emailed_marker="$FLEET_HOME/state/checkin-trips-emailed"
    if [ "${trips_today:-0}" -ge 2 ] && [ "$(cat "$emailed_marker" 2>/dev/null || true)" != "$today" ] \
        && [ -x "$FLEET_CODE/bin/cti-alert" ]; then
      echo "$today" > "$emailed_marker" 2>/dev/null || true
      "$FLEET_CODE/bin/cti-alert" --unit cti-agent-checkin.service --for-real --kind HOLD \
        --reason "The orchestrator went past one of its own safety limits twice today ($anomaly). It was stopped from making more calls, and nothing it did leaves the box except what the limits allow. If you do nothing the next beat starts fresh. Detail: the board line from the latest beat, and the journal for checkin-bash-guard." \
        || true
    fi
  fi
fi

if [ -x "$BUDGET" ]; then
  # Only beats that actually reached the model count against the ceilings.
  # tail -c bounds what a runaway transcript can push through argv.
  record_out="$("$BUDGET" record --exit "$rc" \
    --output "$(tail -c 4000 "$beat_log" 2>/dev/null || true)" \
    --note "checkin" 2>&1)" && record_rc=0 || record_rc=$?

  # rc 4: the account is out of credit. That is a HOLD, not a FAILURE.
  #
  # This is the 24 September outage. "Credit balance is too low" was
  # classified as a script error, systemd saw exit 1 and marked the unit
  # failed, OnFailure mailed "FAILED", and the operator did the sensible
  # thing with a broken lane - disabled the timer. Six days of silence
  # followed, undetectable because a disabled timer cannot fail.
  #
  # Exiting 0 here is the same judgement as the budget brake above: a
  # correctly-reported hold is not a failed unit. It is not silent either -
  # it posts to the board and escalates once. cti-budget has already set a
  # six-hour cooldown, so the next beats are stopped by the gate before they
  # ever reach the CLI, and that path has its own alert dedupe.
  if [ "$record_rc" -eq 4 ]; then
    reason="$(echo "$record_out" | tr '\n' ' ')"
    echo "[run-checkin $(date '+%F %H:%M:%S')] HOLD: $reason"
    "$FLEET_CODE/bin/fleet-board" post @you @operator INFO \
      "heartbeat held - $reason" 2>/dev/null || true
    if [ -x "$FLEET_CODE/bin/cti-alert" ]; then
      "$FLEET_CODE/bin/cti-alert" --unit cti-agent-checkin.service \
        --for-real --kind HOLD --reason "$reason" || true
    fi
    exit 0
  fi
fi

exit "$rc"
