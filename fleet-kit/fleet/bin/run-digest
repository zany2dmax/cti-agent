#!/usr/bin/env bash
# run-digest [daily|weekly] [--dry-run]
#
# The deterministic pipeline: ingest -> enrich -> brief -> send.
# systemd calls this so delivery never depends on the orchestrator noticing the
# clock. The orchestrator's /checkin does the judgment work; this does the
# guaranteed work. Idempotent - it refuses to send twice for the same window.
set -euo pipefail

KIND="${1:-daily}"
DRY=""
[ "${2:-}" = "--dry-run" ] && DRY="--dry-run"

FLEET_HOME="${FLEET_HOME:-$HOME/fleet}"

# Code, config and state are not necessarily the same directory. The simple
# layout puts all three under ~/fleet; the FHS layout used on Fedora splits
# them: code in /opt/cti-agent, config in /etc/cti-agent, state in
# /var/lib/cti-agent. Each has its own override and defaults to FLEET_HOME.
FLEET_ENV="${FLEET_ENV:-$FLEET_HOME/fleet.env}"
FLEET_CODE="${FLEET_CODE:-$FLEET_HOME}"

# Layout variables belong to whoever launched us - the systemd unit or the
# cti-agent wrapper - not to fleet.env. Sourcing with `set -a` assigns
# unconditionally, so a stale FLEET_HOME in the config file silently replaced
# the correct one and the pipeline then tried to write under a path it does
# not own. Remember what was injected, source, then put it back.
_inj_home="${FLEET_HOME:-}"; _inj_code="${FLEET_CODE:-}"
_inj_feeds="${FLEET_FEEDS:-}"
set -a; [ -f "$FLEET_ENV" ] && . "$FLEET_ENV"; set +a
[ -n "$_inj_home" ]  && FLEET_HOME="$_inj_home"
[ -n "$_inj_code" ]  && FLEET_CODE="$_inj_code"
[ -n "$_inj_feeds" ] && FLEET_FEEDS="$_inj_feeds"
export FLEET_HOME FLEET_CODE
# Only reachable when nothing injected one and fleet.env did not set one.
FLEET_CODE="${FLEET_CODE:-$FLEET_HOME}"

DAY=$(date +%F)
RAW="$FLEET_HOME/reports/raw-$DAY.md"
ENRICHED="$FLEET_HOME/state/enriched-$DAY.json"
HTML="$FLEET_HOME/reports/digest-$KIND-$DAY.html"
TXT="$FLEET_HOME/reports/digest-$KIND-$DAY.txt"
BOARD="$FLEET_CODE/bin/fleet-board"
DB="$FLEET_CODE/bin/fleet-db"

mkdir -p "$FLEET_HOME"/{reports,state,logs}
say() { echo "[run-digest $(date '+%H:%M:%S')] $*"; }
fail() { say "FAILED: $*"; "$BOARD" post @brief @you ERROR "run-digest $KIND failed: $*" || true; exit 1; }

# Do not double-send. A duplicate 6am digest trains people to ignore it.
if [ -z "$DRY" ] && [ "$("$DB" was-sent "$DAY" "$KIND" 2>/dev/null || echo no)" = "yes" ]; then
  say "$KIND digest already sent for $DAY - nothing to do"; exit 0
fi

# ── 1. ingest ────────────────────────────────────────────────────────────────
say "ingest: reading $GRAPH_MAILBOX"
if [ -x "${CTI_AGENT_DIR:-}/cti-agent" ]; then
  ( cd "$CTI_AGENT_DIR" && REPORT_PATH="$RAW" ./cti-agent ) \
    || fail "cti-agent exited non-zero (check Graph auth and Qualys creds)"
elif [ -d "${CTI_AGENT_DIR:-}" ]; then
  ( cd "$CTI_AGENT_DIR" && REPORT_PATH="$RAW" go run ./cmd/cti-agent ) \
    || fail "go run failed"
else
  fail "CTI_AGENT_DIR not set or not found"
fi
[ -s "$RAW" ] || fail "no report written to $RAW"
say "ingest: $(grep -c '^| CVE-' "$RAW" || true) CVE rows"

# ── 2. enrich ────────────────────────────────────────────────────────────────
say "enrich: NVD + EPSS + KEV"
python3 "$FLEET_CODE/lanes/enrich.py" --report "$RAW" --out "$ENRICHED" \
  || fail "enrich lane failed"

# ── 3. brief ─────────────────────────────────────────────────────────────────
say "brief: rendering $KIND"
python3 "$FLEET_CODE/lanes/brief.py" "--$KIND" \
  --enriched "$ENRICHED" --out "$HTML" --text-out "$TXT" || fail "brief lane failed"
SUBJECT=$(python3 "$FLEET_CODE/lanes/brief.py" "--$KIND" --subject-only --enriched "$ENRICHED")

# ── 4. send ──────────────────────────────────────────────────────────────────
say "send: $SUBJECT"
RESULT=$(python3 "$FLEET_CODE/lanes/mailer.py" --html "$HTML" --text "$TXT" \
           --subject "$SUBJECT" --attach "$RAW" $DRY) || fail "send failed"
echo "$RESULT"

# ── 5. log ───────────────────────────────────────────────────────────────────
if [ -z "$DRY" ]; then
  read -r S5 S4 S3 S2 S1 < <(python3 -c "
import json,sys
c=json.load(open('$ENRICHED'))['counts']
print(c['Sev5'],c['Sev4'],c['Sev3'],c['Sev2'],c['Sev1'])")
  MID=$(printf '%s' "$RESULT" | python3 -c "import json,sys;print(json.load(sys.stdin).get('request_id','unknown'))" 2>/dev/null || echo unknown)
  "$DB" sent "$DAY" "$S5" "$S4" "$S3" "$S2" "$S1" "$MID" "$KIND"
  "$BOARD" post @brief @you INFO "$KIND digest sent: Sev5=$S5 Sev4=$S4 Sev3=$S3 Sev2=$S2 Sev1=$S1 ($SUBJECT)"
  say "done - Sev5=$S5 Sev4=$S4 Sev3=$S3 Sev2=$S2 Sev1=$S1"
else
  "$BOARD" post @brief @you INFO "DRY RUN $KIND digest ready at $HTML"
  say "dry run complete - $HTML"
fi
