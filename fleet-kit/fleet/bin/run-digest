#!/usr/bin/env bash
# run-digest [daily|weekly] [--dry-run]
#
# The deterministic pipeline: ingest -> enrich -> brief -> send.
# systemd calls this so delivery never depends on the orchestrator noticing the
# clock. The orchestrator's /checkin does the judgment work; this does the
# guaranteed work. Idempotent - it refuses to send twice for the same window.
set -euo pipefail

# Parsed in a loop rather than positionally. The old form was
#   KIND="${1:-daily}"; [ "${2:-}" = "--dry-run" ] && DRY="--dry-run"
# which silently ignored --dry-run in any other position - so
# `run-digest --dry-run daily` SENT MAIL while looking like a rehearsal.
KIND=""
DRY=""
LOOKBACK=""
while [ $# -gt 0 ]; do
  case "$1" in
    daily|weekly)  KIND="$1"; shift ;;
    --dry-run)     DRY="--dry-run"; shift ;;
    # A catch-up window for the morning after the lane was off. Passed to the
    # ingest binary; it cannot go through the environment because the
    # cti-agent wrapper hops to the service account with a fixed
    # --preserve-env list and strips everything else.
    --lookback)    LOOKBACK="$2"; shift 2 ;;
    --lookback=*)  LOOKBACK="${1#*=}"; shift ;;
    *) echo "[run-digest] unknown argument: $1" >&2
       echo "usage: run-digest [daily|weekly] [--dry-run] [--lookback 168h]" >&2
       exit 2 ;;
  esac
done
KIND="${KIND:-daily}"

FLEET_HOME="${FLEET_HOME:-$HOME/fleet}"

# Code, config and state are not necessarily the same directory. The simple
# layout puts all three under ~/fleet; the FHS layout used on Fedora splits
# them: code in /opt/cti-agent, config in /etc/cti-agent, state in
# /var/lib/cti-agent. Each has its own override and defaults to FLEET_HOME.
FLEET_ENV="${FLEET_ENV:-$FLEET_HOME/fleet.env}"
FLEET_CODE="${FLEET_CODE:-$FLEET_HOME}"

# Layout variables belong to whoever launched us - the systemd unit or the
# cti-agent wrapper - not to fleet.env. Sourcing with `set -a` assigns
# unconditionally, so a stale FLEET_HOME in the config file silently replaced
# the correct one and the pipeline then tried to write under a path it does
# not own. Remember what was injected, source, then put it back.
_inj_home="${FLEET_HOME:-}"; _inj_code="${FLEET_CODE:-}"
_inj_feeds="${FLEET_FEEDS:-}"
set -a; [ -f "$FLEET_ENV" ] && . "$FLEET_ENV"; set +a
[ -n "$_inj_home" ]  && FLEET_HOME="$_inj_home"
[ -n "$_inj_code" ]  && FLEET_CODE="$_inj_code"
[ -n "$_inj_feeds" ] && FLEET_FEEDS="$_inj_feeds"
export FLEET_HOME FLEET_CODE
# Only reachable when nothing injected one and fleet.env did not set one.
FLEET_CODE="${FLEET_CODE:-$FLEET_HOME}"

DAY=$(date +%F)
RAW="$FLEET_HOME/reports/raw-$DAY.md"
ENRICHED="$FLEET_HOME/state/enriched-$DAY.json"
HTML="$FLEET_HOME/reports/digest-$KIND-$DAY.html"
TXT="$FLEET_HOME/reports/digest-$KIND-$DAY.txt"
BOARD="$FLEET_CODE/bin/fleet-board"
DB="$FLEET_CODE/bin/fleet-db"

mkdir -p "$FLEET_HOME"/{reports,state,logs}
say() { echo "[run-digest $(date '+%H:%M:%S')] $*"; }
fail() { say "FAILED: $*"; "$BOARD" post @brief @you ERROR "run-digest $KIND failed: $*" || true; exit 1; }

# Do not double-send. A duplicate 6am digest trains people to ignore it.
if [ -z "$DRY" ] && [ "$("$DB" was-sent "$DAY" "$KIND" 2>/dev/null || echo no)" = "yes" ]; then
  say "$KIND digest already sent for $DAY - nothing to do"; exit 0
fi

# ── 1. ingest, OR roll up stored findings ────────────────────────────────────
#
# THE WEEKLY DOES NOT READ THE MAILBOX.
#
# It used to, and it was never a week. cti-agent-weekly.service runs this with
# no --lookback, so the weekly read GRAPH_LOOKBACK_HOURS - the same 24 hours as
# the daily. On 2026-10-05 both briefs reported reading the same four emails,
# an hour apart.
#
# Widening the mailbox read to 168h does not fix it: the cleanup lane archives
# advisories once a completed run has read them, on a 48-hour grace, so a 7-day
# mailbox query sees only what happened not to be archived yet. That is a
# partial week presented as a whole one - silently wrong, and worse than the
# honest 24 hours it produced before.
#
# Stored findings have neither problem. They are what the fleet concluded, they
# outlive the mail they came from, and rolling them up is immune to the archive
# grace. The weekly is a rollup; it was only ever an ingest by accident.
if [ "$KIND" = weekly ]; then
  DAYS="${WEEKLY_DAYS:-7}"
  say "rollup: $DAYS days of stored findings (no mailbox read)"
  "$DB" rollup --days "$DAYS" > "$ENRICHED" \
    || fail "fleet-db rollup failed - is the findings table populated?"
  [ -s "$ENRICHED" ] || fail "rollup produced nothing at $ENRICHED"
  say "rollup: $(python3 -c "import json,sys;print(json.load(open('$ENRICHED'))['total'])" 2>/dev/null || echo '?') finding(s) in the window"
else

say "ingest: reading $GRAPH_MAILBOX"
if [ -x "${CTI_AGENT_DIR:-}/cti-agent" ]; then
  ( cd "$CTI_AGENT_DIR" && REPORT_PATH="$RAW" ./cti-agent ${LOOKBACK:+--lookback "$LOOKBACK"} ) \
    || fail "cti-agent exited non-zero (check Graph auth and Qualys creds)"
elif [ -d "${CTI_AGENT_DIR:-}" ]; then
  ( cd "$CTI_AGENT_DIR" && REPORT_PATH="$RAW" go run ./cmd/cti-agent ${LOOKBACK:+--lookback "$LOOKBACK"} ) \
    || fail "go run failed"
else
  fail "CTI_AGENT_DIR not set or not found"
fi
[ -s "$RAW" ] || fail "no report written to $RAW"
say "ingest: $(grep -c '^| CVE-' "$RAW" || true) CVE rows"

# ── 2. enrich ────────────────────────────────────────────────────────────────
#
# Inside the else: the rollup is already enriched. Those findings were scored
# when they were first ingested, and re-enriching them would spend several
# hundred NVD and scanner calls to recompute numbers already on disk.
say "enrich: NVD + EPSS + KEV"
python3 "$FLEET_CODE/lanes/enrich.py" --report "$RAW" --out "$ENRICHED" \
  || fail "enrich lane failed"

fi

# ── 2b. ticket ───────────────────────────────────────────────────────────────
# Files or updates one Jira ticket per confirmed KEV or Sev5 CVE, and writes a
# cve -> ticket map that brief.py reads in the next step. Hence the position:
# after enrich because it needs the findings, before brief because the keys
# must exist by the time the email is rendered.
#
# EVERY FAILURE HERE IS NON-FATAL, and that is the whole design constraint of
# putting it in this pipeline. This lane now sits between the fleet and its
# daily security email, so a Jira outage, an expired API token or a project
# permission change must cost tickets and nothing else. cti-jira exits 0 on
# its own internal failures; `|| true` covers the ones it cannot catch, like
# the binary being absent on an older install.
#
# It is skipped entirely on a dry run. A --dry-run that silently files real
# tickets would be the same class of mistake as the dropped --dry-run that
# sent a real digest in September, with a longer cleanup.
# Daily only. The weekly reports findings that were already ticketed when the
# daily first saw them; running this again would add a comment to every open
# ticket every Monday for no new information.
JIRA="$FLEET_CODE/bin/cti-jira"
if [ "$KIND" = weekly ]; then
  say "ticket: skipped - the weekly reports findings the daily already filed"
elif [ -z "$DRY" ] && [ -x "$JIRA" ]; then
  say "ticket: filing KEV and Sev5 findings"
  "$JIRA" --from-enriched "$ENRICHED" --for-real || true
elif [ -n "$DRY" ] && [ -x "$JIRA" ]; then
  say "ticket: dry run, nothing will be filed"
  "$JIRA" --from-enriched "$ENRICHED" || true
fi

# ── 3. brief ─────────────────────────────────────────────────────────────────
say "brief: rendering $KIND"
python3 "$FLEET_CODE/lanes/brief.py" "--$KIND" \
  --enriched "$ENRICHED" --out "$HTML" --text-out "$TXT" || fail "brief lane failed"
SUBJECT=$(python3 "$FLEET_CODE/lanes/brief.py" "--$KIND" --subject-only --enriched "$ENRICHED")

# ── 4. send ──────────────────────────────────────────────────────────────────
say "send: $SUBJECT"
RESULT=$(python3 "$FLEET_CODE/lanes/mailer.py" --html "$HTML" --text "$TXT" \
           --subject "$SUBJECT" --attach "$RAW" $DRY) || fail "send failed"
echo "$RESULT"

# ── 5. log ───────────────────────────────────────────────────────────────────
if [ -z "$DRY" ]; then
  read -r S5 S4 S3 S2 S1 < <(python3 -c "
import json,sys
c=json.load(open('$ENRICHED'))['counts']
print(c['Sev5'],c['Sev4'],c['Sev3'],c['Sev2'],c['Sev1'])")
  MID=$(printf '%s' "$RESULT" | python3 -c "import json,sys;print(json.load(sys.stdin).get('request_id','unknown'))" 2>/dev/null || echo unknown)
  "$DB" sent "$DAY" "$S5" "$S4" "$S3" "$S2" "$S1" "$MID" "$KIND"
  "$BOARD" post @brief @you INFO "$KIND digest sent: Sev5=$S5 Sev4=$S4 Sev3=$S3 Sev2=$S2 Sev1=$S1 ($SUBJECT)"
  say "done - Sev5=$S5 Sev4=$S4 Sev3=$S3 Sev2=$S2 Sev1=$S1"
else
  "$BOARD" post @brief @you INFO "DRY RUN $KIND digest ready at $HTML"
  say "dry run complete - $HTML"
fi
