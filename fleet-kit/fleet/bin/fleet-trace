#!/usr/bin/python3 -sE
"""fleet-trace - keep and read a record of what each heartbeat did, and what
each model call in the fleet cost.

  fleet-trace init                    create the trace directory (0700)
  fleet-trace tee --out FILE --plain FILE [--max-mb N] [--keep minimal|full]
                                      read a beat's stream-json on stdin: keep
                                      its events in --out (by default without
                                      the content the beat read; --keep full
                                      keeps everything), print a timeline for
                                      the journal, write the beat's plain text
                                      (what cti-budget classifies) to --plain
  fleet-trace unwrap --result FILE [--trace FILE]
                                      read one `claude -p --output-format json`
                                      reply on stdin: write the model's answer
                                      to --result, and add what the call cost
                                      (never its text) to --trace
  fleet-trace show [FILE | --last] [--full]
                                      print one beat as a timeline
  fleet-trace list [-n N]             the latest traces, one line each, with
                                      what they cost and a total
  fleet-trace prune --days N          delete traces older than N days

Traces live in $FLEET_HOME/state/traces, 0600 in a 0700 directory.

What a trace keeps (--keep, CHECKIN_TRACE_KEEP in run-checkin). By default
MINIMAL, and by ALLOWLIST: what the model wrote, every tool call and its
arguments, what was denied, the turns, tokens, cost and the final result. A tool
result (a mail body, an advisory, a report) is replaced by its size and the first
16 characters of its SHA-256, so "what did it look at" is answerable and the
trace is not a second copy of the mailbox. So is anything in an event shape this
program does not know (an auto-compact summary, hook or MCP output, a server-side
tool result, private reasoning): kept only as what it weighed. What IS still in
a minimal trace, and can quote mail: the model's own words, the arguments of each
call, the first 300 characters of a failed call (a refusal's reason, and a failed
command's output), and stray stderr (2,000 characters a line). FULL keeps every
event as it came, for an investigation: untrusted advisory and mail text then
sits in the trace, so it is handled like a report: never mailed, never committed,
and not readable by the beat itself (run-checkin grants no Read on state/). A
trace is also deleted after CHECKIN_TRACE_DAYS.

Why --plain exists. cti-budget tells "the quota refused us" from "the account
is out of credit" from "the script broke" by matching words such as "429",
"quota" and "billing" in the beat's output. Before traces that output was the
CLI's text mode: the final answer and any error. Handing it the timeline or
the raw stream instead would put token counts and tool output in front of the
classifier, and an advisory that mentions billing, or a beat that used 4290
tokens, would read as a hold. So --plain gets exactly what text mode printed:
lines that are not JSON (stderr), API error messages, and the result text.

Why unwrap exists. The heartbeat is not the only lane that calls Claude:
run-supplier shows each new supplier request to a no-tools model. It used text
mode, so what those calls cost was recorded nowhere and `list` showed the
heartbeat's spend as if it were the fleet's. unwrap lets the lane ask for JSON,
hands the lane the same answer text mode gave, and keeps the cost in a
supplier-<timestamp>.jsonl trace - usage and cost only, because the answer
talks about untrusted supplier mail and the cost is all `list` needs.

This program never stops reading stdin. If it exited early, claude would die
of SIGPIPE in the middle of a beat; so a failure to write the trace stops the
trace, not the reading.
"""
import hashlib
import json
import math
import os
import re
import stat
import sys
import time

FLEET_HOME = os.environ.get("FLEET_HOME", os.path.expanduser("~/fleet"))
TRACE_DIR = os.path.join(FLEET_HOME, "state", "traces")
# checkin- is a heartbeat; supplier- is one run of the supplier lane.
NAME = re.compile(r"^(checkin|supplier)-(\d{8}T\d{6})(-\d+)?\.jsonl$")
UNITS = ("checkin", "supplier")

# Untrusted text reaches the operator's terminal through `show`. Anything that
# is not printable - ANSI escapes above all, which can rewrite what the screen
# says - is replaced, and newlines are flattened where one line is expected.
_CTRL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f\u200b-\u200f\u202a-\u202e\u2066-\u2069]")


def clean(text, limit=None, oneline=True):
    text = "" if text is None else str(text)
    if oneline:
        text = " ".join(text.split())
    text = _CTRL.sub("?", text)
    if limit is not None and len(text) > limit:
        text = text[:limit] + f"... [{len(text) - limit} more chars]"
    return text


USAGE = __doc__.split("\n\n")[1]


def usage(msg=None):
    if msg:
        print(f"fleet-trace: {msg}", file=sys.stderr)
    print("usage:\n" + USAGE, file=sys.stderr)
    sys.exit(2)


# -- rendering ---------------------------------------------------------------

def tool_summary(name, inp):
    """The one argument that says what a tool call was for."""
    if not isinstance(inp, dict):
        return ""
    for key in ("command", "file_path", "path", "pattern", "skill", "url", "query"):
        if key in inp:
            return str(inp[key])
    return ",".join(sorted(inp))


REDACTED = "fleet_trace_redacted"


def _chars(c):
    """Characters one content block stands for (a redacted block remembers)."""
    if c.get("type") == REDACTED:
        n = c.get("chars")
        return n if isinstance(n, int) and n >= 0 else 0
    return len(str(c.get("text") or ""))


def result_size(content):
    if isinstance(content, str):
        return len(content)
    if isinstance(content, list):
        return sum(_chars(c) for c in content if isinstance(c, dict))
    return 0


def result_text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        out = []
        for c in content:
            if not isinstance(c, dict):
                continue
            if c.get("type") == REDACTED:
                out.append(f"[content not kept: {_chars(c)} chars, sha256 {clean(c.get('sha256'), 16)}]")
            else:
                out.append(str(c.get("text") or ""))
        return "\n".join(out)
    return ""


def _redacted(text):
    """What stands in for content the trace does not keep: its size, and a
    short hash, so two traces can be told to have seen the same thing."""
    text = "" if text is None else str(text)
    return {"type": REDACTED, "chars": len(text),
            "sha256": hashlib.sha256(text.encode("utf-8", "replace")).hexdigest()[:16]}


# What the default trace keeps, by allowlist. Everything else in an event is
# replaced by its size and a short hash, so a shape this code has not seen (an
# auto-compact summary, MCP or hook output, a server-side tool result, a new
# key on an old block) is not kept by default. Redacting by denylist would keep
# exactly what nobody thought of.
_KEEP_TOP = ("type", "subtype", "uuid", "session_id", "parent_tool_use_id", "timestamp", "isSidechain",
             "is_api_error_message", "error")
_KEEP_MSG = ("role", "model", "id", "stop_reason", "usage")
_KEEP_INIT = ("model", "tools", "mcp_servers", "permissionMode", "apiKeySource", "claude_code_version", "cwd")


def _stub(value):
    return _redacted(json.dumps(value, ensure_ascii=False, sort_keys=True, default=str))


def _block(b, etype):
    """One content block of a user or assistant message, as the default trace
    keeps it."""
    if not isinstance(b, dict):
        return _stub(b)
    kind = b.get("type")
    if etype == "user" and kind == "tool_result":
        text = result_text(b.get("content"))
        kept = {k: b[k] for k in ("type", "tool_use_id") if k in b}
        # A refusal's reason is what an operator needs; a success's content is
        # somebody's mail. Only an is_error of exactly true counts as a failure.
        if b.get("is_error") is True:
            kept["is_error"] = True
            kept["content"] = clean(text, 300)
        else:
            kept["is_error"] = False
            kept["content"] = [_redacted(text)]
        return kept
    if etype == "assistant" and kind == "text":
        return {"type": "text", "text": b.get("text") if isinstance(b.get("text"), str) else ""}
    if etype == "assistant" and kind == "tool_use":
        return {k: b[k] for k in ("type", "id", "name", "input") if k in b}
    # Everything else (thinking, a string, text in a user turn, server tool
    # results, anything new) is kept as what it weighed.
    return {**_stub(b), "was": kind if isinstance(kind, str) else "unknown"}


def minimize(ev):
    """The event as the default trace keeps it: the decision and the cost, not
    the content the beat read. An allowlist: see the module docstring."""
    etype = ev.get("type")
    if etype in ("result", "fleet_trace", "fleet_trace_text"):
        return ev  # the verdict and cost, and this program's own records
    if etype == "system":
        keep = {k: ev[k] for k in _KEEP_TOP if k in ev}
        if ev.get("subtype") == "init":
            keep.update({k: ev[k] for k in _KEEP_INIT if k in ev})
        else:
            keep["detail"] = _stub({k: v for k, v in ev.items() if k not in _KEEP_TOP})
        return keep
    if etype in ("user", "assistant"):
        out = {k: ev[k] for k in _KEEP_TOP if k in ev}
        msg = ev.get("message")
        if isinstance(msg, dict):
            m = {k: msg[k] for k in _KEEP_MSG if k in msg}
            content = msg.get("content")
            if isinstance(content, list):
                m["content"] = [_block(b, etype) for b in content]
            elif content is not None:
                m["content"] = [_stub(content)]  # a bare string: a prompt or a compaction summary
            out["message"] = m
        # Every other key (tool_use_result, toolUseResult, structured output,
        # hook output, anything new) is kept only as what it weighed.
        extra = {k: v for k, v in ev.items() if k not in _KEEP_TOP and k != "message"}
        if extra:
            out["extra"] = _stub(extra)
        return out
    return {"type": etype if isinstance(etype, str) else "unknown", "detail": _stub(ev)}


class Timeline:
    """Turns stream-json events into lines a person reads.

    Tool results are shown as a size and ok/ERROR, not their content: the
    content is untrusted text and the journal is read by more people than
    the trace. --full on `show` prints it, sanitized.
    """

    def __init__(self, out, full=False):
        self.out = out
        self.full = full
        self.turn = 0
        self.tools = {}

    def line(self, text):
        self.out.write(f"[trace] {text}\n")

    def event(self, ev):
        t = ev.get("type")
        if t == "fleet_trace":
            if ev.get("truncated"):
                self.line(f"trace truncated at {ev.get('max_bytes')} bytes; the beat went on")
            return
        if t == "fleet_trace_text":
            self.line(f"stderr: {clean(ev.get('text'), 300)}")
            return
        if t == "system" and ev.get("subtype") == "init":
            mcp = ev.get("mcp_servers") or []
            self.line(f"start: model {clean(ev.get('model'))}, "
                      f"{len(ev.get('tools') or [])} tools, {len(mcp)} MCP servers, "
                      f"permission mode {clean(ev.get('permissionMode'))}, "
                      f"auth {clean(ev.get('apiKeySource'))}, "
                      f"claude {clean(ev.get('claude_code_version'))}")
            return
        if t == "assistant":
            msg = ev.get("message") or {}
            if ev.get("is_api_error_message"):
                self.line(f"API ERROR ({clean(ev.get('error'))}): "
                          f"{clean(result_text(msg.get('content')), 300)}")
                return
            self.turn += 1
            for block in msg.get("content") or []:
                if not isinstance(block, dict):
                    continue
                if block.get("type") == "text" and block.get("text", "").strip():
                    self.line(f"turn {self.turn} says: {clean(block['text'], 300)}")
                elif block.get("type") == "tool_use":
                    name = clean(block.get("name"))
                    self.tools[block.get("id")] = name
                    self.line(f"turn {self.turn} tool {name}: "
                              f"{clean(tool_summary(name, block.get('input')), 200)}")
            return
        if t == "user":
            content = (ev.get("message") or {}).get("content")
            for block in content if isinstance(content, list) else []:
                if not isinstance(block, dict) or block.get("type") != "tool_result":
                    continue
                name = self.tools.get(block.get("tool_use_id"), "?")
                c = block.get("content")
                if block.get("is_error"):
                    self.line(f"  {name} -> ERROR: {clean(result_text(c), 200)}")
                else:
                    self.line(f"  {name} -> ok, {result_size(c)} chars")
                if self.full:
                    for l in clean(result_text(c), 4000, oneline=False).splitlines():
                        self.out.write(f"        | {l}\n")
            return
        if t == "result":
            u = ev.get("usage") or {}
            denials = ev.get("permission_denials") or []
            status = "ERROR" if ev.get("is_error") else "ok"
            reason = ev.get("terminal_reason") or ev.get("subtype")
            cost = ev.get("total_cost_usd")
            self.line(f"end: {status} ({clean(reason)}), {ev.get('num_turns')} turns, "
                      f"{(ev.get('duration_ms') or 0) / 1000:.0f}s, "
                      f"tokens in {u.get('input_tokens', 0)} + cache read "
                      f"{u.get('cache_read_input_tokens', 0)} + cache write "
                      f"{u.get('cache_creation_input_tokens', 0)}, out "
                      f"{u.get('output_tokens', 0)}"
                      + (f", ${cost:.4f}" if isinstance(cost, (int, float)) else "")
                      + f", {len(denials)} denied")
            for d in denials:
                if isinstance(d, dict):
                    self.line(f"  DENIED {clean(d.get('tool_name'))}: "
                              f"{clean(tool_summary(d.get('tool_name'), d.get('tool_input')), 200)}")
            return


def plain_lines(ev, raw):
    """What text mode would have printed for this line - see the docstring."""
    if ev is None:
        return [raw]
    if ev.get("type") == "assistant" and ev.get("is_api_error_message"):
        out = []
        if ev.get("error"):
            out.append(f"API error: {ev['error']}")
        text = result_text((ev.get("message") or {}).get("content"))
        if text:
            out.append(text)
        return out
    if ev.get("type") == "result" and isinstance(ev.get("result"), str):
        return [ev["result"]]
    return []


def parse(raw):
    try:
        ev = json.loads(raw)
    except ValueError:
        return None
    return ev if isinstance(ev, dict) else None


# -- subcommands -------------------------------------------------------------

def cmd_init(args):
    if args:
        usage("init takes no arguments")
    os.makedirs(TRACE_DIR, mode=0o700, exist_ok=True)
    if os.path.islink(TRACE_DIR) or not os.path.isdir(TRACE_DIR):
        print(f"fleet-trace: {TRACE_DIR} is not a directory", file=sys.stderr)
        sys.exit(1)
    os.chmod(TRACE_DIR, 0o700)
    # A real write, so a full or read-only disk turns traces off before the
    # beat rather than during it.
    probe = os.path.join(TRACE_DIR, f".probe-{os.getpid()}")
    with open(os.open(probe, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as f:
        f.write("ok\n")
    os.unlink(probe)
    print(TRACE_DIR)


def _open_new(path):
    """0600, and never through a link or onto a file that is already there."""
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
    return os.fdopen(os.open(path, flags, 0o600), "wb")


def cmd_tee(args):
    out_path = plain_path = None
    max_mb = 20
    keep_mode = "minimal"
    it = iter(args)
    for a in it:
        if a == "--out":
            out_path = next(it, None)
        elif a == "--plain":
            plain_path = next(it, None)
        elif a == "--max-mb":
            v = next(it, "")
            if not v.isdigit() or int(v) < 1:
                usage("--max-mb takes a whole number of megabytes, 1 or more")
            max_mb = int(v)
        elif a == "--keep":
            keep_mode = next(it, "")
            if keep_mode not in ("minimal", "full"):
                usage("--keep takes minimal or full")
        else:
            usage(f"unknown argument {a!r}")
    if not out_path or not plain_path:
        usage("tee needs --out FILE and --plain FILE")
    max_bytes = max_mb * 1024 * 1024

    errors = []
    try:
        trace = _open_new(out_path)
    except OSError as e:
        trace = None
        errors.append(f"cannot create {out_path}: {e.strerror}")
    try:
        # --plain is run-checkin's mktemp file: it exists already, 0600.
        plain = open(plain_path, "w", encoding="utf-8", errors="replace")
    except OSError as e:
        plain = None
        errors.append(f"cannot write {plain_path}: {e.strerror}")

    written = 0

    def keep(line):
        """Append one JSON line to the trace, within --max-mb."""
        nonlocal trace, written
        if trace is None:
            return
        data = line.encode("utf-8") + b"\n"
        try:
            if written + len(data) > max_bytes:
                trace.write(json.dumps({"type": "fleet_trace", "truncated": True,
                                        "max_bytes": max_bytes}).encode() + b"\n")
                trace.close()
                trace = None
                errors.append(f"trace stopped at {max_mb} MB (--max-mb)")
                return
            trace.write(data)
            written += len(data)
        except OSError as e:
            errors.append(f"trace write failed: {e.strerror}; trace stopped")
            try:
                trace.close()
            except OSError:
                pass
            trace = None

    keep(json.dumps({"type": "fleet_trace", "version": 1, "unit": "checkin", "keep": keep_mode,
                     "started": time.strftime("%Y-%m-%dT%H:%M:%S%z")}))
    tl = Timeline(sys.stdout)
    for rawb in sys.stdin.buffer:
        raw = rawb.decode("utf-8", "replace").rstrip("\r\n")
        try:
            if not raw.strip():
                continue
            ev = parse(raw)
            # Every trace line is JSON, so a non-JSON line is wrapped.
            if ev is None:
                # Not JSON: stderr or a crash message. Capped in the default
                # trace, since it can echo what the beat was reading.
                text = raw if keep_mode == "full" else clean(raw, 2000, oneline=False)
                keep(json.dumps({"type": "fleet_trace_text", "text": text}, ensure_ascii=False))
            elif keep_mode == "full":
                keep(raw)
            else:
                try:
                    kept = minimize(ev)
                except Exception:  # noqa: BLE001 - a malformed event must still leave a record
                    kept = {"type": ev.get("type") if isinstance(ev.get("type"), str) else "unknown",
                            "fleet_trace_error": "malformed event, content not kept", "detail": _stub(raw)}
                keep(json.dumps(kept, ensure_ascii=False))
            if ev is None:
                # Not JSON: stderr or a crash message. Shown as it came,
                # because that is what the journal always showed.
                sys.stdout.write(raw + "\n")
            else:
                tl.event(ev)
            if plain is not None:
                for l in plain_lines(ev, raw):
                    plain.write(l + "\n")
            sys.stdout.flush()
        except Exception as e:  # noqa: BLE001 - never stop reading; see docstring
            errors.append(f"line skipped: {e.__class__.__name__}")
    for f in (trace, plain):
        if f is not None:
            try:
                f.close()
            except OSError:
                pass
    for e in dict.fromkeys(errors):
        print(f"fleet-trace: {e}", file=sys.stderr)
    if os.path.exists(out_path):
        print(f"[trace] kept in {out_path}")
    sys.exit(1 if errors else 0)


def _traces(unit=None):
    """Every trace, oldest first by the time in its name (not by name, which
    would put every heartbeat before every supplier run)."""
    try:
        names = os.listdir(TRACE_DIR)
    except OSError:
        return []
    out = []
    for n in names:
        m = NAME.match(n)
        p = os.path.join(TRACE_DIR, n)
        if m and (unit is None or m.group(1) == unit) and os.path.isfile(p) and not os.path.islink(p):
            out.append((m.group(2), m.group(3) or "", n, p))
    return [p for *_, p in sorted(out)]


def _events(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        for raw in f:
            ev = parse(raw)
            if ev is not None:
                yield ev


# What unwrap keeps of a reply: the numbers, never the text.
_USAGE_KEYS = ("input_tokens", "output_tokens", "cache_read_input_tokens",
               "cache_creation_input_tokens")
_RESULT_KEYS = ("subtype", "is_error", "num_turns", "duration_ms", "total_cost_usd")


def _cost_only(ev):
    out = {"type": "result"}
    for k in _RESULT_KEYS:
        v = ev.get(k)
        if isinstance(v, (bool, int, float)) or (k == "subtype" and isinstance(v, str)):
            out[k] = clean(v, 40) if k == "subtype" else v
    u = ev.get("usage")
    if isinstance(u, dict):
        out["usage"] = {k: u[k] for k in _USAGE_KEYS
                        if isinstance(u.get(k), int) and not isinstance(u.get(k), bool)}
    models = ev.get("modelUsage")
    if isinstance(models, dict):
        out["models"] = sorted(clean(m, 80) for m in models)[:5]
    return out


def _append(path, ev, unit):
    """Add one line to a trace: created 0600 with its header the first time,
    appended after that, never through a link."""
    # O_NONBLOCK: a FIFO planted at the path must not hang the lane.
    nofollow = getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | nofollow, 0o600)
        first = True
    except FileExistsError:
        fd = os.open(path, os.O_WRONLY | os.O_APPEND | nofollow)
        first = False
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        os.close(fd)
        raise OSError(0, "not a regular file")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        if first:
            f.write(json.dumps({"type": "fleet_trace", "version": 1, "unit": unit,
                                "started": time.strftime("%Y-%m-%dT%H:%M:%S%z")}) + "\n")
        f.write(json.dumps(ev) + "\n")


def cmd_unwrap(args):
    result_path = trace_path = None
    it = iter(args)
    for a in it:
        if a == "--result":
            result_path = next(it, None)
        elif a == "--trace":
            trace_path = next(it, None)
        else:
            usage(f"unknown argument {a!r}")
    if not result_path:
        usage("unwrap needs --result FILE")
    if trace_path is not None:
        m = NAME.match(os.path.basename(trace_path))
        if not m or m.group(1) == "checkin":
            usage("--trace must be named supplier-<YYYYMMDDTHHMMSS>.jsonl")

    raw = sys.stdin.buffer.read(16 * 1024 * 1024).decode("utf-8", "replace")
    ev = parse(raw.strip())
    if ev is None or ev.get("type") != "result":
        print("fleet-trace: the reply is not a claude JSON result", file=sys.stderr)
        sys.exit(1)

    # The cost is kept even when the answer is unusable: a failed call is
    # still billed. A trace that cannot be written costs the record, not the
    # judgement.
    if trace_path is not None:
        try:
            _append(trace_path, _cost_only(ev), "supplier")
        except OSError as e:
            print(f"fleet-trace: cost not recorded in {trace_path}: {e.strerror}", file=sys.stderr)

    answer = ev.get("result")
    if ev.get("is_error") or not isinstance(answer, str) or not answer.strip():
        why = clean(ev.get("subtype") or "no answer", 80)
        print(f"fleet-trace: the model returned no usable answer ({why})", file=sys.stderr)
        sys.exit(1)
    with _open_new(result_path) as f:
        f.write(answer.encode("utf-8"))


def cmd_show(args):
    full = "--full" in args
    rest = [a for a in args if a != "--full"]
    if rest == ["--last"] or not rest:
        # The newest heartbeat: a supplier run every morning must not hide the
        # beat an operator is looking for. Name a supplier trace to see one.
        traces = _traces("checkin")
        if not traces:
            print(f"fleet-trace: no traces in {TRACE_DIR}", file=sys.stderr)
            sys.exit(1)
        path = traces[-1]
    elif len(rest) == 1 and not rest[0].startswith("-"):
        path = rest[0]
        if os.sep not in path:
            path = os.path.join(TRACE_DIR, path)
    else:
        usage("show takes one FILE, or --last, and optionally --full")
    print(f"== {path}")
    tl = Timeline(sys.stdout, full=full)
    try:
        for ev in _events(path):
            tl.event(ev)
    except OSError as e:
        print(f"fleet-trace: cannot read {path}: {e.strerror}", file=sys.stderr)
        sys.exit(1)


def _summary(path):
    """What one trace adds up to, read from the end of the file: a heartbeat
    has one result event, a supplier run one per request it judged."""
    size = 0
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - 256 * 1024))
            tail = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return size, None
    results = [ev for ev in map(parse, tail) if ev and ev.get("type") == "result"]
    if not results:
        return size, None
    # The CLI writes these lines, but a malformed one must not stop `list`.
    costs = []
    for ev in results:
        c = ev.get("total_cost_usd")
        if isinstance(c, (int, float)) and not isinstance(c, bool):
            try:
                c = float(c)
            except OverflowError:
                continue
            if math.isfinite(c):
                costs.append(c)
    turns = [ev.get("num_turns") for ev in results]
    turns = [t for t in turns if isinstance(t, int) and not isinstance(t, bool)]
    return size, {
        "is_error": any(ev.get("is_error") for ev in results),
        "num_turns": sum(turns) if turns else "-",
        "permission_denials": [d for ev in results
                               if isinstance(ev.get("permission_denials"), list)
                               for d in ev["permission_denials"]],
        "total_cost_usd": sum(costs) if costs else None,
        "calls": len(results),
    }


def cmd_list(args):
    n = 10
    if args:
        if len(args) != 2 or args[0] != "-n" or not args[1].isdigit():
            usage("list takes -n N")
        n = int(args[1])
    traces = _traces()[-n:] if n else _traces()
    if not traces:
        print(f"(no traces in {TRACE_DIR})")
        return
    print(f"{'trace':<34} {'size':>8}  {'result':<6} {'calls':>5} {'turns':>5} {'denied':>6} {'cost':>9}")
    totals = {}
    for p in reversed(traces):
        size, ev = _summary(p)
        if ev is None:
            print(f"{os.path.basename(p):<34} {size:>8}  {'none':<6} {'-':>5} {'-':>5} {'-':>6} {'-':>9}")
            continue
        cost = ev.get("total_cost_usd")
        if cost is not None:
            unit = NAME.match(os.path.basename(p)).group(1)
            totals[unit] = totals.get(unit, 0.0) + cost
        print(f"{os.path.basename(p):<34} {size:>8}  "
              f"{'ERROR' if ev.get('is_error') else 'ok':<6} {ev['calls']:>5} {ev['num_turns']:>5} "
              f"{len(ev['permission_denials']):>6} "
              f"{(f'${cost:.4f}' if cost is not None else '-'):>9}")
    if totals:
        parts = ", ".join(f"{u} ${totals[u]:.4f}" for u in UNITS if u in totals)
        print(f"total for the {len(traces)} listed: ${sum(totals.values()):.4f} ({parts})")


def cmd_prune(args):
    if len(args) != 2 or args[0] != "--days" or not args[1].isdigit():
        usage("prune takes --days N")
    days = int(args[1])
    cutoff = time.time() - days * 86400
    removed = 0
    for p in _traces():
        try:
            if os.lstat(p).st_mtime < cutoff:
                os.unlink(p)
                removed += 1
        except OSError:
            pass
    print(f"fleet-trace: pruned {removed} trace(s) older than {days} days")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        usage()
    sub, args = argv[0], argv[1:]
    cmds = {"init": cmd_init, "tee": cmd_tee, "unwrap": cmd_unwrap, "show": cmd_show,
            "list": cmd_list, "prune": cmd_prune}
    if sub not in cmds:
        usage(f"unknown subcommand {sub!r}")
    os.umask(0o077)
    cmds[sub](args)


if __name__ == "__main__":
    main(sys.argv[1:])
