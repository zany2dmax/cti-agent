#!/usr/bin/env python3
"""cti-agent-secrets - move the fleet's secrets out of fleet.env into systemd credentials.

    sudo cti-agent-secrets status            each secret: stored as a credential? still in fleet.env?
    sudo cti-agent-secrets import --dry-run  what import would store
    sudo cti-agent-secrets import            encrypt every secret fleet.env has and the store lacks
    sudo cti-agent-secrets set NAME          encrypt one, typed in (no echo) or piped
    sudo cti-agent-secrets remove NAME       delete a stored credential

STEP 2 OF SPLITTING fleet.env (BACKLOG). Each secret is encrypted with
systemd-creds - bound to this machine's TPM where it has one, else to its host
key - into /etc/credstore.encrypted/NAME. Each unit imports only the secrets
its programs read (ImportCredential=, generated from settings.manifest), and
systemd decrypts them, for that run only, into a private folder the programs
read. A runner then drops the fleet.env copy of every secret it has as a
credential, so its children stop inheriting it.

NOTHING BREAKS IN BETWEEN. A unit skips a credential that is not stored yet,
and every program falls back to fleet.env, so secrets move one at a time.
Once `status` shows a secret stored, run each lane's dry run, then delete its
line from fleet.env: from then on no environment holds it.

IT NEVER PRINTS A VALUE, and passes values to systemd-creds on stdin, never on
a command line where ps would show them. Root only: it writes /etc.
"""
import argparse
import getpass
import os
import pathlib
import re
import subprocess
import sys
import tempfile

STORE = pathlib.Path(os.environ.get("CTI_CREDSTORE", "/etc/credstore.encrypted"))
# Which secrets are stored, names only (0644): fleet-config reads it, since the
# store itself is root-only (systemd's tmpfiles resets its mode at boot).
STORED_LIST = pathlib.Path(os.environ.get("CTI_CREDSTORE_LIST", "/etc/cti-agent/credentials.stored"))
FLEET_ENV = pathlib.Path(os.environ.get("FLEET_ENV", "/etc/cti-agent/fleet.env"))
CODE = pathlib.Path(os.environ.get("FLEET_CODE", "/opt/cti-agent"))
SYSTEMD_CREDS = os.environ.get("SYSTEMD_CREDS", "systemd-creds")
NAME_RE = re.compile(r"^[A-Z][A-Z0-9_]{1,63}$")


def known_secrets():
    """The names settings.manifest marks `secret: yes` or `credential: yes` (the
    login half of a secret: a client ID, a username, an API host): the only
    names this tool stores."""
    path = CODE / "settings.manifest"
    names, cur = [], None
    for line in path.read_text(encoding="utf-8").splitlines():
        field, _, value = line.partition(":")
        field, value = field.strip(), value.strip()
        if field == "key":
            cur = value
        elif field in ("secret", "credential") and value == "yes" and cur and cur not in names:
            names.append(cur)
    return sorted(names)


def env_secrets(names):
    """{name: value} for the known secrets fleet.env sets to something, as bash
    itself makes them: the file is sourced by bash with set -a, so comments,
    quotes, backslashes and $references (a helper like $EY_TEAM) mean what
    they mean to every runner. Values come back on stdout, NUL-separated,
    never in argv. bash's own errors are discarded: they could quote a line.

    Returns (values, odd); odd lists secrets bash could not give a value for
    because sourcing the file failed."""
    if not FLEET_ENV.is_file():
        return {}, []
    script = ('set -a; . "$1" >/dev/null 2>&1 || exit 3; shift; '
              'for n in "$@"; do if [ -n "${!n+x}" ]; then printf "%s\\0%s\\0" "$n" "${!n}"; fi; done')
    r = subprocess.run(["bash", "-c", script, "cti-agent-secrets", str(FLEET_ENV), *names],
                       env={"PATH": "/usr/bin:/bin"}, capture_output=True, check=False)
    if r.returncode != 0:
        return {}, list(names)
    parts = r.stdout.decode("utf-8", errors="replace").split("\0")
    vals = {}
    for k, v in zip(parts[0::2], parts[1::2]):
        if k in names and v:
            vals[k] = v
    return vals, []


def write_stored_list():
    """Names only, never values: what fleet-config needs to know."""
    names = sorted(p.name for p in STORE.iterdir() if p.is_file() and not p.name.startswith("."))
    STORED_LIST.parent.mkdir(parents=True, exist_ok=True)
    tmp = STORED_LIST.with_name("." + STORED_LIST.name + ".tmp")
    tmp.write_text("# secrets stored as systemd credentials - names only, written by cti-agent-secrets\n"
                   + "".join(n + "\n" for n in names), encoding="utf-8")
    os.chmod(tmp, 0o644)
    os.replace(tmp, STORED_LIST)


def stored(name):
    return (STORE / name).is_file()


def encrypt(name, value):
    """Encrypt value as credential NAME, atomically: a half-written file must
    never be what systemd finds."""
    STORE.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{name}.", dir=STORE)
    os.close(fd)
    try:
        r = subprocess.run([SYSTEMD_CREDS, "encrypt", f"--name={name}", "-", tmp],
                           input=value.encode("utf-8"), capture_output=True, check=False)
        if r.returncode != 0:
            # systemd-creds' own message names the problem (no TPM, say); it
            # never echoes the input.
            msg = r.stderr.decode("utf-8", errors="replace").strip().splitlines()
            raise RuntimeError(msg[-1] if msg else f"systemd-creds exited {r.returncode}")
        os.chmod(tmp, 0o600)
        with open(tmp, "rb") as f:  # on disk before it replaces the old one
            os.fsync(f.fileno())
        os.replace(tmp, STORE / name)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def must_be_root():
    if os.geteuid() != 0 and "CTI_CREDSTORE" not in os.environ:
        print("cti-agent-secrets: run it as root - sudo cti-agent-secrets ...", file=sys.stderr)
        sys.exit(2)


def cmd_status(names, out):
    vals, odd = env_secrets(names)
    n_stored = sum(1 for n in names if stored(n))
    print(f"{n_stored} of {len(names)} secrets and logins stored as credentials in {STORE}", file=out)
    print(f"{'name':<26} {'credential':<11} fleet.env", file=out)
    for n in names:
        cred = "stored" if stored(n) else "-"
        env = "set" if n in vals else ("UNREADABLE (fleet.env did not source)" if n in odd else "-")
        hint = ""
        if stored(n) and n in vals:
            hint = "   <- delete the fleet.env line once each lane's dry run passes"
        elif n in vals:
            hint = "   <- not moved yet: sudo cti-agent-secrets import"
        print(f"{n:<26} {cred:<11} {env}{hint}", file=out)
    return 0


def cmd_import(names, dry, out, err):
    vals, odd = env_secrets(names)
    todo = [n for n in names if n in vals and not stored(n)]
    for n in odd:
        print(f"skipped {n}: bash could not source fleet.env to read it; store it with: cti-agent-secrets set {n}", file=err)
    if not todo:
        print("nothing to import: every secret fleet.env sets is already stored", file=out)
        return 0
    failed = 0
    for n in todo:
        if dry:
            print(f"would store {n}", file=out)
            continue
        try:
            encrypt(n, vals[n])
            print(f"stored {n}", file=out)
        except (OSError, RuntimeError) as e:
            failed += 1
            print(f"FAILED {n}: {e}", file=err)
    if not dry:
        write_stored_list()
        print("\nNext: run each lane's dry run (sudo cti-agent run-digest daily --dry-run, ...).", file=out)
        print("Then delete the secret's line from fleet.env; `status` shows which can go.", file=out)
    return 1 if failed else 0


def cmd_set(name, out, err):
    if sys.stdin.isatty():
        value = getpass.getpass(f"{name} (not echoed): ")
    else:
        value = sys.stdin.read(65537)
        if len(value) > 65536:
            print("cti-agent-secrets: a secret is at most 64 KiB", file=err)
            return 2
        value = value.rstrip("\r\n")
    if not value:
        print("cti-agent-secrets: empty value - nothing stored", file=err)
        return 2
    try:
        encrypt(name, value)
    except (OSError, RuntimeError) as e:
        print(f"FAILED {name}: {e}", file=err)
        return 1
    write_stored_list()
    print(f"stored {name}", file=out)
    return 0


def main(argv=None, out=sys.stdout, err=sys.stderr):
    ap = argparse.ArgumentParser(prog="cti-agent-secrets",
                                 description="Move the fleet's secrets into systemd credentials. Never prints a value.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status", help="each secret: stored as a credential, still in fleet.env")
    imp = sub.add_parser("import", help="encrypt every secret fleet.env has and the store lacks")
    imp.add_argument("--dry-run", action="store_true", help="say what would be stored; store nothing")
    st = sub.add_parser("set", help="encrypt one secret, typed in (no echo) or piped on stdin")
    st.add_argument("name")
    rm = sub.add_parser("remove", help="delete a stored credential")
    rm.add_argument("name")
    a = ap.parse_args(argv)
    must_be_root()
    try:
        names = known_secrets()
    except OSError:
        print(f"cti-agent-secrets: cannot read {CODE / 'settings.manifest'}", file=err)
        return 1
    if a.cmd in ("set", "remove") and (not NAME_RE.match(a.name) or a.name not in names):
        print(f"cti-agent-secrets: {a.name!r} is not a fleet secret (known: {' '.join(names)})", file=err)
        return 2
    if a.cmd == "status":
        return cmd_status(names, out)
    if a.cmd == "import":
        return cmd_import(names, a.dry_run, out, err)
    if a.cmd == "set":
        return cmd_set(a.name, out, err)
    p = STORE / a.name
    if not p.is_file():
        print(f"{a.name} is not stored", file=out)
        return 0
    p.unlink()
    write_stored_list()
    print(f"removed {a.name}. Units that import it skip it from their next run; put it back in fleet.env if it is still needed.", file=out)
    return 0


if __name__ == "__main__":
    sys.exit(main())
