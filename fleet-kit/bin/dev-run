#!/usr/bin/env bash
#
# dev-run - run the CTI pipeline locally for testing and debugging.
#
# Works on macOS or Linux, from a repo checkout, with no root, no service
# account and no systemd. It is for answering one question: "does this read the
# mailbox and produce believable threat intel?"
#
# Nothing here sends email except the `send` stage, and that one dry-runs unless
# you pass --for-real. Every other stage is read-only as far as the outside
# world is concerned.
#
# Stages, each runnable on its own so you can see where it breaks:
#   doctor   check tools, config, Graph token and permissions
#   ingest   Go agent: mailbox -> CVEs -> scanner -> markdown
#   enrich   NVD CVSS + EPSS + KEV -> P1-P4
#   brief    render the HTML digest
#   send     mail the digest - DRY RUN unless you pass --for-real
#   all      doctor -> ingest -> enrich -> brief, then open the digest
#
# Usage:
#   ./bin/dev-run doctor
#   ./bin/dev-run ingest --provider none     # no scanner, proves Graph + parsing
#   ./bin/dev-run ingest                     # uses LOOKUP_PROVIDER from .env
#   ./bin/dev-run all
#   ./bin/dev-run all --provider none
#   ./bin/dev-run send --to you@example.com              # dry run, sends nothing
#   ./bin/dev-run send --to you@example.com --for-real   # actually sends
#
# State lands in .fleet-local/ inside the repo (gitignored), so nothing touches
# ~/fleet and nothing you generate here can be committed.
set -euo pipefail

# ── platform ────────────────────────────────────────────────────────────────
case "$(uname -s)" in
  Darwin) FLEET_OS="macos"; OPEN_CMD="open" ;;
  Linux)  FLEET_OS="linux"; OPEN_CMD="xdg-open" ;;
  *)      FLEET_OS="other"; OPEN_CMD="" ;;
esac

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
KIT="$REPO/fleet-kit"
export FLEET_HOME="${FLEET_HOME:-$REPO/.fleet-local}"
DAY="$(date +%F)"

RAW="$FLEET_HOME/reports/raw-$DAY.md"
ENRICHED="$FLEET_HOME/state/enriched-$DAY.json"
HTML="$FLEET_HOME/reports/digest-$DAY.html"
TXT="$FLEET_HOME/reports/digest-$DAY.txt"

PROVIDER=""
SEND_TO=""
FOR_REAL="no"
STAGE="${1:-all}"; shift || true
while [ $# -gt 0 ]; do
  case "$1" in
    --provider) PROVIDER="$2"; shift 2 ;;
    --to)       SEND_TO="$2"; shift 2 ;;
    --for-real) FOR_REAL="yes"; shift ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

bold() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$*"; }
info() { printf '    %s\n' "$*"; }

mkdir -p "$FLEET_HOME"/{state,reports,logs}

# Load the Go agent's .env - the same file it already uses. No duplicate config.
if [ -f "$REPO/.env" ]; then
  set -a; . "$REPO/.env"; set +a
else
  bad "no $REPO/.env - copy .env.example and fill it in"; exit 1
fi
[ -n "$PROVIDER" ] && export LOOKUP_PROVIDER="$PROVIDER"

# Keep generated artifacts inside .fleet-local, and never write real hostnames
# to disk during a dev run unless explicitly asked.
export REPORT_PATH="$RAW"
export QUALYS_KB_CACHE="${QUALYS_KB_CACHE:-$FLEET_HOME/state/qualys_kb_cache.json}"
export REPORT_HOSTNAMES="${REPORT_HOSTNAMES:-redact}"

# ─────────────────────────────────────────────────────────────── doctor ──────
stage_doctor() {
  bold "Doctor  (os=$FLEET_OS)"
  local fail=0

  if command -v go >/dev/null 2>&1; then ok "go $(go version | awk '{print $3}')"
  else bad "go not found - brew install go"; fail=1; fi

  if command -v python3 >/dev/null 2>&1; then ok "python3 $(python3 -V 2>&1 | awk '{print $2}')"
  else bad "python3 not found"; fail=1; fi

  bold "Config from $REPO/.env"
  local v
  for v in TENANT_ID CLIENT_ID CLIENT_SECRET GRAPH_MAILBOX; do
    if [ -n "${!v:-}" ]; then
      case "$v" in
        CLIENT_SECRET) ok "$v set (${#CLIENT_SECRET} chars)" ;;
        *) ok "$v = ${!v}" ;;
      esac
    else bad "$v is empty"; fail=1; fi
  done
  info "LOOKUP_PROVIDER = ${LOOKUP_PROVIDER:-qualys}"
  info "GRAPH_LOOKBACK_HOURS = ${GRAPH_LOOKBACK_HOURS:-24}"
  info "REPORT_HOSTNAMES = $REPORT_HOSTNAMES"

  if [ "${LOOKUP_PROVIDER:-qualys}" = "qualys" ]; then
    for v in QUALYS_BASE_URL QUALYS_USERNAME QUALYS_PASSWORD; do
      if [ -n "${!v:-}" ]; then ok "$v set"; else bad "$v is empty"; fail=1; fi
    done
  fi

  bold "Microsoft Graph"
  # mailer.py --check decodes the token and reports the granted app roles, so a
  # permissions problem is named here rather than surfacing as a 403 later.
  if python3 "$KIT/fleet/lanes/mailer.py" --check 2>&1 | sed 's/^\[mailer\] /    /'; then
    ok "token acquired"
  else
    bad "Graph check failed - see above"
    info "Mail.Read is required for ingest. Mail.Send is only needed by the"
    info "send stage, so a missing Mail.Send is fine until you run that."
  fi

  [ "$fail" = "0" ] || { bad "fix the above before continuing"; return 1; }
  ok "ready"
}

# ─────────────────────────────────────────────────────────────── ingest ──────
stage_ingest() {
  bold "Ingest  (provider=${LOOKUP_PROVIDER:-qualys}, lookback=${GRAPH_LOOKBACK_HOURS:-24}h)"
  # ALWAYS rebuild. An earlier version reused any existing binary, which meant
  # a source fix could be applied, committed and tested against - while the run
  # silently exercised the old build. Debugging a bug you have already fixed is
  # the worst possible way to lose an hour.
  #
  # Go's build cache makes this near-instant when nothing changed, so there is
  # no reason to be clever here.
  local bin="$FLEET_HOME/cti-agent-dev"
  info "building $(basename "$bin")..."
  if ! ( cd "$REPO" && go build -o "$bin" ./cmd/cti-qualys-agent ); then
    bad "go build failed - fix the compile error above"
    return 1
  fi
  # Report what actually got built, so "did my fix land?" is answerable.
  local src_newest
  src_newest=$(find "$REPO" -name '*.go' -newer "$bin" -print -quit 2>/dev/null || true)
  if [ -n "$src_newest" ]; then
    bad "a .go file is newer than the binary that just built - unexpected"
  fi
  ok "built from $(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo 'no git')$(
      [ -n "$(git -C "$REPO" status --porcelain -- '*.go' 2>/dev/null)" ] && echo ' + uncommitted .go changes')"
  ( cd "$REPO" && "$bin" ) 2>&1 | tee "$FLEET_HOME/logs/ingest.log" | sed 's/^/    /'
  [ -s "$RAW" ] || { bad "no report at $RAW"; return 1; }

  local rows present notpresent unknown
  rows=$(grep -c '^| CVE-' "$RAW" || true)
  present=$(grep '^| CVE-' "$RAW" | grep -c '| PRESENT ' || true)
  notpresent=$(grep '^| CVE-' "$RAW" | grep -c '| NOT_PRESENT ' || true)
  unknown=$(grep '^| CVE-' "$RAW" | grep -c '| UNKNOWN ' || true)
  ok "$rows CVE rows  (PRESENT=$present NOT_PRESENT=$notpresent UNKNOWN=$unknown)"
  info "emails inspected: $(grep -o 'Emails inspected: `[0-9]*`' "$RAW" | grep -o '[0-9]*' || echo '?')"
  info "report: $RAW"

  if [ "$rows" = "0" ]; then
    bad "no CVEs extracted - this is the thing to debug first"
    info "Check, in order:"
    info "  1. Did it read any email at all? 'Emails inspected' above."
    info "     0 emails => Graph/permission/mailbox problem, not parsing."
    info "  2. Widen the window:  GRAPH_LOOKBACK_HOURS=168 ./bin/dev-run ingest"
    info "  3. Is the CTI mail in a subfolder?  GRAPH_FOLDER=<name>"
    info "  4. Do the emails actually contain CVE IDs, or only links?"
  fi
}

# ─────────────────────────────────────────────────────────────── enrich ──────
stage_enrich() {
  bold "Enrich  (NVD + EPSS + KEV)"
  [ -s "$RAW" ] || { bad "no $RAW - run ingest first"; return 1; }
  [ -n "${NVD_API_KEY:-}" ] || info "no NVD_API_KEY: throttled to 5 req/30s, so this may take minutes"
  python3 "$KIT/fleet/lanes/enrich.py" --report "$RAW" --out "$ENRICHED" \
    2>&1 | sed 's/^\[enrich\] /    /'
  [ -s "$ENRICHED" ] || { bad "enrich produced nothing"; return 1; }
  python3 - "$ENRICHED" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
c = d["counts"]
print(f"  \033[32m✓\033[0m P1={c['P1']} P2={c['P2']} P3={c['P3']} P4={c['P4']}  (total {d['total']})")
if d.get("degraded"):
    print(f"    DEGRADED - unavailable this run: {', '.join(d['degraded'])}")
top = [f for f in d["findings"] if f["priority"] in ("P1", "P2")][:8]
if top:
    print("    top findings:")
    for f in top:
        kev = " KEV" if f.get("kev") else ""
        epss = f" EPSS {f['epss']:.0%}" if f.get("epss") is not None else ""
        print(f"      {f['priority']}  {f['cve']:<17} {f.get('status','?'):<12}"
              f" {f.get('host_count',0):>4} host(s)  CVSS {f.get('cvss') or '-'}{epss}{kev}")
PY
  info "json: $ENRICHED"
}

# ──────────────────────────────────────────────────────────────── brief ──────
stage_brief() {
  bold "Brief  (render only - nothing is sent)"
  [ -s "$ENRICHED" ] || { bad "no $ENRICHED - run enrich first"; return 1; }
  python3 "$KIT/fleet/lanes/brief.py" --daily --enriched "$ENRICHED" \
    --out "$HTML" --text-out "$TXT" 2>&1 | sed 's/^\[brief\] /    /'
  ok "subject: $(python3 "$KIT/fleet/lanes/brief.py" --daily --subject-only --enriched "$ENRICHED")"
  info "html: $HTML"
  info "text: $TXT"
  bold "Plain-text preview"
  head -28 "$TXT" | sed 's/^/    /'
}

# ────────────────────────────────────────────────────────────────── send ─────
stage_send() {
  bold "Send"
  [ -s "$HTML" ] || { bad "no digest at $HTML - run brief first"; return 1; }

  local to="${SEND_TO:-${DIGEST_TO:-}}"
  if [ -z "$to" ]; then
    bad "no recipient"
    info "Pass --to you@example.com, or set DIGEST_TO in .env."
    info "There is no default: the fleet will not guess who receives findings."
    return 1
  fi

  # Mail.Send is the one permission the read-only stages do not need, so check
  # it before attempting a send and name the fix if it is missing.
  info "checking Mail.Send..."
  local roles
  roles=$(python3 "$KIT/fleet/lanes/mailer.py" --check 2>&1 || true)
  echo "$roles" | sed 's/^\[mailer\] /    /'
  if echo "$roles" | grep -q "MISSING Mail.Send"; then
    bad "Mail.Send is not granted to this app registration"
    info "Entra ID > App registrations > your CTI app > API permissions >"
    info "  Add permission > Microsoft Graph > Application permissions >"
    info "  Mail.Send > then GRANT ADMIN CONSENT (people skip that step)."
    info "Consent can take a minute to propagate."
    return 1
  fi

  # Exercise the real allowlist rather than bypassing it with --approve: an
  # explicit --to on this command is the operator's decision, so scope the
  # allowlist to exactly that recipient and let the normal gate run.
  export FLEET_ALLOW_TO="$to"

  local subject
  subject=$(python3 "$KIT/fleet/lanes/brief.py" --daily --subject-only --enriched "$ENRICHED")
  info "from   : ${GRAPH_MAILBOX:-unset}"
  info "to     : $to"
  info "subject: $subject"

  local dry="--dry-run"
  if [ "$FOR_REAL" = "yes" ]; then
    dry=""
  else
    bold "DRY RUN - nothing will be sent"
    info "add --for-real to actually send"
  fi

  if python3 "$KIT/fleet/lanes/mailer.py" --html "$HTML" --text "$TXT" \
       --subject "$subject" --to "$to" --attach "$RAW" $dry \
       2>&1 | sed 's/^\[mailer\] /    /'; then
    if [ "$FOR_REAL" = "yes" ]; then
      ok "sent to $to - check the inbox, and the Sent Items of ${GRAPH_MAILBOX:-the sending mailbox}"
      info "if it does not arrive: check quarantine, and that the sending"
      info "mailbox is allowed to send to that address"
    else
      ok "dry run passed - the gate and the payload are both valid"
    fi
  else
    bad "send failed - see above"
    return 1
  fi
}

case "$STAGE" in
  doctor) stage_doctor ;;
  send)   stage_send ;;
  ingest) stage_ingest ;;
  enrich) stage_enrich ;;
  brief)  stage_brief ;;
  all)
    stage_doctor || true      # a missing Mail.Send should not stop a dev run
    stage_ingest
    stage_enrich
    stage_brief
    bold "Done - no email was sent"
    if [ -n "$OPEN_CMD" ] && command -v "$OPEN_CMD" >/dev/null 2>&1; then
      info "opening the digest..."
      "$OPEN_CMD" "$HTML" 2>/dev/null || true
    else
      info "open it yourself: $HTML"
    fi
    ;;
  *) echo "usage: dev-run {doctor|ingest|enrich|brief|send|all}" >&2
     echo "         [--provider none|qualys] [--to addr] [--for-real]" >&2
     exit 2 ;;
esac
