#!/usr/bin/env python3
"""lanes - the lane manifests, and the systemd units they generate.

    scripts/lanes --check    exit 1 if a generated file is out of date (task lane:check)
    scripts/lanes --write    rewrite the generated files from the manifests
    scripts/lanes --list     print each lane, its units and its schedule

A lane is described once, in fleet-kit/lanes/<lane>.toml (docs/lane-manifest.md
has the schema). From it this writes each of the lane's .service units under
fleet-kit/fleet/systemd-fedora/, the orchestrator's lane table in
fleet-kit/fleet/CLAUDE.md (between its markers), and internal/checkin/lanes_gen.go,
the lanes every beat's verdict must account for. Each unit comes from one
template for every lane, with the parts that differ (what it runs, how long
it may take, what it may write) taken from the manifest. A unit is never edited by hand any more; edit the manifest and
run --write.

Two blocks inside each unit belong to scripts/settings-manifest, not to this:
the settings files it loads and the credentials it imports. They are kept as
they are in the unit on disk, so the two generators never fight; a new unit
gets a placeholder that settings-manifest --write fills in.

Timers are checked, not written: each keeps its hand-written reasons for its
schedule, and this fails when a timer's Unit=, Description= or OnCalendar=
(or its OnBootSec=/OnUnitActiveSec=) disagrees with the manifest.

Standard library only (tomllib), like every script here.
"""
import os
import pathlib
import re
# subprocess runs the repository's own grant builder in bash, with fixed arguments.
import subprocess  # nosec B404
import sys
import tomllib

ROOT = pathlib.Path(__file__).resolve().parents[1]
LANES = ROOT / "fleet-kit" / "lanes"
UNITS = ROOT / "fleet-kit" / "fleet" / "systemd-fedora"
ORCHESTRATOR = ROOT / "fleet-kit" / "fleet" / "CLAUDE.md"
VERDICT_LANES = ROOT / "internal" / "checkin" / "lanes_gen.go"
COMMANDS = ROOT / "fleet-kit" / "fleet" / "commands.manifest"
LANE_LIST = ROOT / "fleet-kit" / "fleet" / "lanes.list"
RUN_CHECKIN = ROOT / "fleet-kit" / "fleet" / "bin" / "run-checkin"
GRANT_RE = re.compile(r"^(Bash\([a-z][a-z-]*(:\*| [^()]+)?\)|Read\([a-z]+/\*\*\))$")
PROGRAM_DIRS = (ROOT / "cmd", ROOT / "fleet-kit" / "fleet" / "bin")
TABLE_BEGIN = "<!-- BEGIN lane table - generated by scripts/lanes from fleet-kit/lanes/*.toml, do not edit -->"
TABLE_END = "<!-- END lane table -->"
CODE = "/opt/cti-agent"

SETTINGS_BEGIN = "# BEGIN settings - generated by scripts/settings-manifest, do not edit"
SETTINGS_END = "# END settings"
CREDS_BEGIN = "# BEGIN credentials - generated by scripts/settings-manifest, do not edit"
CREDS_END = "# END credentials"

NAME_RE = re.compile(r"^[a-z][a-z0-9-]{0,30}$")
HANDLE_RE = re.compile(r"^@[a-z][a-z0-9-]{0,30}$")

# What a manifest may hold. Anything else is a typo, and refused by name.
LANE_KEYS = {"lane", "handles", "summary", "setting_prefixes", "all_settings", "beat_grants", "orchestrator", "unit"}
PREFIX_RE = re.compile(r"^[A-Z][A-Z0-9_]{1,40}$")
ORCH_KEYS = {"order", "runs", "when", "sends_to"}
UNIT_KEYS = {"name", "description", "exec", "timeout", "nice", "audit_log", "extra", "timer"}
TIMER_KEYS = {"description", "on_calendar", "on_boot", "on_unit_active", "persistent"}

HEAD = """\
[Unit]
Description={description}
Documentation=file:///opt/cti-agent/README.md
# If this fails, tell the operator. Without this a failed digest is
# silent, and no email looks exactly like a quiet day.
OnFailure=cti-agent-alert@%n.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ctiagent
Group=ctiagent
"""

UMASK = """
# 0077, so a lane that writes with a bare open() cannot land a world- or
# group-readable file. Under systemd's default 0022 the Python lanes' digest
# HTML and enriched-*.json - which carries host names - were 0644. Every lane
# is Go now and sets 0600 itself; this stays as the floor for the runners and
# for anything added later.
UMask=0077

# FHS layout. Nothing lives under /home, which is what lets ProtectHome=yes
# hide it entirely - the original units used ProtectHome=read-only plus a
# ReadWritePaths punch-through into /home, which is order-dependent in systemd
# and the exact pattern SELinux is most likely to deny on Fedora.
#
#   /opt/cti-agent     code      root-owned, read-only to this service
#   /etc/cti-agent     config    root:ctiagent 0750, secrets 0640
#   /var/lib/cti-agent state     systemd creates and chowns this
StateDirectory=cti-agent
StateDirectoryMode=0750
"""

AUDIT_LOG = """
# The audit trail: RFC 5424 syslog lines in /var/log/cti-agent/audit-DATE.log
# (cti-audit(1), internal/audit). systemd creates the directory for the service
# account and keeps it writable under ProtectSystem=strict. The cleanup lane
# deletes files past AUDIT_RETAIN_DAYS (default 120).
LogsDirectory=cti-agent
LogsDirectoryMode=0750
"""

ENV = """\
WorkingDirectory=/var/lib/cti-agent
# EnvironmentFile FIRST, then Environment=. systemd applies these in
# written order and the last assignment wins, so with the file last a
# stale FLEET_HOME in fleet.env silently replaced the layout this unit
# specifies. The unit owns the layout; fleet.env owns the settings.
{settings}
Environment=HOME=/var/lib/cti-agent
Environment=FLEET_HOME=/var/lib/cti-agent
Environment=FLEET_CODE=/opt/cti-agent
Environment=FLEET_ENV=/etc/cti-agent/fleet.env
Environment=FLEET_FEEDS=/etc/cti-agent/feeds.txt

{credentials}
ExecStart={exec}
TimeoutStartSec={timeout}
Nice={nice}
"""

TAIL = """
# Least privilege. ProtectHome=yes is stronger than the read-only variant and
# safe here only because no fleet path is under /home.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=

# journald, not hand-rolled log files: Fedora ships journald and it handles
# rotation, size caps and retention already.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cti-agent-{name}
"""

# What a new unit gets until settings-manifest --write fills the two blocks.
SETTINGS_PLACEHOLDER = "EnvironmentFile=/etc/cti-agent/fleet.env"
CREDS_PLACEHOLDER = ""


def shown(p):
    """A path for a message: relative to the repository when it is in it."""
    try:
        return str(p.relative_to(ROOT))
    except ValueError:
        return str(p)


class ManifestError(Exception):
    pass


def load(path):
    """One lane manifest, checked. Raises ManifestError naming the problem."""
    try:
        m = tomllib.loads(path.read_text(encoding="utf-8"))
    except tomllib.TOMLDecodeError as e:
        raise ManifestError(f"{path.name}: not valid TOML: {e}") from None
    where = path.name

    def need(d, key, kind, ctx):
        if key not in d:
            raise ManifestError(f"{where}: {ctx} has no {key}")
        if not isinstance(d[key], kind):
            raise ManifestError(f"{where}: {ctx} {key} must be {kind.__name__}")
        return d[key]

    def only(d, allowed, ctx):
        extra = sorted(set(d) - allowed)
        if extra:
            raise ManifestError(f"{where}: {ctx} has unknown key(s): {', '.join(extra)}")

    only(m, LANE_KEYS, "the lane")
    lane = need(m, "lane", str, "the lane")
    if not NAME_RE.match(lane) or path.stem != lane:
        raise ManifestError(f"{where}: lane {lane!r} must be lower-case and match the file name")
    for h in need(m, "handles", list, "the lane"):
        if not isinstance(h, str) or not HANDLE_RE.match(h):
            raise ManifestError(f"{where}: handle {h!r} is not like @name")
    need(m, "summary", str, "the lane")
    pre = m.get("setting_prefixes", [])
    if not isinstance(pre, list) or not all(isinstance(x, str) and PREFIX_RE.match(x) for x in pre):
        raise ManifestError(f"{where}: setting_prefixes must be a list of upper-case setting-name prefixes")
    grants = m.get("beat_grants", [])
    if not isinstance(grants, list) or not all(isinstance(x, str) and GRANT_RE.match(x) for x in grants):
        raise ManifestError(f"{where}: beat_grants must be a list like \"Bash(cti-vmscan --check)\" or \"Read(reports/**)\"")
    if not isinstance(m.get("all_settings", False), bool):
        raise ManifestError(f"{where}: all_settings must be true or false")
    o = m.get("orchestrator")
    if o is not None:
        if not isinstance(o, dict):
            raise ManifestError(f"{where}: orchestrator must be a table")
        only(o, ORCH_KEYS, "the orchestrator table")
        if not isinstance(o.get("order"), int) or isinstance(o.get("order"), bool):
            raise ManifestError(f"{where}: orchestrator order must be a whole number")
        for k in ("runs", "when", "sends_to"):
            v = need(o, k, str, "the orchestrator table")
            if "|" in v or "\n" in v:
                raise ManifestError(f"{where}: orchestrator {k} must be one line with no |")
        if not m["handles"]:
            raise ManifestError(f"{where}: a lane in the orchestrator's table needs a handle")
    units = need(m, "unit", list, "the lane")
    if not units:
        raise ManifestError(f"{where}: the lane has no [[unit]]")
    for u in units:
        only(u, UNIT_KEYS, "a unit")
        name = need(u, "name", str, "a unit")
        if not NAME_RE.match(name):
            raise ManifestError(f"{where}: unit name {name!r} must be lower-case letters, digits and -")
        ctx = f"unit {name}"
        need(u, "description", str, ctx)
        exe = need(u, "exec", str, ctx)
        if not exe.startswith(CODE + "/bin/"):
            raise ManifestError(f"{where}: {ctx} exec must start with {CODE}/bin/")
        for k in ("timeout", "nice"):
            if not isinstance(u.get(k), int) or isinstance(u.get(k), bool):
                raise ManifestError(f"{where}: {ctx} {k} must be a whole number")
        if not isinstance(u.get("audit_log", False), bool):
            raise ManifestError(f"{where}: {ctx} audit_log must be true or false")
        if not isinstance(u.get("extra", ""), str):
            raise ManifestError(f"{where}: {ctx} extra must be text")
        t = u.get("timer")
        if t is not None:
            if not isinstance(t, dict):
                raise ManifestError(f"{where}: {ctx} timer must be a table")
            only(t, TIMER_KEYS, f"{ctx} timer")
            need(t, "description", str, f"{ctx} timer")
            if not (t.get("on_calendar") or (t.get("on_boot") and t.get("on_unit_active"))):
                raise ManifestError(f"{where}: {ctx} timer needs on_calendar, or on_boot and on_unit_active")
            if not isinstance(t.get("persistent"), bool):
                raise ManifestError(f"{where}: {ctx} timer persistent must be true or false")
    return m


def load_all():
    out = {}
    for p in sorted(LANES.glob("*.toml")):
        m = load(p)
        out[m["lane"]] = m
    granted = {}
    for m in out.values():
        for x in m.get("beat_grants", []):
            if x in granted:
                raise ManifestError(f"beat grant {x} is declared by both {granted[x]} and {m['lane']}")
            granted[x] = m["lane"]
    owner, everything = {}, []
    for m in out.values():
        for x in m.get("setting_prefixes", []):
            if x in owner:
                raise ManifestError(f"setting prefix {x} is claimed by both {owner[x]} and {m['lane']}")
            owner[x] = m["lane"]
        if m.get("all_settings"):
            everything.append(m["lane"])
    if len(everything) > 1:
        raise ManifestError(f"only one lane may load all settings, not {', '.join(everything)}")
    orders = {}
    for m in out.values():
        o = m.get("orchestrator")
        if o is not None:
            if o["order"] in orders:
                raise ManifestError(f"{m['lane']} and {orders[o['order']]} both have orchestrator order {o['order']}")
            orders[o["order"]] = m["lane"]
    seen = {}
    for m in out.values():
        for u in m["unit"]:
            if u["name"] in seen:
                raise ManifestError(f"unit {u['name']} is in both {seen[u['name']]} and {m['lane']}")
            seen[u["name"]] = m["lane"]
    return out


def block(text, begin, end, placeholder):
    """The generated block from the unit on disk, or a placeholder."""
    if text is not None:
        lines = text.split("\n")
        if begin in lines and end in lines:
            i, j = lines.index(begin), lines.index(end)
            return "\n".join(lines[i:j + 1])
    return placeholder


def render(unit, current):
    """The .service text for one manifest unit. current is the file on disk
    (or None), for the two blocks settings-manifest owns."""
    extra = unit.get("extra", "")
    if extra and not extra.endswith("\n"):
        extra += "\n"
    creds = block(current, CREDS_BEGIN, CREDS_END, CREDS_PLACEHOLDER)
    env = ENV.format(
        settings=block(current, SETTINGS_BEGIN, SETTINGS_END, SETTINGS_PLACEHOLDER),
        credentials=creds,
        exec=unit["exec"], timeout=unit["timeout"], nice=unit["nice"])
    if not creds:
        env = env.replace("\n\n\nExecStart=", "\n\nExecStart=")
    return (HEAD.format(description=unit["description"]) + extra + UMASK
            + (AUDIT_LOG if unit.get("audit_log") else "") + env + TAIL.format(name=unit["name"]))


def timer_problems(unit):
    """What in the unit's hand-written timer disagrees with the manifest."""
    t = unit.get("timer")
    path = UNITS / f"cti-agent-{unit['name']}.timer"
    if t is None:
        return [f"{path.name} exists but the manifest declares no timer"] if path.exists() else []
    if not path.exists():
        return [f"{path.name} is missing (the manifest declares a timer)"]
    text = path.read_text(encoding="utf-8")

    def value(key):
        m = re.search(rf"(?m)^{key}=(.*)$", text)
        return m.group(1).strip() if m else None

    want = {"Unit": f"cti-agent-{unit['name']}.service", "Description": t["description"],
            "Persistent": "true" if t["persistent"] else "false"}
    if t.get("on_calendar"):
        want["OnCalendar"] = t["on_calendar"]
    if t.get("on_boot"):
        want["OnBootSec"] = t["on_boot"]
    if t.get("on_unit_active"):
        want["OnUnitActiveSec"] = t["on_unit_active"]
    out = []
    for k, v in want.items():
        got = value(k)
        if got != v:
            out.append(f"{path.name}: {k}={got!r}, the manifest says {v!r}")
    return out


def setting_rules(lanes):
    """[(prefix, lane)], longest prefix first: a setting belongs to the lane
    whose prefix it starts with, the longest one winning (WAS_OWNER_CC is
    appowners', WAS_ the rest appscan's). Read by scripts/settings-manifest."""
    rules = [(x, m["lane"]) for m in lanes.values() for x in m.get("setting_prefixes", [])]
    return sorted(rules, key=lambda r: (-len(r[0]), r[0]))


def all_settings_lane(lanes):
    """The one lane that loads every lane's settings file, or None."""
    return next((m["lane"] for m in lanes.values() if m.get("all_settings")), None)


def unit_lanes(lanes):
    """{unit name: lane}, for every unit a manifest describes."""
    return {u["name"]: m["lane"] for m in lanes.values() for u in m["unit"]}


def overseen(lanes):
    """The lanes in the orchestrator's table, in its order. A lane with no
    orchestrator table (the check-in itself) is not overseen."""
    return sorted((m for m in lanes.values() if m.get("orchestrator")), key=lambda m: m["orchestrator"]["order"])


def render_table(lanes, current):
    """CLAUDE.md with its lane table regenerated between the markers."""
    rows = ["| Handle | Runs | When (timer) | Sends to |", "|---|---|---|---|"]
    for m in overseen(lanes):
        o = m["orchestrator"]
        rows.append(f"| {', '.join('`' + h + '`' for h in m['handles'])} | {o['runs']} | {o['when']} | {o['sends_to']} |")
    lines = current.split("\n")
    if TABLE_BEGIN not in lines or TABLE_END not in lines:
        raise ManifestError(f"{shown(ORCHESTRATOR)} has no {TABLE_BEGIN!r} ... {TABLE_END!r} markers")
    i, j = lines.index(TABLE_BEGIN), lines.index(TABLE_END)
    lines[i + 1:j] = rows
    return "\n".join(lines)


def render_verdict_lanes(lanes):
    """internal/checkin/lanes_gen.go: every unit the beat must account for,
    and which lane each belongs to (for FLEET_LANES)."""
    names = [u["name"] for m in overseen(lanes) for u in m["unit"]]
    body = ",\n".join(f'\t"{n}"' for n in names)
    pairs = [(f'"{u["name"]}":', m["lane"]) for m in overseen(lanes) for u in m["unit"]]
    width = max(len(k) for k, _ in pairs)  # gofmt aligns a map literal's values
    of = "\n".join(f'\t{k.ljust(width)} "{v}",' for k, v in pairs)
    return ("// Code generated by scripts/lanes from fleet-kit/lanes/*.toml; DO NOT EDIT.\n\n"
            "package checkin\n\n"
            "// Lanes is every lane the beat accounts for, exactly once, every beat: each\n"
            "// unit of a lane in the orchestrator's table, in that table's order. A new\n"
            "// lane joins it by getting an [orchestrator] table in its manifest.\n"
            f"var Lanes = []string{{\n{body},\n}}\n\n"
            "// LaneOf is the lane (the name FLEET_LANES uses) each of Lanes belongs to.\n"
            f"var LaneOf = map[string]string{{\n{of}\n}}\n")


def render_lane_list(lanes):
    """fleet-kit/fleet/lanes.list: the lanes for tools on the box that do not
    read TOML (the installer, fleet-timers, fleet-config). One line a lane:
    its name, its units, and the credential checks the beat runs for it."""
    head = ["# The fleet's lanes - generated by scripts/lanes from fleet-kit/lanes/*.toml, do not edit.",
            "# Installed as /opt/cti-agent/share/lanes.list. FLEET_LANES names lanes from here.",
            "# lane<TAB>units<TAB>credential checks the beat runs for it (- for none)"]
    rows = []
    for m in sorted(lanes.values(), key=lambda m: (m.get("orchestrator", {}).get("order", 0), m["lane"])):
        checks = [g[len("Bash("):-len(" --check)")] for g in m.get("beat_grants", []) if g.endswith(" --check)")]
        if m.get("all_settings"):
            checks = []  # the check-in's own checks (cti-mailer, cti-jira) are fleet-wide
        rows.append("\t".join([m["lane"], ",".join(u["name"] for u in m["unit"]), ",".join(checks) or "-"]))
    return "\n".join(head + rows) + "\n"


def declared_grants(lanes):
    """{grant: lane}: every beat grant a manifest declares."""
    return {x: m["lane"] for m in lanes.values() for x in m.get("beat_grants", [])}


def actual_grants():
    """The beat's grant as run-checkin builds it: its ALLOWED_TOOLS lines, run
    in bash with the box's paths, then written the way manifests declare
    them (Bash(x) for $FLEET_CODE/bin/x, Read(d/**) for $FLEET_HOME/d)."""
    text = RUN_CHECKIN.read_text(encoding="utf-8")
    start, end = text.index('\nALLOWED_TOOLS=""\n'), text.index("\nDISALLOWED_TOOLS=")
    snippet = text[start:end] + '\nprintf %s "$ALLOWED_TOOLS"\n'
    env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "FLEET_CODE": CODE, "FLEET_HOME": "/var/lib/cti-agent"}
    r = subprocess.run(["bash", "-c", snippet], capture_output=True, text=True, env=env, check=False)  # nosec B603 B607
    if r.returncode != 0 or not r.stdout:
        raise ManifestError(f"could not build run-checkin's grant: {r.stderr.strip()}")
    out = []
    for g in r.stdout.split(","):
        out.append(g.replace(f"Bash({CODE}/bin/", "Bash(").replace("Read(//var/lib/cti-agent/", "Read("))
    return out


def grant_problems(lanes):
    """run-checkin's grant against the manifests' declarations, both ways: a
    grant no lane declares is a capability nobody signed for, and a declared
    one run-checkin does not give is a lane that thinks it has a check it
    does not."""
    declared, actual = declared_grants(lanes), actual_grants()
    out = [f"run-checkin grants {g}, which no lane manifest declares (add it to that lane's beat_grants)"
           for g in actual if g not in declared]
    out += [f"{declared[g]}.toml declares the beat grant {g}, which run-checkin does not give"
            for g in declared if g not in actual]
    dup = sorted({g for g in actual if actual.count(g) > 1})
    out += [f"run-checkin grants {g} more than once" for g in dup]
    return out


def commands():
    """{command: {"runs": ..., "modes": [...]}} from commands.manifest."""
    out, cur = {}, None
    for line in COMMANDS.read_text(encoding="utf-8").splitlines():
        if line.startswith("command:"):
            cur = out.setdefault(line.split(":", 1)[1].strip(), {"runs": "", "modes": []})
        elif cur is not None and line.startswith("runs:"):
            cur["runs"] = line.split(":", 1)[1].strip()
        elif cur is not None and line.startswith("modes:"):
            cur["modes"] = line.split(":", 1)[1].split()
        elif not line.strip():
            cur = None
    return out


def command_problems(lanes):
    """What is wrong with the command each unit starts: one that does not
    exist, one commands.manifest does not list, or an effect command a timer
    starts without --for-real (or with a rehearsal mode, which on a timer
    would quietly never send)."""
    known, out = commands(), []
    for m in lanes.values():
        for u in m["unit"]:
            words = u["exec"].split()
            prog = words[0].rsplit("/", 1)[-1]
            ctx = f"{m['lane']}.toml unit {u['name']}"
            if not any((d / prog).exists() for d in PROGRAM_DIRS):
                out.append(f"{ctx} runs {prog}, which is neither cmd/{prog} nor fleet-kit/fleet/bin/{prog}")
            c = known.get(prog)
            if c is None:
                out.append(f"{ctx} runs {prog}, which commands.manifest does not list")
            elif c["runs"] == "effect":
                rehearsal = [w for w in words[1:] if w in c["modes"] and w != "--for-real"]
                if "--for-real" not in words[1:] or rehearsal:
                    out.append(f"{ctx} runs the effect command {prog} without --for-real"
                               + (f" (it says {' '.join(rehearsal)})" if rehearsal else ""))
    return out


def wanted(lanes):
    """{path: wanted text} for every file the manifests generate."""
    out = {ORCHESTRATOR: render_table(lanes, ORCHESTRATOR.read_text(encoding="utf-8")),
           VERDICT_LANES: render_verdict_lanes(lanes),
           LANE_LIST: render_lane_list(lanes)}
    for m in lanes.values():
        for u in m["unit"]:
            p = UNITS / f"cti-agent-{u['name']}.service"
            cur = p.read_text(encoding="utf-8") if p.exists() else None
            out[p] = render(u, cur)
    return out


def main(argv):
    if len(argv) != 1 or argv[0] not in ("--check", "--write", "--list"):
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    try:
        lanes = load_all()
    except ManifestError as e:
        print(f"lanes: {e}", file=sys.stderr)
        return 1
    if argv[0] == "--list":
        for m in lanes.values():
            for u in m["unit"]:
                t = u.get("timer") or {}
                when = t.get("on_calendar") or (f"boot+{t['on_boot']}, every {t['on_unit_active']}" if t else "no timer")
                print(f"{m['lane']:<14} {u['name']:<14} {when}")
        return 0
    try:
        want = wanted(lanes)
    except ManifestError as e:
        print(f"lanes: {e}", file=sys.stderr)
        return 1
    problems = [p for m in lanes.values() for u in m["unit"] for p in timer_problems(u)]
    problems += command_problems(lanes)
    try:
        problems += grant_problems(lanes)
    except ManifestError as e:
        problems.append(str(e))
    if argv[0] == "--write":
        for p, text in want.items():
            if not p.exists() or p.read_text(encoding="utf-8") != text:
                p.write_text(text, encoding="utf-8")
                print(f"wrote {shown(p)}")
        for pr in problems:
            print(f"lanes: {pr}", file=sys.stderr)
        return 1 if problems else 0
    stale = [p for p, text in want.items() if not p.exists() or p.read_text(encoding="utf-8") != text]
    for p in stale:
        print(f"lanes: {shown(p)} is out of date with its manifest - run scripts/lanes --write "
              "and review the diff (edit the manifest, never the unit)", file=sys.stderr)
    for pr in problems:
        print(f"lanes: {pr}", file=sys.stderr)
    return 1 if stale or problems else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
